@using MudBlazor

<MudPaper Class="pa-4 mb-4">

    <MudGrid>

        <MudItem xs="12" md="3">

            <MudDatePicker Label="From"
                           @bind-Date="_from" />

        </MudItem>

        <MudItem xs="12" md="3">

            <MudDatePicker Label="To"
                           @bind-Date="_to" />

        </MudItem>

        <MudItem xs="12" md="6">

            <MudStack Row="true" Spacing="2">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="ApplyFilter">

                    Apply

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Verified"
                           OnClick="OnValidate">

                    Validate

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Build"
                           OnClick="OnRepair">

                    Repair

                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="OnRecalculate">

                    Recalculate

                </MudButton>

            </MudStack>

        </MudItem>

    </MudGrid>

</MudPaper>

@code {

    private DateTime? _from;

    private DateTime? _to;

    [Parameter]
    public EventCallback OnValidate { get; set; }

    [Parameter]
    public EventCallback OnRepair { get; set; }

    [Parameter]
    public EventCallback OnRecalculate { get; set; }

    [Parameter]
    public EventCallback<(DateTime?, DateTime?)> OnFilter { get; set; }

    private async Task ApplyFilter()
    {
        await OnFilter.InvokeAsync((_from, _to));
    }

}