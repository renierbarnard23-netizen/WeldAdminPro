@using WeldAdminPro.Core.Models
@using WeldAdminPro.Data.Services.Inventory

@inject StockApplicationService StockService
<div class="card shadow-sm">

    <div class="card-header bg-primary text-white">

        <strong>Stock Item</strong>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <label>Item Code</label>

                <input class="form-control"
                       @bind="Item.ItemCode" />

            </div>

            <div class="col-md-6">

                <label>Description</label>

                <input class="form-control"
                       @bind="Item.Description" />

            </div>

        </div>

        <div class="row mt-3">

            <div class="col-md-4">

                <label>Category</label>

<select class="form-select"
        @bind="Item.Category">

    <option value="">-- Select Category --</option>

    @foreach (var category in _categories)
    {
        <option value="@category.Name">
            @category.Name
        </option>
    }

</select>

            </div>

            <div class="col-md-4">

                <label>Unit</label>

                <input class="form-control"
                       @bind="Item.Unit" />

            </div>

            <div class="col-md-4">

                <label>Quantity</label>

                <input type="number"
                       class="form-control"
                       @bind="Item.Quantity" />

            </div>

        </div>
        <div class="row mt-3">

            <div class="col-md-4">

                <label>Minimum Stock Level</label>

                <input type="number"
                       class="form-control"
                       @bind="Item.MinLevel" />

            </div>

            <div class="col-md-4">

                <label>Maximum Stock Level</label>

                <input type="number"
                       class="form-control"
                       @bind="Item.MaxLevel" />

            </div>

            <div class="col-md-4">

                <label>Average Unit Cost</label>

                <input type="number"
                       step="0.01"
                       class="form-control"
                       @bind="Item.AverageUnitCost" />

            </div>

        </div>

        <div class="mt-4">

            <button class="btn btn-success"
                    @onclick="Save">

                Save

            </button>

        </div>

    </div>

</div>

@code {

    [Parameter]

    public StockItem Item { get; set; } = new();

    [Parameter]

    public EventCallback OnSave { get; set; }

    private List<Category> _categories = new();

    protected override void OnInitialized()
    {
        _categories = StockService
            .GetAllCategories()
            .Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .ToList();
    }
    private async Task Save()
    {
        await OnSave.InvokeAsync();
    }

}


