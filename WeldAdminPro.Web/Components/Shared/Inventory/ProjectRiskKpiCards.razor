@using MudBlazor
@using WeldAdminPro.Core.Analytics.Executive
@using WeldAdminPro.Web.Components.Shared.Production

<MudGrid>

    <MudItem xs="12" sm="6" md="3">

        <EnterpriseKpiCard
            Title="Critical"
            Value="@CriticalProjects.ToString()"
            Status="Immediate Attention"
            ChipColor="Color.Error"
            Icon="@Icons.Material.Filled.Warning"
            IconColor="Color.Error" />

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <EnterpriseKpiCard
            Title="High Risk"
            Value="@HighProjects.ToString()"
            Status="Monitor Closely"
            ChipColor="Color.Warning"
            Icon="@Icons.Material.Filled.PriorityHigh"
            IconColor="Color.Warning" />

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <EnterpriseKpiCard
            Title="Medium Risk"
            Value="@MediumProjects.ToString()"
            Status="Under Observation"
            ChipColor="Color.Info"
            Icon="@Icons.Material.Filled.RemoveRedEye"
            IconColor="Color.Info" />

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <EnterpriseKpiCard
            Title="Average Budget Used"
            Value="@AverageBudgetUsedDisplay"
            Status="Across All Projects"
            ChipColor="Color.Success"
            Icon="@Icons.Material.Filled.PieChart"
            IconColor="Color.Success" />

    </MudItem>

</MudGrid>

@code
{
    [Parameter]
    public IEnumerable<ProjectRiskModel> Projects { get; set; }
        = Enumerable.Empty<ProjectRiskModel>();

    private int CriticalProjects =>
        Projects.Count(x => x.RiskLevel == "Critical");

    private int HighProjects =>
        Projects.Count(x => x.RiskLevel == "High");

    private int MediumProjects =>
        Projects.Count(x => x.RiskLevel == "Medium");

    private decimal AverageBudgetUsed =>
        Projects.Any()
            ? Projects.Average(x => x.BudgetUsedPercent)
            : 0;

    private string AverageBudgetUsedDisplay =>
        $"{AverageBudgetUsed:N1}%";
}