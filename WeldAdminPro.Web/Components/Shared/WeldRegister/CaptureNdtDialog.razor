@using MudBlazor
@using WeldAdminPro.Core.Models
@using WeldAdminPro.Core.Quality.Models
@using WeldAdminPro.Core.Quality.Enums
@using WeldAdminPro.Data.Services.Quality

<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-4">

            Capture NDT Result

        </MudText>

        <MudGrid>

            <MudItem xs="12" md="6">

                <MudSelect T="NdtMethodType"
                           Label="Method"
                           @bind-Value="_result.NdtMethod">

                    @foreach (var method in Enum.GetValues<NdtMethodType>())
                    {
                        <MudSelectItem T="NdtMethodType"
                                       Value="@method">

                            @method

                        </MudSelectItem>
                    }

                </MudSelect>

            </MudItem>

            <MudItem xs="12" md="6">

                <MudSelect T="NdtResultType"
                           Label="Result"
                           @bind-Value="_result.Result">

                    @foreach (var result in Enum.GetValues<NdtResultType>())
                    {
                        <MudSelectItem T="NdtResultType"
                                       Value="@result">

                            @result

                        </MudSelectItem>
                    }

                </MudSelect>

            </MudItem>

            <MudItem xs="12" md="6">

                <MudSelect T="Guid"
                           Label="Equipment Used (select all that apply)"
                           MultiSelection="true"
                           ToStringFunc="@GetEquipmentDisplay"
                           @bind-SelectedValues="_selectedEquipmentIds"
                           Required="true"
                           HelperText="Select every controlled item used for this NDT examination. Calibration is checked for each item where required.">

                    @foreach (var equipment in _equipment)
                    {
                        <MudSelectItem T="Guid" Value="@equipment.Id">
                            @equipment.EquipmentNumber - @equipment.Description
                        </MudSelectItem>
                    }

                </MudSelect>

            </MudItem>

            <MudItem xs="12" md="6">

                <MudDatePicker Label="Inspection Date"
                               @bind-Date="_inspectionDate"
                               Required="true" />

            </MudItem>

            <MudItem xs="12">

                <MudTextField Label="Inspector"
                              @bind-Value="_result.InspectorName" />

            </MudItem>

            <MudItem xs="12">

                <MudTextField Label="Report Number"
                              @bind-Value="_result.ReportNumber" />

            </MudItem>

            <MudItem xs="12">

                <MudTextField Label="Acceptance Criteria"
                              @bind-Value="_result.AcceptanceCriteria" />

            </MudItem>

            <MudItem xs="12">

                <MudTextField Label="Remarks"
                              Lines="3"
                              @bind-Value="_result.Remarks" />

            </MudItem>


        </MudGrid>

        @if (_equipment.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                No controlled equipment is available for this project.
                Add or assign controlled equipment before capturing the NDT result.
            </MudAlert>
        }
        else if (_selectedEquipmentIds.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Select at least one controlled equipment item before saving the NDT result.
            </MudAlert>
        }
    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">

            Cancel

        </MudButton>

        <MudButton Color="Color.Primary"
                   Disabled="@(_selectedEquipmentIds.Count == 0 || _equipment.Count == 0)"
                   OnClick="Save">

            Save

        </MudButton>

    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Weld Weld { get; set; } = default!;

    [Parameter]
    public Guid ProjectId { get; set; }

    [Inject]
    private EquipmentApplicationService EquipmentService { get; set; } = default!;

    private WeldNdtResult _result = new();
    private List<Equipment> _equipment = new();
    private IReadOnlyCollection<Guid> _selectedEquipmentIds = Array.Empty<Guid>();
    private DateTime? _inspectionDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        _result.Id = Guid.NewGuid();
        _result.WeldId = Weld.Id;
        _result.InspectionDate = DateTime.Today;
        _equipment = await EquipmentService.GetForProjectAsync(ProjectId);
    }

    protected override void OnParametersSet()
    {
        if (_inspectionDate.HasValue)
            _result.InspectionDate = _inspectionDate.Value;
    }

    private string GetEquipmentDisplay(Guid equipmentId)
    {
        var equipment = _equipment.FirstOrDefault(e => e.Id == equipmentId);
        if (equipment is null)
            return equipmentId.ToString();

        var serial = string.IsNullOrWhiteSpace(equipment.SerialNumber)
            ? "No serial"
            : $"SN: {equipment.SerialNumber}";

        return $"{equipment.EquipmentNumber} - {equipment.Description} ({serial})";
    }

    private void Save()
    {
        if (_equipment.Count == 0)
            return;

        if (_selectedEquipmentIds.Count == 0)
            return;

        _result.EquipmentIds = _selectedEquipmentIds.ToList();
        _result.EquipmentId = _result.EquipmentIds[0];
        _result.InspectionDate = _inspectionDate?.Date ?? DateTime.Today;
        MudDialog.Close(DialogResult.Ok(_result));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

