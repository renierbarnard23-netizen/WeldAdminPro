@using MudBlazor
@using WeldAdminPro.Core.Quality.Models
@using WeldAdminPro.Web.Components.Shared.Production

@if (Snapshot != null)
{
    <MudGrid>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Quality Compliance"
                   Value="@(Snapshot.IsComplete ? $"{Snapshot.ComplianceScore}%" : "Restricted")"
                   Status="@(Snapshot.IsComplete ? Snapshot.ComplianceRating : "Restricted")"
                   ChipColor="@GetComplianceColor()"
                   Icon="@Icons.Material.Filled.Verified"
                   IconColor="@GetComplianceColor()" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Active WPS"
                   Value="@(Snapshot.ActiveWpsAvailable ? Snapshot.ActiveWps.ToString() : "Restricted")"
                   Status="@(Snapshot.ActiveWpsAvailable ? (Snapshot.ActiveWps > 0 ? "Approved" : "Missing") : "Restricted")"
                   ChipColor="Color.Primary"
                   Icon="@Icons.Material.Filled.Description"
                   IconColor="Color.Primary" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Active PQR"
                   Value="@(Snapshot.ActivePqrAvailable ? Snapshot.ActivePqr.ToString() : "Restricted")"
                   Status="@(Snapshot.ActivePqrAvailable ? (Snapshot.ActivePqr > 0 ? "Approved" : "Missing") : "Restricted")"
                   ChipColor="Color.Secondary"
                   Icon="@Icons.Material.Filled.FactCheck"
                   IconColor="Color.Secondary" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Qualified Welders"
                   Value="@(Snapshot.QualifiedWeldersAvailable ? Snapshot.QualifiedWelders.ToString() : "Restricted")"
                   Status="@(Snapshot.QualifiedWeldersAvailable ? (Snapshot.QualifiedWelders > 0 ? "Certified" : "Not Certified") : "Restricted")"
                   ChipColor="Color.Success"
                   Icon="@Icons.Material.Filled.Groups"
                   IconColor="Color.Success" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Pending NDT"
                   Value="@(Snapshot.PendingNdtAvailable ? Snapshot.PendingNdt.ToString() : "Restricted")"
                   Status="@(Snapshot.PendingNdtAvailable ? (Snapshot.PendingNdt > 0 ? "Awaiting" : "None") : "Restricted")"
                   ChipColor="Color.Warning"
                   Icon="@Icons.Material.Filled.Search"
                   IconColor="Color.Warning" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Open Repairs"
                   Value="@(Snapshot.OpenRepairsAvailable ? Snapshot.OpenRepairs.ToString() : "Restricted")"
                   Status="@(Snapshot.OpenRepairsAvailable ? (Snapshot.OpenRepairs > 0 ? "Outstanding" : "None") : "Restricted")"
                   ChipColor="Color.Error"
                   Icon="@Icons.Material.Filled.Build"
                   IconColor="Color.Error" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Expiring"
                   Value="@(Snapshot.ExpiringQualificationsAvailable ? Snapshot.ExpiringQualifications.ToString() : "Restricted")"
                   Status="@(Snapshot.ExpiringQualificationsAvailable ? "30 Days" : "Restricted")"
                   ChipColor="Color.Warning"
                   Icon="@Icons.Material.Filled.Schedule"
                   IconColor="Color.Warning" />
        </MudItem>

        <MudItem xs="12" sm="6" md="4" lg="3">
            <EnterpriseKpiCard Title="Missing Documents"
                   Value="@(Snapshot.MissingDocumentsAvailable ? Snapshot.MissingDocuments.ToString() : "Restricted")"
                   Status="@(Snapshot.MissingDocumentsAvailable ? "Required" : "Restricted")"
                   ChipColor="Color.Info"
                   Icon="@Icons.Material.Filled.FolderOpen"
                   IconColor="Color.Info" />
        </MudItem>

    </MudGrid>
}

@code
{
    [Parameter]
    public QualitySnapshot? Snapshot { get; set; }

    private Color GetComplianceColor()
    {
        if (Snapshot == null)
            return Color.Default;

        return Snapshot.ComplianceRating switch
        {
            "Excellent" => Color.Success,
            "Good" => Color.Primary,
            "Acceptable" => Color.Warning,
            "High Risk" => Color.Warning,
            "Critical" => Color.Error,
            _ => Color.Default
        };
    }
}
