@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Data.Repositories
@using WeldAdminPro.Core.Security
@using WeldAdminPro.Web.Components.Security
@inject CompanyRepository CompanyRepository

<MudTable Items="@Items"
          Hover="true"
          Dense="true"
          Striped="true">

    <HeaderContent>

        <MudTh>PQR</MudTh>
        <MudTh>Process</MudTh>
        <MudTh>Material</MudTh>
        <MudTh>Owning Company</MudTh>
        <MudTh>P No.</MudTh>
        <MudTh>F No.</MudTh>
        <MudTh>Joint</MudTh>
        <MudTh>Qualified Thickness</MudTh>
        <MudTh>Position</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>

    </HeaderContent>

    <RowTemplate>

        <MudTd>@context.PqrNumber</MudTd>

        <MudTd>@context.Process</MudTd>

        <MudTd>@context.BaseMaterial1</MudTd>

        <MudTd DataLabel="Owning Company">
            @GetCompanyName(context.CompanyId)
        </MudTd>

        <MudTd>@context.PNumber</MudTd>

        <MudTd>@context.FNumber</MudTd>

        <MudTd>@context.JointType</MudTd>

        <MudTd>@context.QualifiedRangeDisplay</MudTd>

        <MudTd>@context.QualifiedPosition</MudTd>

        <MudTd>

            @if (context.IsApproved)
            {
                <MudChip T="string"
                         Color="Color.Success">
                    Approved
                </MudChip>
            }
            else
            {
                <MudChip T="string"
                         Color="Color.Warning">
                    Draft
                </MudChip>
            }

        </MudTd>

        <MudTd Class="text-end">

            @if (!context.IsApproved)
            {
                <PermissionView Permission="@PermissionKeys.Quality.WpsApproval">
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                   Color="Color.Success"
                                   OnClick="@(() => OnApprove.InvokeAsync(context))" />
                </PermissionView>
            }


            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                           Color="Color.Primary"

                           OnClick="@(() => OnPrint.InvokeAsync(context))" />

            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           OnClick="@(() => OnEdit.InvokeAsync(context))" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           OnClick="@(() => OnDelete.InvokeAsync(context))" />

        </MudTd>

    </RowTemplate>

</MudTable>

@code {

    [Parameter]
    public List<Pqr> Items { get; set; } = new();

    [Parameter]
    public EventCallback<Pqr> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Pqr> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Pqr> OnPrint { get; set; }

    [Parameter]
    public EventCallback<Pqr> OnApprove { get; set; }

    private string GetCompanyName(Guid? companyId)
    {
        if (!companyId.HasValue || companyId.Value == Guid.Empty)
        {
            return "Company not recorded";
        }

        var company = CompanyRepository.GetById(companyId.Value);

        return string.IsNullOrWhiteSpace(company?.CompanyName)
            ? "Company not recorded"
            : company.CompanyName.Trim();
    }
}

