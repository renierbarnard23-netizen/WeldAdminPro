@using MudBlazor
@using WeldAdminPro.Core.Quality.Models
@using WeldAdminPro.Core.Quality.Enums

@if (Repairs is null || Repairs.Count == 0)
{
    <MudAlert Severity="Severity.Info"
              Variant="Variant.Outlined">
        No repair records are available.
    </MudAlert>
}
else
{
    <MudTable Items="_repairs"
              Dense="true"
              Hover="true"
              Striped="true"
              Elevation="0">

        <HeaderContent>
            <MudTh>Repair No</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Class="text-end">Days Open</MudTh>
            <MudTh>Age Status</MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd>
                REP-@context.RepairNumber.ToString("D4")
            </MudTd>

            <MudTd>
                @context.Status
            </MudTd>

            <MudTd Class="text-end">
                @context.AgeDays
            </MudTd>

            <MudTd>

                @if (context.IsClosed)
                {
                    <MudChip T="string"
                             Color="Color.Success"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.CheckCircle">
                        Closed
                    </MudChip>
                }
                else if (context.IsOverdue)
                {
                    <MudChip T="string"
                             Color="Color.Error"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.Warning">
                        Overdue
                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Success"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.Schedule">
                        On Time
                    </MudChip>
                }

            </MudTd>

        </RowTemplate>

    </MudTable>
}

@code
{
    [Parameter]
    public List<RepairRecord> Repairs { get; set; } = new();

    [Parameter]
    public int OverdueAfterDays { get; set; } = 7;

    private readonly List<RepairAgeRow> _repairs = new();

    protected override void OnParametersSet()
    {
        _repairs.Clear();

        foreach (var repair in Repairs)
        {
            var endDate =
                repair.CompletedDate
                ?? DateTime.UtcNow;

            var ageDays =
                Math.Max(
                    0,
                    (int)Math.Floor(
                        (endDate - repair.RequestedDate)
                        .TotalDays));

            var isClosed =
                repair.Status == RepairStatus.Closed;

            _repairs.Add(
                new RepairAgeRow(
                    repair.RepairNumber,
                    repair.Status.ToString(),
                    ageDays,
                    !isClosed &&
                    ageDays > OverdueAfterDays,
                    isClosed));
        }
    }

    private sealed record RepairAgeRow(
        int RepairNumber,
        string Status,
        int AgeDays,
        bool IsOverdue,
        bool IsClosed);
}
