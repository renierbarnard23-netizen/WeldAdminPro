@using MudBlazor
@using WeldAdminPro.Core.Models

<MudPaper Class="pa-4 mb-4"
          Elevation="2">

    <MudText Typo="Typo.h6"
             Class="mb-4">

        Return Stock

    </MudText>

    <MudGrid>

        <MudItem xs="12">

            <MudSelect T="ReturnableItemDto"
                       Label="Issued Item"
                       @bind-Value="_selectedItem">

                @foreach (var item in ReturnableItems)
                {
                    <MudSelectItem T="ReturnableItemDto"
                                   Value="@item">

                        @($"{item.ItemCode} - {item.Description}")

                    </MudSelectItem>
                }

            </MudSelect>

        </MudItem>

        <MudItem xs="12">

            <MudNumericField T="decimal"
                             Label="Return Quantity"
                             @bind-Value="_quantity" />

        </MudItem>

        <MudItem xs="12">

            <MudAlert Severity="Severity.Info">

                Remaining Issued:
                @($"{_selectedItem?.Quantity ?? 0:N2}")

            </MudAlert>

        </MudItem>

        <MudItem xs="12">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.KeyboardReturn"
                       OnClick="ReturnStock">

                Return Stock

            </MudButton>

        </MudItem>

    </MudGrid>

</MudPaper>

@code
{
    [Parameter]
    public List<ReturnableItemDto> ReturnableItems { get; set; } = new();

    [Parameter]
    public EventCallback<(Guid StockId, decimal Quantity)> OnReturn { get; set; }

    private ReturnableItemDto? _selectedItem;

    private decimal _quantity = 1;

    private async Task ReturnStock()
    {
        if (_selectedItem is null)
            return;

        await OnReturn.InvokeAsync(
            (_selectedItem.StockItemId, _quantity));
    }
}