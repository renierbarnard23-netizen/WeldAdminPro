@using MudBlazor
@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Data.Services.Projects

@inject ProjectApplicationService ProjectService
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 mt-4">

    <MudText Typo="Typo.h6" Class="mb-3">
        Required Documents
    </MudText>

    @foreach (var category in Documents
        .GroupBy(x => x.Category)
        .OrderBy(x => x.Key))
    {
        <MudExpansionPanels>

            <MudExpansionPanel Text="@category.Key">

                @foreach (var doc in category.OrderBy(x => x.DocumentName))
                {
                    <MudCheckBox T="bool"
                                 Label="@doc.DocumentName"
                                 Value="@doc.IsRequired"
                                 ValueChanged="@(value => ToggleRequired(doc, value))" />
                }

            </MudExpansionPanel>

        </MudExpansionPanels>
    }

</MudPaper>

@code
{
    [Parameter]
    public List<ProjectDocument> Documents { get; set; } = new();

    [Parameter]
    public EventCallback OnDocumentsChanged { get; set; }

    private async Task ToggleRequired(ProjectDocument document, bool value)
    {
        document.IsRequired = value;
        document.LastModifiedOn = DateTime.Now;

        ProjectService.UpdateDocument(document);

        Snackbar.Add(
            "Required document updated.",
            Severity.Success);

        await OnDocumentsChanged.InvokeAsync();
    }
}