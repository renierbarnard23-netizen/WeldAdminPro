@using MudBlazor
@using WeldAdminPro.Core.Models

@if (Projects == null || Projects.Count == 0)
{
    <MudAlert Severity="Severity.Info"
              Dense="true"
              Variant="Variant.Filled">

        No projects found.

    </MudAlert>
}
else
{
    <MudTable T="Project"
              Items="Projects"
              Hover="true"
              Dense="true"
              Striped="true"
              Breakpoint="Breakpoint.Md">

        <HeaderContent>

            <MudTh>Status</MudTh>
            <MudTh>Job #</MudTh>
            <MudTh>Project</MudTh>
            <MudTh>Client</MudTh>
            <MudTh>Quote</MudTh>
            <MudTh>Order</MudTh>
            <MudTh>Assigned</MudTh>
            <MudTh Class="text-end">Amount</MudTh>
            <MudTh>Invoiced</MudTh>
            <MudTh Class="text-center">Actions</MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>

                <MudChip T="string"
                         Color="@GetStatusColor(context.Status)"
                         Variant="Variant.Filled"
                         Size="Size.Small">

                    @context.Status

                </MudChip>

            </MudTd>

            <MudTd>@context.JobNumber</MudTd>

            <MudTd>@context.ProjectName</MudTd>

            <MudTd>@context.Client</MudTd>

            <MudTd>@context.QuoteNumber</MudTd>

            <MudTd>@context.OrderNumber</MudTd>

            <MudTd>@context.AssignedTo</MudTd>

            <MudTd Class="text-end">

                @context.Amount.ToString("C")

            </MudTd>

            <MudTd>

                @if (context.IsInvoiced)
                {
                    <MudChip T="string"
                             Color="Color.Success"
                             Size="Size.Small">

                        Yes

                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Warning"
                             Size="Size.Small">

                        No

                    </MudChip>
                }

            </MudTd>

            <MudTd Class="text-center">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="@(() => OnOpen.InvokeAsync(context.Id))">

                    Open

                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Size="Size.Small"
                           Class="ms-2"
                           OnClick="@(() => OnDelete.InvokeAsync(context))">

                    Delete

                </MudButton>

            </MudTd>

        </RowTemplate>

    </MudTable>
}

@code
{
    [Parameter]
    public List<Project> Projects { get; set; } = new();

    [Parameter]
    public EventCallback<Guid> OnOpen { get; set; }

    [Parameter]
    public EventCallback<Project> OnDelete { get; set; }

    private static Color GetStatusColor(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.Active => Color.Success,
            ProjectStatus.OnHold => Color.Warning,
            ProjectStatus.Completed => Color.Info,
            ProjectStatus.Cancelled => Color.Error,
            _ => Color.Default
        };
    }
}