@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Data.Services
@using WeldAdminPro.Data.Services.Projects

@inject DocumentStorageService DocumentStorageService
@inject ProjectApplicationService ProjectService

<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-4">

            Upload Project Document

        </MudText>

        <InputFile OnChange="OnFileSelected" />

        @if (!string.IsNullOrWhiteSpace(_fileName))
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">

                @_fileName

            </MudAlert>
        }

    </DialogContent>

    <DialogActions>

        <MudButton Color="Color.Secondary"
                   OnClick="Cancel">

            Cancel

        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(_selectedFile == null)"
                   OnClick="Upload">

            Upload

        </MudButton>

    </DialogActions>

</MudDialog>

@code
{
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid DocumentId { get; set; }

    private IBrowserFile? _selectedFile;

    private string? _fileName;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;

        _fileName = _selectedFile.Name;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Upload()
    {
        if (_selectedFile is null)
            return;

        await using var stream =
            _selectedFile.OpenReadStream(1024 * 1024 * 100);

        var storedPath =
            await DocumentStorageService.SaveProjectDocumentAsync(
                ProjectId,
                _selectedFile.Name,
                stream);

        var document =
            ProjectService
                .GetDocuments(ProjectId)
                .FirstOrDefault(d => d.Id == DocumentId);

        if (document is null)
            return;

        ProjectService.RegisterDocumentFile(
            document,
            storedPath);

        MudDialog.Close(DialogResult.Ok(true));
    }
}