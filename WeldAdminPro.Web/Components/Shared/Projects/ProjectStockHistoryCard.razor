@using WeldAdminPro.Core.Models

<div class="card shadow-sm mt-4">

    <div class="card-header bg-dark text-white">

        <strong>Project Stock Transactions</strong>

    </div>

    <div class="card-body">

        @if (Transactions.Count == 0)
        {
            <div class="alert alert-secondary">

                No stock transactions recorded.

            </div>
        }
        else
        {
            <table class="table table-hover table-striped">

                <thead>

                    <tr>

                        <th>Date</th>
                        <th>Material</th>
                        <th class="text-end">Quantity</th>
                        <th>Issued By</th>
                        <th>Notes</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Transactions)
                    {
                        <tr>

                            <td>

                                @item.IssuedOn.ToShortDateString()

                            </td>

                            <td>

                                @item.DisplayName

                            </td>

                            <td class="text-end">

                                @item.Quantity

                            </td>

                            <td>

                                @item.IssuedBy

                            </td>

                            <td>

                                @item.Notes

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

</div>

@code {

    [Parameter]

    public List<ProjectStockUsage> Transactions { get; set; } = new();

}