@using WeldAdminPro.Core.Models

<MudGrid>

    <MudItem xs="12" sm="6" lg="3">
        <EnterpriseKpiCard Title="Projects"
                           Value="@Projects.Count.ToString()"
                           Status="Total"
                           Icon="@Icons.Material.Filled.Folder"
                           IconColor="Color.Primary"
                           ChipColor="Color.Primary" />
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <EnterpriseKpiCard Title="Active"
                           Value="@Projects.Count(p => p.Status == ProjectStatus.Active).ToString()"
                           Status="Running"
                           Icon="@Icons.Material.Filled.Work"
                           IconColor="Color.Success"
                           ChipColor="Color.Success" />
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <EnterpriseKpiCard Title="Completed"
                           Value="@Projects.Count(p => p.Status == ProjectStatus.Completed).ToString()"
                           Status="Finished"
                           Icon="@Icons.Material.Filled.TaskAlt"
                           IconColor="Color.Info"
                           ChipColor="Color.Info" />
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <EnterpriseKpiCard Title="Contract Value"
                           Value="@Projects.Sum(p => p.Amount).ToString("C0")"
                           Status="Total"
                           Icon="@Icons.Material.Filled.AttachMoney"
                           IconColor="Color.Warning"
                           ChipColor="Color.Warning" />
    </MudItem>

</MudGrid>

@code
{
    [Parameter]

    public List<Project> Projects { get; set; } = new();
}