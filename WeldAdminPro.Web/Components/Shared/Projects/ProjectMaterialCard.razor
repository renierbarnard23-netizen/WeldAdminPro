@using WeldAdminPro.Core.Models

<div class="card shadow-sm mb-3">

    <div class="card-header bg-warning">

        <strong>Project Material Usage</strong>

    </div>

    <div class="card-body">

        @if (Summary == null || Summary.Count == 0)
        {
            <div class="alert alert-info mb-0">

                No material has been issued.

            </div>
        }
        else
        {

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>Item Code</th>
                        <th>Description</th>
                        <th class="text-end">Issued</th>
                        <th class="text-end">Returned</th>
                        <th class="text-end">Net</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Summary)
                    {

                        <tr>

                            <td>@item.ItemCode</td>

                            <td>@item.Description</td>

                            <td class="text-end">

                                @item.IssuedQuantity

                            </td>

                            <td class="text-end">

                                @item.ReturnedQuantity

                            </td>

                            <td class="text-end">

                                @item.NetQuantity

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        }

    </div>

</div>

@code {

    [Parameter]

    public List<ProjectStockSummary> Summary { get; set; } = new();

}