@using MudBlazor
@using WeldAdminPro.Core.Models

<MudPaper Class="pa-4 mb-4" Elevation="2">

    <MudText Typo="Typo.h6" Class="mb-4">
        Issue Stock
    </MudText>

    <MudGrid>

        <MudItem xs="12">

            <MudSelect T="StockItem"
                       Label="Stock Item"
                       @bind-Value="_selectedStock">

                @foreach (var item in StockItems)
                {
                    <MudSelectItem Value="@item">
                        @($"{item.ItemCode} - {item.Description}")
                    </MudSelectItem>
                }

            </MudSelect>

        </MudItem>

        <MudItem xs="12">

            <MudNumericField T="decimal"
                             Label="Quantity"
                             @bind-Value="_quantity" />

        </MudItem>

        <MudItem xs="12">

            <MudAlert Severity="Severity.Info">

                Available:
                @($"{_selectedStock?.AvailableQuantity ?? 0:N2}")

            </MudAlert>

        </MudItem>

        <MudItem xs="12">

            <MudTextField Label="Issued By"
                          @bind-Value="_issuedBy" />

        </MudItem>

        <MudItem xs="12">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Issue">

                Issue Stock

            </MudButton>

        </MudItem>

    </MudGrid>

</MudPaper>

@code
{
    [Parameter]
    public List<StockItem> StockItems { get; set; } = new();

    [Parameter]
    public EventCallback<(Guid StockId, decimal Quantity)> OnIssue { get; set; }

    private StockItem? _selectedStock;

    private decimal _quantity = 1;

    private string _issuedBy = "Web User";

    private async Task Issue()
    {
        if (_selectedStock is null)
            return;

        await OnIssue.InvokeAsync((_selectedStock.Id, _quantity));
    }
}