@page "/projects/compliance"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Projects.Compliance")]

@using MudBlazor
@using WeldAdminPro.Web.Services
@using WeldAdminPro.Core.Analytics.Executive

@inject NavigationManager Navigation
@inject ProjectComplianceApplicationService ProjectComplianceService

<MudPaper>

    <MudTable Items="_projects"
          Hover="true"
          Dense="true"
          Striped="true">

    <HeaderContent>

        <MudTh>Job #</MudTh>
        <MudTh>Project</MudTh>
        <MudTh>Client</MudTh>
        <MudTh>Risk</MudTh>
        <MudTh>WPS %</MudTh>
        <MudTh>Documents %</MudTh>
        <MudTh>Issues</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>

    </HeaderContent>

    <RowTemplate>

        <MudTd>@context.JobNumber</MudTd>

        <MudTd>@context.ProjectName</MudTd>

        <MudTd>@context.Client</MudTd>

        <MudTd>

                <MudChip T="string"
                         Color="@(
                         context.RiskLevel == "LOW"
                             ? Color.Success
                             : context.RiskLevel == "MEDIUM"
                                 ? Color.Warning
                                 : Color.Error)">

                @context.RiskDisplay

            </MudChip>

        </MudTd>

        <MudTd>

            <MudProgressLinear Value="@context.WpsPercent"
                               Color="Color.Primary" />

            @context.WpsPercent.ToString("N0")%

        </MudTd>

        <MudTd>

            <MudProgressLinear Value="@context.DocPercent"
                               Color="Color.Info" />

            @context.DocPercent.ToString("N0")%

        </MudTd>

        <MudTd>

            @context.IssueCount

        </MudTd>

        <MudTd>

                <MudChip T="string"
                         Color="@(context.IsCompliant ? Color.Success : Color.Error)">

                @context.StatusText

            </MudChip>

        </MudTd>

        <MudTd>

            <MudButton Color="Color.Primary"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       OnClick="@(() => Navigation.NavigateTo($"/projects/{context.ProjectId}"))">

                Open

            </MudButton>

        </MudTd>

    </RowTemplate>

</MudTable>

</MudPaper>

@code
{
    private List<ProjectComplianceDisplay> _projects = new();

    protected override async Task OnInitializedAsync()
    {
        _projects =
            await ProjectComplianceService.GetAccessibleProjectsAsync();
    }
}
