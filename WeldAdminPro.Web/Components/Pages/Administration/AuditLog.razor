@page "/administration/audit"

@using Microsoft.AspNetCore.Authorization
@using WeldAdminPro.Core.Security

@using MudBlazor
@using WeldAdminPro.Core.Models
@using WeldAdminPro.Data.Services


@attribute [Authorize(Policy = "Permission:Administration.AuditLog")]
@inject AdministrationApplicationService AdministrationService

<PageTitle>Audit Log</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Audit Log
</MudText>

@if (_logs == null)
{
    <MudProgressCircular Indeterminate="true"
                         Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">

        <MudGrid>

            <MudItem xs="12" md="9">

                <MudTextField T="string"
                              Label="Search audit log"
                              Placeholder="Username, action, module or details"
                              @bind-Value="_auditSearchText"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />

            </MudItem>

            <MudItem xs="12" md="3">

                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           Class="mt-2"
                           OnClick="ClearAuditSearch">

                    Clear Search

                </MudButton>

            </MudItem>

        </MudGrid>

    </MudPaper>
    <MudTable Items="FilteredAuditLogs"
              Dense="true"
              Hover="true"
              Striped="true">

        <HeaderContent>

            <MudTh>Date / Time</MudTh>
            <MudTh>User</MudTh>
            <MudTh>Action</MudTh>
            <MudTh>Module</MudTh>
            <MudTh>Details</MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>@context.Timestamp</MudTd>
            <MudTd>@context.Username</MudTd>
            <MudTd>@context.Action</MudTd>
            <MudTd>@context.Module</MudTd>
            <MudTd>@context.Details</MudTd>

        </RowTemplate>

    </MudTable>
}

@code
{
    private List<WeldAdminPro.Core.Models.AuditLog>? _logs;

    private string _auditSearchText = string.Empty;

    private IEnumerable<WeldAdminPro.Core.Models.AuditLog> FilteredAuditLogs
    {
        get
        {
            if (_logs is null)
                return Enumerable.Empty<WeldAdminPro.Core.Models.AuditLog>();

            if (string.IsNullOrWhiteSpace(_auditSearchText))
                return _logs;

            var search = _auditSearchText.Trim();

            return _logs.Where(log =>
                log.Username.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                log.Action.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                log.Module.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                log.Details.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ClearAuditSearch()
    {
        _auditSearchText = string.Empty;
    }

    protected override void OnInitialized()
    {
        _logs = AdministrationService.GetAuditLog();
    }
}