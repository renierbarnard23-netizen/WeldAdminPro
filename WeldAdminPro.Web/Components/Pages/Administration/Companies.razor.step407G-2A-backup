        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            LoadCompanyCompliance();
            StateHasChanged();
        }
    }

    private void LoadCompanyCompliance()
    {
        if (_selectedCompany is null)
            return;

        var companyId = _selectedCompany.Id;

        _companyContacts =
            AdministrationService.GetCompanyContacts(companyId);

        _companyRequirements =
            AdministrationService.GetCompanyRequirements(companyId);

        _companyDocuments =
            AdministrationService.GetCompanyDocuments(companyId);
    }

    private void AddCompanyContact()
    {
        if (_selectedCompany is null)
            return;

        _editingContact = new CompanyContact
        {
            Id = Guid.NewGuid(),
            CompanyId = _selectedCompany.Id,
            ContactName = "",
            Position = "",
            Telephone = "",
            Mobile = "",
            Email = "",
            IsPrimary = false,
            IsActive = true,
            CreatedDate = DateTime.UtcNow
        };

        _isNewContact = true;
    }

    private void EditCompanyContact(CompanyContact contact)
    {
        _editingContact = new CompanyContact
        {
            Id = contact.Id,
            CompanyId = contact.CompanyId,
            ContactName = contact.ContactName,
            Position = contact.Position,
            Telephone = contact.Telephone,
            Mobile = contact.Mobile,
            Email = contact.Email,
            IsPrimary = contact.IsPrimary,
            IsActive = contact.IsActive,
            CreatedDate = contact.CreatedDate
        };

        _isNewContact = false;
    }

    private void SaveCompanyContact()
    {
        if (_selectedCompany is null || _editingContact is null)
            return;

        if (string.IsNullOrWhiteSpace(_editingContact.ContactName))
            return;

        _editingContact.CompanyId = _selectedCompany.Id;

        if (_isNewContact)
        {
            AdministrationService.AddCompanyContact(
                _editingContact);
        }
        else
        {
            AdministrationService.UpdateCompanyContact(
                _editingContact);
        }

        LoadCompanyCompliance();
        CancelCompanyContact();
    }

    private void CancelCompanyContact()
    {
        _editingContact = null;
        _isNewContact = false;
    }

    private void SetCompanyContactActive(
        CompanyContact contact,
        bool isActive)
    {
        AdministrationService.SetCompanyContactActive(
            contact.Id,
            isActive);

        LoadCompanyCompliance();
    }

    private void LoadCompanies()
    {
        _companies = AdministrationService
            .GetCompanies();
    }

