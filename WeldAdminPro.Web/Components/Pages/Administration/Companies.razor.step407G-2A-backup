            CompanyName = "",
            CompanyCode = "",
            RegistrationNumber = "",
            VatNumber = "",
            VatStatus = "N/A",
            CompanyType = "Other",
            Telephone = "",
            Mobile = "",
            Email = "",
            Website = "",
            PhysicalAddress = "",
            PostalAddress = "",
            Notes = "",
            IsActive = true,
            CreatedDate = DateTime.UtcNow
        };

        _isNewCompany = true;
        _showEditor = true;
    }

    private void EditCompany()
    {
        if (_selectedCompany is null)
            return;

        _editingCompany = new Company
        {
            Id = _selectedCompany.Id,
            CompanyName = _selectedCompany.CompanyName,
            CompanyCode = _selectedCompany.CompanyCode,
            RegistrationNumber = _selectedCompany.RegistrationNumber,
            VatNumber = _selectedCompany.VatNumber,
            VatStatus = _selectedCompany.VatStatus,
            CompanyType = _selectedCompany.CompanyType,
            Telephone = _selectedCompany.Telephone,
            Mobile = _selectedCompany.Mobile,
            Email = _selectedCompany.Email,
            Website = _selectedCompany.Website,
            PhysicalAddress = _selectedCompany.PhysicalAddress,
            PostalAddress = _selectedCompany.PostalAddress,
            Notes = _selectedCompany.Notes,
            IsActive = _selectedCompany.IsActive,
            CreatedDate = _selectedCompany.CreatedDate
        };

        _isNewCompany = false;
        _showEditor = true;
    }

    private void SaveCompany()
    {
        if (_editingCompany is null)
            return;

        if (string.IsNullOrWhiteSpace(
                _editingCompany.CompanyName))
            return;

        if (string.IsNullOrWhiteSpace(
                _editingCompany.CompanyCode))
            return;

        if (_isNewCompany)
        {
            AdministrationService.AddCompany(
                _editingCompany);
        }
        else
        {
            AdministrationService.UpdateCompany(
                _editingCompany);
        }

        LoadCompanies();

        CloseEditor();

        StateHasChanged();
    }

    private void EnableCompany()
    {
        if (_selectedCompany is null)
            return;

        AdministrationService.EnableCompany(
            _selectedCompany.Id);

        LoadCompanies();

        CloseEditor();

        StateHasChanged();
    }

    private void DisableCompany()
    {
        if (_selectedCompany is null)
            return;

        AdministrationService.DisableCompany(
            _selectedCompany.Id);

        LoadCompanies();

        CloseEditor();

        StateHasChanged();
    }

    private void CancelEditor()
    {
        CloseEditor();
    }

    private void CloseEditor()
    {
        _selectedCompany = null;
        _editingCompany = null;
        _showEditor = false;
        _isNewCompany = false;
    }
}



