@page "/quality/repairs"
@attribute [Authorize(Policy = "Permission:Quality.Repairs")]

@using MudBlazor
@using WeldAdminPro.Core.Quality.Models
@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Core.Quality.Enums
@using WeldAdminPro.Data.Services.Quality
@using WeldAdminPro.Web.Components.Shared.Quality
@using WeldAdminPro.Web.Services.Quality

@inject RepairApplicationService RepairService
@inject NcrApplicationService NcrService
@inject ISnackbar Snackbar

<PageTitle>Repair Management</PageTitle>

<MudStack Spacing="3">

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <div>
            <MudText Typo="Typo.h4">
                Repair Management
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary">
                Welding repair register, lifecycle control, performance and aging
            </MudText>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_actionBusy"
                   OnClick="LoadData">
            Refresh
        </MudButton>

    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true"
                           Color="Color.Primary" />
    }
    else
    {
        <RepairKpiCards Analytics="_analytics" />

        @if (_repairs.Count > 0)
        {
            <MudPaper Class="pa-4">

                <MudStack Spacing="3">

                    <div>
                        <MudText Typo="Typo.h5">
                            Repair Lifecycle Control
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Select a repair and perform only the action permitted by its current workflow status.
                        </MudText>
                    </div>

                    <MudDivider />

                    <MudSelect T="Guid?"
                               Label="Repair"
                               Variant="Variant.Outlined"
                               Value="_selectedRepairId"
                               ValueChanged="OnRepairSelected"
                               Disabled="_actionBusy">

                        @foreach (var repair in _repairs.OrderBy(r => r.RepairNumber))
                        {
                            <MudSelectItem T="Guid?"
                                           Value="@((Guid?)repair.Id)">
                                @GetRepairDisplayName(repair)
                            </MudSelectItem>
                        }

                    </MudSelect>

                    @if (_selectedRepair != null)
                    {
                        <MudGrid>

                            <MudItem xs="12" md="4">

                                <MudText Typo="Typo.caption"
                                         Color="Color.Secondary">
                                    Repair
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    @GetRepairNumber(_selectedRepair)
                                </MudText>

                            </MudItem>

                            <MudItem xs="12" md="4">

                                <MudText Typo="Typo.caption"
                                         Color="Color.Secondary">
                                    Status
                                </MudText>

                                <MudChip T="string"
                                         Color="@GetStatusColor(_selectedRepair.Status)"
                                         Variant="Variant.Filled">
                                    @FormatStatus(_selectedRepair.Status)
                                </MudChip>

                            </MudItem>

                            <MudItem xs="12" md="4">

                                <MudText Typo="Typo.caption"
                                         Color="Color.Secondary">
                                    Requested
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    @_selectedRepair.RequestedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </MudText>

                            </MudItem>

                            <MudItem xs="12">

                                <MudText Typo="Typo.caption"
                                         Color="Color.Secondary">
                                    Reason
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    @(_selectedRepair.Reason ?? "-")
                                </MudText>

                            </MudItem>

                        </MudGrid>

                        <MudDivider />

                        @if (_selectedRepair.Status == RepairStatus.Requested)
                        {
                            <MudTextField T="string"
                                          Label="Authorized By"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_authorizedBy"
                                          Disabled="_actionBusy" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.VerifiedUser"
                                       Disabled="_actionBusy"
                                       OnClick="AuthorizeSelectedRepair">
                                Authorize Repair
                            </MudButton>
                        }
                        else if (_selectedRepair.Status == RepairStatus.Authorized)
                        {
                            <MudTextField T="string"
                                          Label="Excavation Method"
                                          HelperText="Example: Grinding, machining or approved gouging method"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_excavationMethod"
                                          Disabled="_actionBusy" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Construction"
                                       Disabled="_actionBusy"
                                       OnClick="StartSelectedExcavation">
                                Start Excavation
                            </MudButton>
                        }
                        else if (_selectedRepair.Status == RepairStatus.ExcavationInProgress)
                        {
                            <MudSelect T="string"
           Label="Repair Welder"
           Variant="Variant.Outlined"
           Value="_repairWelder"
           ValueChanged="OnRepairWelderSelected"
           Disabled="_actionBusy">
    @foreach (var welder in _repairWelderOptions)
    {
        <MudSelectItem T="string" Value="@welder.WelderNumber">
            @welder.WelderNumber
        </MudSelectItem>
    }
</MudSelect>

                            <MudSelect T="Guid?"
                                       Label="Repair WPS"
                                       Variant="Variant.Outlined"
                                       Value="_repairWpsId"
                                       ValueChanged="OnRepairWpsSelected"
                                       Disabled="_actionBusy">
                                @foreach (var wps in _repairWpsOptions)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)wps.Id)">
                                        @wps.WpsNumber â€” Rev @wps.Revision
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            @if (_repairWpsOptions.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                    No approved and active WPS revisions applicable to this weld's company and material group were found.
                                </MudAlert>
                            }

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Build"
                                       Disabled="_actionBusy || !_repairWpsId.HasValue || string.IsNullOrWhiteSpace(_repairWelder)"
                                       OnClick="StartSelectedRepairWelding">
                                Start Repair Welding
                            </MudButton>
                        }
                        else if (_selectedRepair.Status == RepairStatus.RepairWeldingInProgress)
                        {
                            <MudAlert Severity="Severity.Info"
                                      Variant="Variant.Outlined">
                                Repair welding is in progress. When welding is complete,
                                send the repair for formal reinspection.
                            </MudAlert>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Info"
                                       StartIcon="@Icons.Material.Filled.FactCheck"
                                       Disabled="_actionBusy"
                                       OnClick="SendSelectedForReinspection">
                                Send For Reinspection
                            </MudButton>
                        }
                        else if (_selectedRepair.Status == RepairStatus.Accepted)
                        {
                            <MudAlert Severity="Severity.Success"
                                      Variant="Variant.Outlined">
                                Repair has passed reinspection and is ready for closure.
                            </MudAlert>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Lock"
                                       Disabled="_actionBusy"
                                       OnClick="CloseSelectedRepair">
                                Close Repair
                            </MudButton>
                        }
                        else if (_selectedRepair.Status == RepairStatus.Rejected)
                        {
                            <MudAlert Severity="Severity.Error"
                                      Variant="Variant.Outlined">
                                Repair failed reinspection. The repair cannot be closed
                                in its current state.
                            </MudAlert>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Replay"
                                       Disabled="_actionBusy"
                                       OnClick="StartNewRepairCycle"
                                       Class="mt-3">
                                Start New Repair Cycle
                            </MudButton>
                        }
                        else if (_selectedRepair.Status == RepairStatus.Closed)
                        {
                            <MudAlert Severity="Severity.Success"
                                      Variant="Variant.Outlined">
                                Repair lifecycle is complete and closed.
                            </MudAlert>
                        }

                        @if (_actionBusy)
                        {
                            <MudProgressLinear Indeterminate="true"
                                               Color="Color.Primary" />
                        }
                    }

                </MudStack>

            </MudPaper>
        }

        <MudGrid>

            <MudItem xs="12" lg="8">

                <RepairRegister Repairs="_repairs" />

            </MudItem>

            <MudItem xs="12" lg="4">

                <MudPaper Class="pa-4">

                    <MudStack Spacing="2">

                        <MudText Typo="Typo.h5">
                            Repair Performance
                        </MudText>

                        <MudDivider />

                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween">

                            <MudText Typo="Typo.body2">
                                Closed Repairs
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @_analytics.ClosedRepairs
                            </MudText>

                        </MudStack>

                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween">

                            <MudText Typo="Typo.body2">
                                Open Repair Rate
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @_analytics.RepairRatePercent.ToString("0.0")%
                            </MudText>

                        </MudStack>

                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween">

                            <MudText Typo="Typo.body2">
                                Highest Repair Welder
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @_analytics.WorstWelder
                            </MudText>

                        </MudStack>

                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween">

                            <MudText Typo="Typo.body2">
                                Highest Repair WPS
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @_analytics.WorstWps
                            </MudText>

                        </MudStack>

                    </MudStack>

                </MudPaper>

            </MudItem>

        </MudGrid>

        <MudPaper Class="pa-4">

            <MudStack Spacing="2">

                <div>
                    <MudText Typo="Typo.h5">
                        Repair Aging
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Open repairs older than 7 days are highlighted as overdue.
                    </MudText>
                </div>

                <RepairAgingGrid Repairs="_repairs"
                                 OverdueAfterDays="7" />

            </MudStack>

        </MudPaper>
    }

</MudStack>

@code
{
    private List<RepairRecord> _repairs = new();

    private RepairAnalytics _analytics = new();

    private bool _loading = true;
    private bool _actionBusy;

    private Guid? _selectedRepairId;
    private RepairRecord? _selectedRepair;

    private string _authorizedBy = string.Empty;
    private string _excavationMethod = string.Empty;
    private string _repairWelder = string.Empty;
    private Guid? _repairWpsId;
    private List<Wps> _repairWpsOptions = new();
    private List<WelderQualification> _repairWelderOptions = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;

            var previousSelection =
                _selectedRepairId;

            _repairs =
                await RepairService
                    .GetEnterpriseRepairs();

            _analytics =
                await RepairService
                    .GetEnterpriseAnalytics();

            if (_repairs.Count == 0)
            {
                _selectedRepairId = null;
                _selectedRepair = null;

                return;
            }

            if (previousSelection.HasValue)
            {
                _selectedRepair =
                    _repairs.FirstOrDefault(
                        r => r.Id == previousSelection.Value);
            }

            _selectedRepair ??=
                _repairs
                    .OrderByDescending(r => r.RepairNumber)
                    .First();

            _selectedRepairId =
                _selectedRepair.Id;

            LoadFieldsFromSelectedRepair();
            await LoadRepairWpsOptionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load repair information: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRepairSelected(
        Guid? repairId)
    {
        _selectedRepairId =
            repairId;

        _selectedRepair =
            repairId.HasValue
                ? _repairs.FirstOrDefault(
                    r => r.Id == repairId.Value)
                : null;

        LoadFieldsFromSelectedRepair();
        await LoadRepairWpsOptionsAsync();
    }

    private async Task LoadFieldsFromSelectedRepair()
    {
        if (_selectedRepair == null)
        {
            _authorizedBy = string.Empty;
            _excavationMethod = string.Empty;
            _repairWelder = string.Empty;
            _repairWpsId = null;
            _repairWpsOptions.Clear();
            _repairWelderOptions.Clear();
            return;
        }

        _authorizedBy =
            _selectedRepair.AuthorizedBy
            ?? string.Empty;

        _excavationMethod =
            _selectedRepair.ExcavationMethod
            ?? string.Empty;

        _repairWelder =
            _selectedRepair.RepairedByWelder
            ?? string.Empty;

        _repairWpsId = _selectedRepair.RepairWpsId;
            if (_repairWpsId.HasValue)
            {
                _repairWelderOptions =
                    await RepairService.GetApplicableRepairWeldersAsync(
                        _selectedRepair.Id,
                        _repairWpsId);
            }
    }

    private async Task LoadRepairWpsOptionsAsync()
    {
        _repairWpsOptions = new List<Wps>();

        if (_selectedRepair == null)
            return;

        try
        {
            _repairWpsOptions =
                await RepairService.GetApplicableRepairWpsAsync(
                    _selectedRepair.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load applicable repair WPSs: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task OnRepairWpsSelected(Guid? wpsId)
    {
        _repairWpsId = wpsId;
        _repairWelder = string.Empty;
        _repairWelderOptions.Clear();

        if (!_repairWpsId.HasValue ||
            _selectedRepair == null)
        {
            return;
        }

        try
        {
            _repairWelderOptions =
                await RepairService.GetApplicableRepairWeldersAsync(
                    _selectedRepair.Id,
                    _repairWpsId);

            if (_repairWelderOptions.Count == 0)
            {
                Snackbar.Add(
                    "No active and currently qualified welders are available for the selected repair WPS.",
                    Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _repairWelderOptions.Clear();

            Snackbar.Add(
                $"Unable to load qualified repair welders: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task AuthorizeSelectedRepair()
    {
        if (_selectedRepair == null)
            return;

        await ExecuteActionAsync(
            () => RepairService.AuthorizeRepairAsync(
                _selectedRepair,
                _authorizedBy),
            "Repair authorized.");
    }

    private async Task StartSelectedExcavation()
    {
        if (_selectedRepair == null)
            return;

        await ExecuteActionAsync(
            () => RepairService.StartExcavationAsync(
                _selectedRepair,
                _excavationMethod),
            "Excavation started.");
    }

    private void OnRepairWelderSelected(string welderNumber)
    {
        _repairWelder = welderNumber ?? string.Empty;
    }
    private async Task StartSelectedRepairWelding()
    {
        if (_selectedRepair == null)
            return;

        await ExecuteActionAsync(
            () => RepairService.StartRepairWeldingAsync(
                _selectedRepair,
                _repairWelder,
                _repairWpsId),
            "Repair welding started.");
    }

    private async Task SendSelectedForReinspection()
    {
        if (_selectedRepair == null)
            return;

        await ExecuteActionAsync(
            () => RepairService.SendForReinspectionAsync(
                _selectedRepair),
            "Repair sent for reinspection.");
    }

            private async Task StartNewRepairCycle()
    {
        if (_selectedRepair == null || _actionBusy)
            return;

        try
        {
            _actionBusy = true;

            var rejectedRepair = _selectedRepair;

            var newRepair =
                await RepairService.CreateNextRepairCycleAsync(
                    rejectedRepair,
                    Environment.UserName);

            Snackbar.Add(
                $"New repair cycle #{newRepair.RepairNumber} created.",
                Severity.Success);

            await LoadData();

            _selectedRepair =
                _repairs.FirstOrDefault(
                    r => r.Id == newRepair.Id);

            if (_selectedRepair != null)
            {
                _selectedRepairId =
                    _selectedRepair.Id;

                LoadFieldsFromSelectedRepair();
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to create new repair cycle: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _actionBusy = false;
        }
    }
    private async Task CloseSelectedRepair()
    {
        if (_selectedRepair == null || _actionBusy)
            return;

        try
        {
            _actionBusy = true;

            var repair = _selectedRepair;

            var closeResult =
                await RepairService.CloseRepairAsync(repair);

            if (!closeResult.Success)
            {
                Snackbar.Add(
                    closeResult.Error,
                    Severity.Error);

                return;
            }

            // If this repair originated from an NCR, synchronize the
            // NCR only after the repair has successfully reached Closed.
            if (repair.NcrId.HasValue)
            {
                var ncr =
                    NcrService.GetById(
                        repair.NcrId.Value);

                if (ncr == null)
                {
                    Snackbar.Add(
                        "Repair closed, but the linked NCR could not be found.",
                        Severity.Warning);
                }
                else
                {
                    var ncrResult =
                        await NcrService.CompleteRepairExecutionAsync(
                            ncr.Id,
                            repair.RepairedByWelder ?? "Repair Management");

                    if (!ncrResult)
                    {
                        Snackbar.Add(
                            "Repair closed, but the linked NCR could not be moved to Pending Verification.",
                            Severity.Warning);
                    }
                    else
                    {
                        Snackbar.Add(
                            "Repair closed and linked NCR moved to Pending Verification.",
                            Severity.Success);
                    }
                }
            }
            else
            {
                Snackbar.Add(
                    "Repair closed.",
                    Severity.Success);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Repair closure failed: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _actionBusy = false;
        }
    }
    private async Task ExecuteAction(
        Func<(bool Success, string Error)> action,
        string successMessage)
    {
        if (_actionBusy)
            return;

        try
        {
            _actionBusy = true;

            var result =
                action();

            if (!result.Success)
            {
                Snackbar.Add(
                    result.Error,
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                successMessage,
                Severity.Success);

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Repair workflow action failed: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task ExecuteActionAsync(
        Func<Task<(bool Success, string Error)>> action,
        string successMessage)
    {
        if (_actionBusy)
            return;

        try
        {
            _actionBusy = true;

            var result =
                await action();

            if (!result.Success)
            {
                Snackbar.Add(
                    result.Error,
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                successMessage,
                Severity.Success);

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Repair workflow action failed: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private static string GetRepairNumber(
        RepairRecord repair)
    {
        return $"REP-{repair.RepairNumber:0000}";
    }

    private static string GetRepairDisplayName(
        RepairRecord repair)
    {
        return
            $"{GetRepairNumber(repair)} - {FormatStatus(repair.Status)}";
    }

    private static string FormatStatus(
        RepairStatus status)
    {
        return status switch
        {
            RepairStatus.ExcavationInProgress =>
                "Excavation In Progress",

            RepairStatus.RepairWeldingInProgress =>
                "Repair Welding In Progress",

            RepairStatus.PendingReinspection =>
                "Pending Reinspection",

            _ =>
                status.ToString()
        };
    }

    private static Color GetStatusColor(
        RepairStatus status)
    {
        return status switch
        {
            RepairStatus.Requested =>
                Color.Info,

            RepairStatus.Authorized =>
                Color.Primary,

            RepairStatus.ExcavationInProgress =>
                Color.Warning,

            RepairStatus.RepairWeldingInProgress =>
                Color.Warning,

            RepairStatus.PendingReinspection =>
                Color.Info,

            RepairStatus.Accepted =>
                Color.Success,

            RepairStatus.Rejected =>
                Color.Error,

            RepairStatus.Closed =>
                Color.Success,

            _ =>
                Color.Default
        };
    }
}






