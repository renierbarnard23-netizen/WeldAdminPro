@page "/quality/pqr"

@attribute [Authorize(Policy = "Permission:Quality.PQR")]
@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Web.Services.Quality
@using WeldAdminPro.Core.Quality.Services
@using WeldAdminPro.Core.Security.Abstractions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using WeldAdminPro.Web.Services.Import
@using WeldAdminPro.Web.Components.Shared.Quality
@using WeldAdminPro.Data.Repositories

@inject PqrApplicationService Service
@inject PqrPdfService PqrPdf
@inject CompanyRepository CompanyRepository
@inject IJSRuntime JS
@inject ICurrentUserContext CurrentUser
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDocumentImporter ImportService

<PageTitle>PQR Management</PageTitle>

<EnterprisePageHeader Title="Procedure Qualification Records"
                      Subtitle="Manage Procedure Qualification Records (PQRs)">

    <Actions>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NewPqr">

            New PQR

        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Upload"
                   OnClick="OpenImport">

            Import PDF

        </MudButton>

    </Actions>    

</EnterprisePageHeader>

<PqrGrid Items="@Items"
         OnEdit="EditPqr"
         OnDelete="DeletePqr"
         OnPrint="PrintPqr"
OnApprove="ApprovePqr" />

@code
{
    private List<Pqr> Items = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ApprovePqr(Pqr pqr)
    {
        if (pqr == null)
            return;

        try
        {
            await Service.ApproveAsync(pqr.Id);

            Snackbar.Add(
                $"PQR {pqr.PqrNumber} approved successfully.",
                Severity.Success);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
    }
    private async Task LoadAsync()
    {
        Items = await Service.GetAllAsync();

        foreach (var p in Items)
        {
            Console.WriteLine(
                $"{p.PqrNumber} | P={p.PNumber} | F={p.FNumber} | Pos={p.QualifiedPosition} | Joint={p.JointType} | Thick={p.ThicknessQualifiedMin}-{p.ThicknessQualifiedMax}");
        }
    }

    

    private async Task NewPqr()
    {
        var parameters = new DialogParameters
        {
            ["Model"] = new Pqr()
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<PqrEditorDialog>(
            "New PQR",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null)
            return;

        if (result.Canceled)
            return;

        if (result.Data is not Pqr pqr)
            return;

        try
        {
            await Service.SaveAsync(pqr);

            await LoadAsync();

            Snackbar.Add(
                "PQR saved.",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to save PQR: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task EditPqr(Pqr pqr)
    {
        var parameters = new DialogParameters
        {
            ["Model"] = pqr
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<PqrEditorDialog>(
            "Edit PQR",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null)
            return;

        if (result.Canceled)
            return;

        if (result.Data is not Pqr updated)
            return;

        try
        {
            await Service.SaveAsync(updated);

            await LoadAsync();

            Snackbar.Add(
                "PQR updated.",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to update PQR: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task PrintPqr(Pqr pqr)
    {
        if (pqr == null)
            return;

        try
        {
            var companyName = "Company not recorded";

            if (pqr.CompanyId.HasValue &&
                pqr.CompanyId.Value != Guid.Empty)
            {
                var company =
                    CompanyRepository.GetById(
                        pqr.CompanyId.Value);

                if (company != null &&
                    !string.IsNullOrWhiteSpace(company.CompanyName))
                {
                    companyName = company.CompanyName.Trim();
                }
            }

            var generatedBy =
                string.IsNullOrWhiteSpace(CurrentUser.Username)
                    ? "WeldAdmin Pro"
                    : CurrentUser.Username.Trim();

            var pdfBytes =
                PqrPdf.Generate(
                    pqr,
                    companyName,
                    generatedBy);

            if (pdfBytes == null ||
                pdfBytes.Length == 0)
            {
                Snackbar.Add(
                    "The PQR PDF could not be generated.",
                    Severity.Error);

                return;
            }

            var safeNumber =
                string.IsNullOrWhiteSpace(pqr.PqrNumber)
                    ? pqr.Id.ToString("N")
                    : pqr.PqrNumber.Trim();

            foreach (var invalidChar in Path.GetInvalidFileNameChars())
            {
                safeNumber =
                    safeNumber.Replace(
                        invalidChar,
                        '_');
            }

            var fileName =
                $"PQR-{safeNumber}-Rev{pqr.Revision}.pdf";

            var base64 =
                Convert.ToBase64String(pdfBytes);

            await JS.InvokeVoidAsync(
                "weldAdminDownload.saveBase64File",
                fileName,
                "application/pdf",
                base64);

            Snackbar.Add(
                $"PQR {pqr.PqrNumber} PDF generated.",
                Severity.Success);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to generate PQR PDF: {ex.Message}",
                Severity.Error);
        }
    }
    private async Task DeletePqr(Pqr pqr)
    {
        await Service.DeleteAsync(pqr.Id);

        await LoadAsync();

        Snackbar.Add("PQR deleted.", Severity.Success);

    }

    private async Task OpenImport()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<PqrImportDialog>(
    "Import PQR",
    options);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        if (result.Data is not Pqr imported)
            return;

        Console.WriteLine("===== IMPORT RESULT =====");
        Console.WriteLine($"PQR: {imported.PqrNumber}");
        Console.WriteLine($"P: {imported.PNumber}");
        Console.WriteLine($"F: {imported.FNumber}");
        Console.WriteLine($"Position: {imported.QualifiedPosition}");
        Console.WriteLine($"Joint: {imported.JointType}");
        Console.WriteLine($"Thickness: {imported.ThicknessQualifiedMin} - {imported.ThicknessQualifiedMax}");
        Console.WriteLine("=========================");

        try
        {
            await Service.SaveAsync(imported);

            await LoadAsync();

            Snackbar.Add(
                "PQR imported successfully.",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to import PQR: {ex.Message}",
                Severity.Error);
        }
    }
}






