@page "/quality/wps"

@attribute [Authorize(Policy = "Permission:Quality.WPS")]
@using System.IO;
@using System.Text.Json;
@using MudBlazor
@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Core.Quality.Services
@using WeldAdminPro.Web.Services.Quality
@using WeldAdminPro.Web.Components.Shared.Quality
@using WeldAdminPro.Data.Services
@using Microsoft.AspNetCore.Components.Forms

@inject WpsApplicationService WpsService
@inject WpsWorkflowService WpsWorkflow
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@inject PdfToImageService PdfService
@inject WpsOcrService OcrService
@inject WpsParserService ParserService

<PageTitle>WPS Management</PageTitle>

<EnterprisePageHeader Title="Welding Procedure Specifications"
                      Subtitle="Manage WPS documents, revisions and approvals."
                      Icon="@Icons.Material.Filled.Description">

    <Actions>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NewWps">

            New WPS

        </MudButton>

        <MudPaper Class="pa-2 d-inline-block">

            <InputFile OnChange="ImportPdf"
                       accept=".pdf" />

        </MudPaper>

    </Actions>

</EnterprisePageHeader>

<WpsGrid Items="_items"
         OnEdit="EditWps"
         OnDelete="DeleteWps"
         OnView="ViewWps"
         OnApprove="ApproveWps" />

@code
{
    private List<Wps> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = await WpsService.GetAllAsync();
    }

    private async Task NewWps()
    {
        var parameters = new DialogParameters
        {
            ["Model"] = new Wps()
        };

        var dialog = await DialogService.ShowAsync<WpsEditorDialog>(
            "New WPS",
            parameters);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        var wps = (Wps)result.Data!;

        await WpsService.SaveAsync(wps);

        Snackbar.Add("WPS created.", Severity.Success);

        await LoadAsync();

        StateHasChanged();
    }

    private async Task EditWps(Wps wps)
    {

        // Create a complete detached copy.
        // This preserves all WPS engineering and document-control fields
        // while preventing Cancel from modifying the grid record.
        var copy = JsonSerializer.Deserialize<Wps>(
            JsonSerializer.Serialize(wps))
            ?? new Wps();


        var parameters = new DialogParameters
        {
            ["Model"] = copy
        };

        var dialog = await DialogService.ShowAsync<WpsEditorDialog>(
            "Edit WPS",
            parameters);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        await WpsService.SaveAsync((Wps)result.Data!);

        Snackbar.Add("WPS updated.", Severity.Success);

        await LoadAsync();

        StateHasChanged();
    }

    private async Task ApproveWps(Wps wps)
    {
        try
        {
            var currentItems = await WpsService.GetAllAsync();
            var current = currentItems
                .FirstOrDefault(x => x.Id == wps.Id);

            if (current == null)
            {
                Snackbar.Add(
                    "The WPS could not be found.",
                    Severity.Error);

                return;
            }

            if (current.IsApproved)
            {
                Snackbar.Add(
                    "This WPS is already approved.",
                    Severity.Warning);

                return;
            }

            await WpsWorkflow.ApproveAsync(current);

            await WpsService.SaveAsync(current);

            Snackbar.Add(
                $"WPS '{current.WpsNumber}' Revision {current.Revision} approved and locked.",
                Severity.Success);

            await LoadAsync();
            StateHasChanged();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to approve WPS: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task DeleteWps(Wps wps)
    {
        await WpsService.DeleteAsync(wps.Id);

        Snackbar.Add("WPS deleted.", Severity.Success);

        await LoadAsync();

        StateHasChanged();

    }

    private Task ViewWps(Wps wps)
    {
        return EditWps(wps);
    }

    private async Task ImportPdf(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file == null)
                return;

            var tempPdf = Path.Combine(
                Path.GetTempPath(),
                Guid.NewGuid() + ".pdf");

            await using (var stream = File.Create(tempPdf))
            {
                await file.OpenReadStream(50 * 1024 * 1024)
                          .CopyToAsync(stream);
            }

            Snackbar.Add("PDF uploaded.", Severity.Info);

            // Step 1
            var image = PdfService.ConvertFirstPage(tempPdf);

            // Step 2
            var text = OcrService.ExtractText(image);

            // Step 3
            var parsed = ParserService.ParseMultiple(text, file.Name);

            if (parsed.Count == 0)
            {
                Snackbar.Add("No WPS could be extracted.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                ["Model"] = parsed[0]
            };

            var dialog = await DialogService.ShowAsync<WpsEditorDialog>(
                "Imported WPS",
                parameters);

            var result = await dialog.Result;

            if (result == null || result.Canceled)
                return;

            await WpsService.SaveAsync((Wps)result.Data!);

            Snackbar.Add("Imported successfully.", Severity.Success);

            await LoadAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}

