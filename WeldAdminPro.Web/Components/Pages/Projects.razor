@page "/projects"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Permission:Projects.View")]

@using WeldAdminPro.Core.Models
@using WeldAdminPro.Data.Services.Projects
@using MudBlazor
@using WeldAdminPro.Web.Components.Shared.Dialogs

@inject IDialogService DialogService

@inject ProjectApplicationService ProjectService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<EnterprisePageHeader Title="Projects"
                      Subtitle="Manage projects, costs, materials and compliance."
                      Icon="@Icons.Material.Filled.Work">
</EnterprisePageHeader>

<ProjectKpiCards Projects="_projects" />

<DashboardSection Title="Projects"
                  Icon="@Icons.Material.Filled.Workspaces">

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-4">

                <input class="form-control"
                       placeholder="Search..."
                       @bind="_search" />

            </div>

            <div class="col-auto">

                <button class="btn btn-success"
                        @onclick="NewProject">

                    + New Project

                </button>

            </div>

            <div class="col-auto">

                <button class="btn btn-outline-secondary"
                        @onclick="Load">

                    Refresh

                </button>

            </div>

        </div>

            <ProjectGrid Projects="FilteredProjects.ToList()"
                         OnOpen="Open"
                         OnDelete="DeleteProject" />

    </div>

</div>

</DashboardSection>

@code {

    private List<Project> _projects = new();

    private string _search = "";

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        _projects = ProjectService
            .GetProjects()
            .OrderBy(p => GetStatusSortOrder(p.Status))
            .ThenBy(p => p.JobNumber)
            .ToList();
    }

    private static int GetStatusSortOrder(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.Active => 0,
            ProjectStatus.OnHold => 1,
            ProjectStatus.Completed => 2,
            ProjectStatus.Cancelled => 3,
            _ => 99
        };
    }

    private IEnumerable<Project> FilteredProjects =>
        _projects.Where(p =>

            string.IsNullOrWhiteSpace(_search)

            ||

            p.ProjectName.Contains(_search,
                StringComparison.OrdinalIgnoreCase)

            ||

            p.Client.Contains(_search,
                StringComparison.OrdinalIgnoreCase)

            ||

            p.JobNumber.ToString().Contains(_search)

        );

    private void Open(Guid id)
    {
        Console.WriteLine($"Opening Project: {id}");

        Navigation.NavigateTo($"/projects/{id}");
    }

    private void NewProject()
    {
        Navigation.NavigateTo("/projects/new");
    }

    private async Task DeleteProject(Project project)
    {
        var parameters = new DialogParameters
    {
        { nameof(ConfirmDialog.Title), "Delete Project" },
        { nameof(ConfirmDialog.Message), $"Delete project '{project.ProjectName}'?" }
    };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm Delete",
            parameters);

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            ProjectService.DeleteProject(project.Id);

            Load();

            StateHasChanged();
        }
    }

}
