@page "/quality/weld-new/{ProjectId:guid}"

@attribute [Authorize(Policy = "Permission:Quality.WeldRegister")]
@using MudBlazor
@using WeldAdminPro.Core.Models
@using WeldAdminPro.Core.Quality
@using WeldAdminPro.Core.Quality.Enums
@using WeldAdminPro.Data.Services.Quality
@using WeldAdminPro.Web.Services.Quality

@inject ISnackbar Snackbar

@inject WelderQualificationApplicationService QualificationService
@inject WpsApplicationService WpsService

@inject WeldRegisterApplicationService WeldService
@inject NavigationManager Navigation

<PageTitle>New Weld</PageTitle>

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5" Class="mb-4">

        New Weld

    </MudText>

    <MudGrid>

        <MudItem xs="12" md="6">

            <MudTextField T="string"
                          Label="Weld Number"
                          Value="@_weld.WeldNumber"
                          Disabled="true" />

        </MudItem>

        <MudItem xs="12" md="6">

            <MudTextField T="string"
                          Label="Drawing Number"
                          @bind-Value="_weld.DrawingNumber" />

        </MudItem>

        <MudItem xs="12" md="6">

            <MudTextField T="string"
                          Label="Joint Number"
                          @bind-Value="_weld.JointNumber" />

        </MudItem>

        <MudItem xs="12" md="6">

            <MudSelect T="Guid?"
                       Label="WPS"
                       Value="_weld.WpsId"
                       ValueChanged="OnWpsChanged"
                       Required="true"
                       RequiredError="Please select an approved WPS revision.">

                @foreach (var wps in _wpsList)
                {
                    <MudSelectItem T="Guid?"
                                   Value="@((Guid?)wps.Id)">

                        @($"{wps.WpsNumber} - Rev {wps.Revision}")

                    </MudSelectItem>
                }

            </MudSelect>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudSelect T="string"
                       Label="Qualified Welder"
                       Value="_weld.WelderNumber"
                       ValueChanged="OnWelderChanged">

                @foreach (var welder in FilteredQualifiedWelders)
                {
                    <MudSelectItem T="string"
                                   Value="@welder.WelderNumber">

                        @($"{welder.WelderNumber} ({welder.Process} / {welder.Position})")

                    </MudSelectItem>
                }

            </MudSelect>

            @if (_selectedQualification != null)
            {
                <MudAlert Severity="Severity.Info"
                          Dense="true"
                          Class="mt-2">

                    <b>Qualified Process:</b> @_selectedQualification.Process
                    <br />

                    <b>Qualified Position:</b> @_selectedQualification.Position
                    <br />

                    <b>Material Group:</b> @_selectedQualification.MaterialGroup
                    <br />

                    <b>Qualified Thickness:</b> @_selectedQualification.ThicknessDisplay

                </MudAlert>
            }

            @if (_selectedQualification != null && !ThicknessQualified)
            {
                <MudAlert Severity="Severity.Warning"
                          Dense="true"
                          Class="mt-2">

                    <b>Welder is not qualified.</b>

                    <br />

                    Qualified Thickness:

                    @_selectedQualification.ThicknessDisplay

                    <br />

                    Entered Thickness:

                    @_weld.Thickness.ToString("N2") mm

                </MudAlert>
            }

        </MudItem>

        <MudItem xs="12" md="6">

            <MudTextField T="string"
                          Label="Material"
                          @bind-Value="_weld.MaterialSpecification" />

        </MudItem>

        <MudItem xs="12" md="4">

            <MudTextField T="string"
                          Label="Material Group"
                          Value="@_weld.MaterialGroup"
                          Disabled="true" />

        </MudItem>

        <MudItem xs="12" md="6">

            <MudTextField T="string"
                          Label="Heat Number 1"
                          @bind-Value="_weld.MaterialHeat1" />

        </MudItem>

        <MudItem xs="12" md="6">

            <MudTextField T="string"
                          Label="Heat Number 2"
                          @bind-Value="_weld.MaterialHeat2" />

        </MudItem>

        <MudItem xs="12" md="4">

            <MudNumericField T="double"
                             Label="Diameter"
                             @bind-Value="_weld.Diameter" />

        </MudItem>

        <MudItem xs="12" md="4">

            <MudNumericField T="double"
                             Label="Thickness"
                             @bind-Value="_weld.Thickness" />

        </MudItem>

        <MudItem xs="12" md="4">

            <MudTextField T="string"
                          Label="Status"
                          Value="@_weld.Status.ToString()"
                          Disabled="true"
                          HelperText="Initial status is controlled by the weld workflow." />

        </MudItem>

        <MudItem xs="12" md="4">

            <MudTextField T="string"
                          Label="Position"
                          Value="@_weld.Position"
                          Disabled="true" />

        </MudItem>

        <MudItem xs="12" md="4">

            <MudTextField T="string"
                          Label="Process"
                          Value="@_weld.Process"
                          Disabled="true" />

        </MudItem>

        <MudItem xs="12">

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Save">

                Save Weld

            </MudButton>

        </MudItem>

    </MudGrid>

</MudPaper>

@code
{
    [Parameter]
    public Guid ProjectId { get; set; }

    private Weld _weld = new();

    private List<Wps> _wpsList = new();
    private List<WelderQualification> _qualifiedWelders = new();
    private WelderQualification? _selectedQualification;

    protected override async Task OnInitializedAsync()
    {
        _wpsList = await WpsService.GetForProjectAsync(ProjectId);

        _qualifiedWelders = await QualificationService.GetAllAsync();

        _weld.ProjectId = ProjectId;

        // Initial lifecycle state is system controlled.
        // A new weld may not be created directly in a later lifecycle state.
        _weld.Status =
            WeldStatusType.Pending;

        _weld.WorkflowStatus =
            WeldWorkflowStatus.Draft;

        _weld.WeldNumber =
            await WeldService.GetNextWeldNumberAsync(ProjectId);
    }

    private async Task Save()
    {
    _weld.ProjectId = ProjectId;

        // Defence-in-depth: creation always starts from the
        // governed initial lifecycle state regardless of UI state.
        _weld.Status =
            WeldStatusType.Pending;

        _weld.WorkflowStatus =
            WeldWorkflowStatus.Draft;

        if (!_weld.WpsId.HasValue ||
            _weld.WpsId.Value == Guid.Empty)
        {
            Snackbar.Add(
                "Please select an approved WPS revision.",
                Severity.Warning);
            return;
        }

        var selectedWps =
            _wpsList.FirstOrDefault(x =>
                x.Id == _weld.WpsId.Value);

        if (selectedWps == null)
        {
            Snackbar.Add(
                "The selected WPS revision is no longer available.",
                Severity.Warning);
            return;
        }

        _weld.WpsNumber = selectedWps.WpsNumber;

        if (string.IsNullOrWhiteSpace(_weld.WelderNumber))
        {
            Snackbar.Add("Please select a qualified welder.", Severity.Warning);
            return;
        }

        if (_selectedQualification != null && !ThicknessQualified)
        {
            Snackbar.Add(
                "Selected welder is not qualified for this weld thickness.",
                Severity.Warning);

            return;
        }

        try
        {
            await WeldService.AddWeldAsync(_weld);

            Snackbar.Add(
                "Weld successfully created.",
                Severity.Success);

            Navigation.NavigateTo(
                $"/quality/weld-register/{ProjectId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
    }

    private IEnumerable<WelderQualification> FilteredQualifiedWelders
    {
        get
        {
            var candidates = _qualifiedWelders
                .Where(x => x.IsActive)
                .Where(x => x.ExpiryDate.Date >= DateTime.Today);

            var selectedWps = _wpsList.FirstOrDefault(x =>
                _weld.WpsId.HasValue &&
                x.Id == _weld.WpsId.Value);

            if (selectedWps == null)
            {
                return candidates
                    .OrderBy(x => x.WelderNumber);
            }

            var wpsProcess = NormalizeProcess(selectedWps.Process);
            var wpsMaterial = WeldAdminPro.Core.Quality.Normalization.ComplianceNormalizer.NormalizeMaterialGroup(selectedWps.MaterialGroup);

            if (!string.IsNullOrWhiteSpace(wpsProcess))
            {
                candidates = candidates.Where(x =>
                    string.Equals(
                        NormalizeProcess(x.Process),
                        wpsProcess,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(wpsMaterial))
            {
                candidates = candidates.Where(x =>
                    string.Equals(
                        WeldAdminPro.Core.Quality.Normalization.ComplianceNormalizer.NormalizeMaterialGroup(x.MaterialGroup),
                        wpsMaterial,
                        StringComparison.OrdinalIgnoreCase));
            }

            // A new weld initially has thickness 0. Do not hide every welder
            // until the user has entered a positive weld thickness.
            if (_weld.Thickness > 0)
            {
                candidates = candidates.Where(x =>
                    _weld.Thickness >= x.ThicknessMin &&
                    _weld.Thickness <= x.ThicknessMax);
            }

            return candidates
                .OrderBy(x => x.WelderNumber);
        }
    }

    private static string NormalizeSelectionValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value.Trim().Replace(" ", string.Empty);
    }

    private static string NormalizeProcess(string? value)
    {
        var normalized = NormalizeSelectionValue(value).ToUpperInvariant();

        return normalized switch
        {
            "TIG" => "GTAW",
            "GTAW" => "GTAW",
            "MIG" => "GMAW",
            "MAG" => "GMAW",
            "GMAW" => "GMAW",
            _ => normalized
        };
    }
    private Task OnWpsChanged(Guid? wpsId)
    {
        _weld.WpsId = wpsId;

        var selectedWps =
            wpsId.HasValue
                ? _wpsList.FirstOrDefault(x => x.Id == wpsId.Value)
                : null;

        _weld.WpsNumber =
            selectedWps?.WpsNumber ?? string.Empty;

        return Task.CompletedTask;
    }

    private Task OnWelderChanged(string? welderNumber)
{
    _weld.WelderNumber = welderNumber ?? "";

    _selectedQualification =
        FilteredQualifiedWelders.FirstOrDefault(x =>
            x.WelderNumber == _weld.WelderNumber);

    if (_selectedQualification != null)
    {
        _weld.Process = _selectedQualification.Process;
        _weld.Position = _selectedQualification.Position;
        _weld.MaterialGroup = _selectedQualification.MaterialGroup;
    }

    return Task.CompletedTask;
    }

    private bool ThicknessQualified =>
    _selectedQualification != null &&
    _weld.Thickness >= _selectedQualification.ThicknessMin &&
    _weld.Thickness <= _selectedQualification.ThicknessMax;
        
}






