@page "/quality/weld-register/{ProjectId:guid}"

@attribute [Authorize(Policy = "Permission:Quality.WeldRegister")]
@using MudBlazor
@using WeldAdminPro.Web.Components.Shared.WeldRegister

@using WeldAdminPro.Core.Models
@using WeldAdminPro.Data.Services.Quality
@using WeldAdminPro.Core.Quality.Models
@using WeldAdminPro.Core.Quality.Enums
@using WeldAdminPro.Core.Quality.Services

@using WeldAdminPro.Web.Components.Shared.Dialogs


@inject NavigationManager Navigation
@inject IDialogService DialogService

@inject WeldRegisterApplicationService WeldService
@inject UserContextService UserContext
@inject WeldTraceabilityApplicationService TraceabilityService
@inject WeldWorkflowEngine WorkflowEngine


@inject ISnackbar Snackbar

<PageTitle>Weld Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

    <WeldAnalyticsCards Welds="FilteredWelds.ToList()" />

    <MudPaper Class="pa-4 mt-4">

        <MudGrid>

            <MudItem xs="12" md="3">
                <MudTextField T="string"
                              Label="Search"
                              Variant="Variant.Outlined"
                              Placeholder="Search Weld..."
                              Immediate="true"
                              @bind-Value="_search" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="WeldWorkflowStatus?"
                           Label="Workflow"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           @bind-Value="_selectedWorkflow">

                    @foreach (var workflow in WorkflowOptions)
                    {
                        <MudSelectItem T="WeldWorkflowStatus?"
                                       Value="@workflow">

                            @workflow

                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="string"
                           Label="Welder"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           @bind-Value="_selectedWelder">

                    @foreach (var welder in WelderOptions)
                    {
                        <MudSelectItem Value="@welder">
                            @welder
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="string"
                           Label="WPS"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           @bind-Value="_selectedWps">

                    @foreach (var wps in WpsOptions)
                    {
                        <MudSelectItem Value="@wps">
                            @wps
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

        </MudGrid>

    </MudPaper>

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-4">

        <MudText Typo="Typo.h5">

            Weld Register

        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NewWeld">

            New Weld

        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(_selectedWeld == null)"
                   OnClick="EditWeld">

            Edit Weld

        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_selectedWeld == null)"
                   OnClick="DeleteWeld">

            Delete Weld

        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.FactCheck"
                   Disabled="@(_selectedWeld == null)"
                   OnClick="CaptureNdt">

            Capture NDT

        </MudButton>


        @if (_selectedWeld != null)
        {
            <MudMenu Label="Advance Workflow"
                     Variant="Variant.Filled"
                     Color="Color.Success"
                     StartIcon="@Icons.Material.Filled.AccountTree"
                     Disabled="@(!AllowedWorkflowTransitions.Any())">

                @foreach (var targetStatus in AllowedWorkflowTransitions)
                {
                    var transitionTarget = targetStatus;

                    <MudMenuItem OnClick="@(() => TransitionSelectedWeldAsync(transitionTarget))">
                        @transitionTarget
                    </MudMenuItem>
                }

            </MudMenu>
        }

    </MudStack>

    <MudGrid Class="mt-4">

        <MudItem xs="12" md="8">

            <WeldRegisterGrid Welds="FilteredWelds.ToList()"
                              SelectedWeld="_selectedWeld"
                              SelectedWeldChanged="SelectedWeldChanged" />

        </MudItem>

        <MudItem xs="12" md="4">

            <WeldDetailsCard Weld="_selectedWeld" />

            <MudDivider Class="my-4" />
            <WeldTraceabilityCard Records="_traceability"
                                  Edit="EditTraceability" />

            @if (_selectedWeld != null)
            {
                <WeldDocumentsCard WeldId="_selectedWeld.Id"
                                   ProjectId="ProjectId"
                                   Changed="WeldDocumentsChanged" />
            }

        </MudItem>

    </MudGrid>

    <MudGrid Class="mt-4">

        <MudItem xs="12">

            <WeldNdtHistoryCard Results="_ndtHistory"
                                ProjectId="ProjectId"
                                WeldNumber="_selectedWeld?.WeldNumber ?? string.Empty"
                                LegacyTraceabilityReviewed="ReviewLegacyNdtTraceabilityAsync" />

        </MudItem>

    </MudGrid>

    <MudGrid Class="mt-4">

        <MudItem xs="12">

            <WeldHistoryCard History="_history" />

        </MudItem>

    </MudGrid>

</MudContainer>

@code
{
    [Parameter]
    public Guid ProjectId { get; set; }

    private Weld? _selectedWeld;

    private List<Weld> _welds = new();

    private string _search = string.Empty;

    private WeldWorkflowStatus? _selectedWorkflow;

    private string? _selectedWelder;

    private string? _selectedWps;

    protected override async Task OnParametersSetAsync()
    {
        _welds = await WeldService.GetProjectWelds(ProjectId);
    }

    private void NewWeld()
    {
        Navigation.NavigateTo(
            $"/quality/weld-new/{ProjectId}");
    }

    private List<WeldNdtResult> _ndtHistory = new();

    private List<WeldHistoryEntry> _history = new();

    private List<WeldTraceabilityRecord> _traceability = new();

    private async Task SelectedWeldChanged(Weld? weld)
    {
        _selectedWeld = weld;

        if (weld == null)
        {
            _ndtHistory.Clear();
            _history.Clear();
            _traceability.Clear();

            return;
        }

        _ndtHistory = await WeldService.GetNdtAsync(weld.Id);
        _history = await WeldService.GetHistoryAsync(weld.Id);
        _traceability = TraceabilityService.GetByWeld(weld.Id);

        return;
    }

    private IReadOnlyList<WeldWorkflowStatus>
        AllowedWorkflowTransitions =>
        _selectedWeld == null
            ? Array.Empty<WeldWorkflowStatus>()
            : WorkflowEngine.GetAllowedTransitions(
                _selectedWeld.WorkflowStatus);

    private async Task TransitionSelectedWeldAsync(
        WeldWorkflowStatus targetStatus)
    {
        var weld = _selectedWeld;

        if (weld == null)
        {
            return;
        }

        try
        {
            await WeldService.TransitionWorkflowAsync(
                weld,
                targetStatus,
                UserContext.Username);

            _welds =
                await WeldService.GetProjectWelds(
                    ProjectId);

            _selectedWeld =
                _welds.FirstOrDefault(
                    w => w.Id == weld.Id);

            if (_selectedWeld != null)
            {
                _ndtHistory =
                    await WeldService.GetNdtAsync(
                        _selectedWeld.Id);

                _history =
                    await WeldService.GetHistoryAsync(
                        _selectedWeld.Id);

                _traceability =
                    TraceabilityService.GetByWeld(
                        _selectedWeld.Id);
            }

            Snackbar.Add(
                $"Weld '{weld.WeldNumber}' workflow changed to " +
                $"'{targetStatus}'.",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Workflow transition failed: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task EditWeld()
    {
        if (_selectedWeld == null)
            return;

        var parameters = new DialogParameters
    {
        { nameof(EditWeldDialog.Weld), _selectedWeld }
    };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<EditWeldDialog>(
            "Edit Weld",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _welds =
            await WeldService.GetProjectWelds(ProjectId);

            StateHasChanged();
        }
    }

    private async Task DeleteWeld()
    {
        var weld = _selectedWeld;

        if (weld == null)
            return;

        var parameters = new DialogParameters
    {
        { nameof(ConfirmDialog.Title), "Delete Weld" },
        { nameof(ConfirmDialog.Message), $"Delete weld '{weld.WeldNumber}'?" }
    };

        var dialog =
            await DialogService.ShowAsync<ConfirmDialog>(
                "Confirm Delete",
                parameters);

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await WeldService.DeleteWeldAsync(weld.Id);

            _welds =
            await WeldService.GetProjectWelds(ProjectId);
        }

        _selectedWeld = null;

        StateHasChanged();
    }

    private async Task ReviewLegacyNdtTraceabilityAsync(
        WeldNdtHistoryCard.LegacyTraceabilityReviewRequest request)
    {
        if (_selectedWeld == null || request.Ndt.WeldId != _selectedWeld.Id)
            return;

        try
        {
            await WeldService.ReviewLegacyNdtTraceabilityAsync(
                _selectedWeld.Id,
                request.Ndt.Id,
                request.Review.EquipmentIds,
                request.Review.ReviewRemarks);

            _ndtHistory = await WeldService.GetNdtAsync(_selectedWeld.Id);
            _history = await WeldService.GetHistoryAsync(_selectedWeld.Id);

            Snackbar.Add(
                $"Legacy NDT traceability reviewed and linked for weld '{_selectedWeld.WeldNumber}'.",
                Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Legacy NDT traceability review failed: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task CaptureNdt()
    {
        if (_selectedWeld == null)
            return;

        // NDT capture is only valid once the weld reaches
        // NdtPending or NdtInProgress. The service remains
        // the authoritative server-side workflow guard.
        if (
            _selectedWeld.WorkflowStatus !=
            WeldWorkflowStatus.NdtPending &&
            _selectedWeld.WorkflowStatus !=
            WeldWorkflowStatus.NdtInProgress)
        {
            Snackbar.Add(
                $"NDT cannot be captured yet. Weld '{_selectedWeld.WeldNumber}' " +
                $"is currently in workflow status '{_selectedWeld.WorkflowStatus}'. " +
                "Please advance the weld workflow before capturing NDT.",
                Severity.Warning);

            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(CaptureNdtDialog.Weld), _selectedWeld },
            { nameof(CaptureNdtDialog.ProjectId), ProjectId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<CaptureNdtDialog>(
            "Capture NDT",
            parameters,
            options);

        var result = await dialog.Result;

        if (result?.Canceled != false)
            return;

        var ndt = (WeldNdtResult)result.Data!;

        var selectedWeld = _selectedWeld;

        if (selectedWeld == null)
            return;

        try
        {
            await WeldService.CaptureNdtAsync(selectedWeld, ndt);

            _welds =
                await WeldService.GetProjectWelds(ProjectId);

            _ndtHistory =
                await WeldService.GetNdtAsync(selectedWeld.Id);

            _history =
                await WeldService.GetHistoryAsync(selectedWeld.Id);

            Snackbar.Add(
                $"NDT result captured for weld '{selectedWeld.WeldNumber}'.",
                Severity.Success);

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"NDT capture failed: {ex.Message}",
                Severity.Error);
        }
    }
    private async Task EditTraceability()
    {
        var selectedWeld = _selectedWeld;

        if (selectedWeld == null)
            return;

        var latest = _traceability.LastOrDefault();

        if (latest == null)
        {
            latest = new WeldTraceabilityRecord
            {
                Id = Guid.NewGuid(),
                WeldId = selectedWeld.Id,
                WpsNumber = selectedWeld.WpsNumber,
                WelderQualification = selectedWeld.WelderNumber,
                MaterialHeatNumber = selectedWeld.MaterialHeat1
            };
        }

        var parameters = new DialogParameters
    {
        {
            nameof(EditTraceabilityDialog.Record),
            latest
        }
    };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog =
            await DialogService.ShowAsync<EditTraceabilityDialog>(
                "Edit Traceability",
                parameters,
                options);

        var result = await dialog.Result;

        if (result?.Canceled != false)
            return;

        _traceability =
            TraceabilityService.GetByWeld(selectedWeld.Id);

        StateHasChanged();
    }

    private Task WeldDocumentsChanged()
    {
        StateHasChanged();

        return Task.CompletedTask;
    }
    private IEnumerable<Weld> FilteredWelds =>
    _welds.Where(w =>

        // Search
        (
            string.IsNullOrWhiteSpace(_search)
            ||
            (w.WeldNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (w.DrawingNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (w.JointNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (w.WelderNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            ||
            (w.WpsNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        )

        &&

        // Workflow
        (
            !_selectedWorkflow.HasValue
            ||
            w.WorkflowStatus == _selectedWorkflow.Value
        )

        &&

        // Welder
        (
            string.IsNullOrWhiteSpace(_selectedWelder)
            ||
            w.WelderNumber == _selectedWelder
        )

        &&

        // WPS
        (
            string.IsNullOrWhiteSpace(_selectedWps)
            ||
            w.WpsNumber == _selectedWps
        ));

    private IEnumerable<WeldWorkflowStatus> WorkflowOptions =>
    _welds
        .Select(w => w.WorkflowStatus)
        .Distinct()
        .OrderBy(s => s);

    private IEnumerable<string> WelderOptions =>
    _welds
        .Select(w => w.WelderNumber)
        .Where(w => !string.IsNullOrWhiteSpace(w))
        .Distinct()
        .OrderBy(w => w)!;

    private IEnumerable<string> WpsOptions =>
    _welds
        .Select(w => w.WpsNumber)
        .Where(w => !string.IsNullOrWhiteSpace(w))
        .Distinct()
        .OrderBy(w => w)!;

}




