@page "/quality/project-weld-register"

@attribute [Authorize(Policy = "Permission:Quality.WeldRegister")]
@using MudBlazor
@using WeldAdminPro.Core.Models
@using WeldAdminPro.Data.Services.Projects
@using WeldAdminPro.Web.Components.Shared.Projects

@inject ProjectApplicationService ProjectService
@inject NavigationManager Navigation

<PageTitle>Project Weld Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">

    <MudText Typo="Typo.h4" GutterBottom="true">
        Project Weld Register
    </MudText>

    <MudText Typo="Typo.subtitle1" Class="mb-4">
        Select a project to open its Weld Register.
    </MudText>

    <ProjectSelectorGrid Projects="_projects"
                         OpenProject="OpenProject" OpenButtonText="Open Weld Register" />

</MudContainer>

@code
{
    private List<Project> _projects = new();

    protected override async Task OnInitializedAsync()
    {
        _projects = await ProjectService.GetProjectsAsync();
    }

    private void OpenProject(Project project)
    {
        Navigation.NavigateTo(
            $"/quality/weld-register/{project.Id}");
    }
}

