@page "/"

@using WeldAdminPro.Web.Components.ControlCentres

@inject WeldAdminPro.Web.Services.Dashboard.DashboardService DashboardService

<PageTitle>WeldAdmin Pro Enterprise</PageTitle>

<h1>WeldAdmin Pro Enterprise</h1>

<h4>Engineering Manufacturing Intelligence</h4>

<hr />

@if (_snapshot == null)
{
    <p><em>Loading Dashboard...</em></p>
}
else
{
    <OperationsControlCentre Snapshot="_snapshot" />
}

@code
{
    private WeldAdminPro.Data.Services.ProductionEngine.ProductionSnapshot?
        _snapshot;

    protected override void OnInitialized()
    {
        _snapshot = DashboardService.GetDashboard();
    }
}