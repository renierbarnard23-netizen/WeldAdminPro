@page "/production/workorder/{Id:guid}"

@attribute [Authorize(Policy = "Permission:Production.WorkOrders")]
@using MudBlazor
@using WeldAdminPro.Core.Models
@using WeldAdminPro.Core.Analytics.Production
@using WeldAdminPro.Data.Services.Production

@using WeldAdminPro.Web.Components.Shared.Enterprise
@using WeldAdminPro.Web.Components.Shared.Production

@inject ProductionApplicationService ProductionService

<PageTitle>Work Order</PageTitle>

<EnterprisePageHeader
    Title="@($"Work Order {(_workOrder?.WorkOrderNumber ?? "")}")"
    Subtitle="@(_workOrder?.ProjectName ?? "Production Work Order")"
    Icon="@Icons.Material.Filled.Assignment">

    <Actions>

        <MudButton
            Variant="Variant.Filled"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Refresh"
            OnClick="Load">

            Refresh

        </MudButton>

    </Actions>

</EnterprisePageHeader>

<MudGrid Class="mb-4">

    <MudItem xs="12" sm="6" lg="3">

        <EnterpriseKpiCard Title="Progress"
                           Value="@($"{GetProgress()}%")"
                           Status="@(_workOrder?.Status.ToString() ?? "")"
                           ChipColor="@GetStatusColor()"
                           Icon="@Icons.Material.Filled.Timeline"
                           IconColor="Color.Info" />

    </MudItem>

    <MudItem xs="12" sm="6" lg="3">

        <EnterpriseKpiCard Title="Readiness"
                           Value="@(_readiness?.IsReady == true ? "Ready" : "Blocked")"
                           Status="@(_readiness?.Reason ?? "")"
                           ChipColor="@(_readiness?.IsReady == true ? Color.Success : Color.Warning)"
                           Icon="@Icons.Material.Filled.FactCheck"
                           IconColor="@(_readiness?.IsReady == true ? Color.Success : Color.Warning)" />

    </MudItem>

    <MudItem xs="12" sm="6" lg="3">

        <EnterpriseKpiCard Title="Priority"
                           Value="@(_workOrder?.Priority.ToString() ?? "-")"
                           Status="AI Priority"
                           ChipColor="Color.Info"
                           Icon="@Icons.Material.Filled.PriorityHigh"
                           IconColor="Color.Info" />

    </MudItem>

    <MudItem xs="12" sm="6" lg="3">

        <EnterpriseKpiCard Title="Health"
                           Value="@($"{GetHealth()}%")"
                           Status="Excellent"
                           ChipColor="Color.Success"
                           Icon="@Icons.Material.Filled.Favorite"
                           IconColor="Color.Success" />

    </MudItem>

</MudGrid>

@if (_workOrder == null)
{
    <MudPaper Class="pa-8 my-6">

        <MudStack AlignItems="AlignItems.Center"
        Justify="Justify.Center"
        Spacing="2">

            <MudProgressCircular Indeterminate="true"
            Color="Color.Primary" />

            <MudText>

                Loading work order...

            </MudText>

        </MudStack>

    </MudPaper>
}
else
{

    <DashboardSection
        Title="Overview"
        Icon="@Icons.Material.Filled.Info">

        <WorkOrderHeader 
            WorkOrder="_workOrder"
            ProjectName="@(_workOrder?.ProjectName ?? "")"
            Health="@GetHealth()" />

        <WorkOrderProgress WorkOrder="_workOrder"
                           Progress="@GetProgress()" />

    </DashboardSection>

    <DashboardSection
            Title="Actions"
            Icon="@Icons.Material.Filled.PlayCircle">

        <WorkOrderActions Start="Start"
                      Pause="Pause"
                      Complete="Complete" />

    </DashboardSection>

    <DashboardSection
    Title="Production Readiness"
    Icon="@Icons.Material.Filled.FactCheck">

    <MudGrid>

        <MudItem xs="12" lg="6">

            <WorkOrderInformation WorkOrder="_workOrder" />

        </MudItem>

        <MudItem xs="12" lg="6">

            <WorkOrderReadinessCard Readiness="_readiness" />

        </MudItem>

    </MudGrid>

    </DashboardSection>

    <DashboardSection
    Title="Materials"
    Icon="@Icons.Material.Filled.Inventory2">

    <WorkOrderMaterials WorkOrder="_workOrder" />

    </DashboardSection>

    <DashboardSection
    Title="AI Recommendation"
    Icon="@Icons.Material.Filled.Psychology">

    <WorkOrderRecommendation Recommendation="_recommendation" />

    </DashboardSection>

    <DashboardSection
    Title="Production Planning"
    Icon="@Icons.Material.Filled.Event">

    <WorkOrderPlanning Schedule="_schedule"
                       Capacity="_capacity"
                       Delays="_delays"
                       Timeline="_timeline" />
    </DashboardSection>

    <DashboardSection
    Title="Timeline"
    Icon="@Icons.Material.Filled.Timeline">

    <WorkOrderTimeline Timeline="_timeline" />

    </DashboardSection>
}

@code {

    [Parameter]

    public Guid Id { get; set; }

    private WeldAdminPro.Core.Models.WorkOrder? _workOrder;

    private WorkOrderReadiness? _readiness;

    private AIProductionRecommendation? _recommendation;

    private List<ProductionScheduleItem> _schedule = new();

    private List<ProductionCapacityForecast> _capacity = new();

    private List<ProductionDelayPrediction> _delays = new();

    private List<ProductionGanttItem> _timeline = new();

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        _workOrder =
            ProductionService.GetWorkOrder(Id);

        _readiness =
            ProductionService.GetWorkOrderReadiness(Id);

        _recommendation =
            ProductionService.GetWorkOrderRecommendation(Id);

        _schedule =
            ProductionService.GetSchedule();

        _capacity =
            ProductionService.GetCapacityForecast();

        _delays =
            ProductionService.GetDelayPredictions();

        _timeline =
            ProductionService.GetTimeline();
    }

    private void Start()
    {
        ProductionService.StartWorkOrder(Id);

        Load();
    }

    private void Pause()
    {
        ProductionService.PauseWorkOrder(Id);

        Load();
    }

    private void Complete()
    {
        ProductionService.CompleteWorkOrder(Id);

        Load();
    }

    private Color GetStatusColor()
    {
        if (_workOrder == null)
            return Color.Default;

        return _workOrder.Status switch
        {
            WorkOrderStatus.Ready => Color.Success,

            WorkOrderStatus.InProduction => Color.Info,

            WorkOrderStatus.Paused => Color.Warning,

            WorkOrderStatus.Completed => Color.Success,

            WorkOrderStatus.Cancelled => Color.Error,

            _ => Color.Default
        };
    }

    private int GetProgress()
    {
        if (_workOrder == null)
            return 0;

        return _workOrder.Status switch
        {
            WorkOrderStatus.Ready => 0,

            WorkOrderStatus.InProduction => 50,

            WorkOrderStatus.Paused => 50,

            WorkOrderStatus.Completed => 100,

            _ => 0
        };
    }

    private int GetHealth()
    {
        if (_workOrder == null)
            return 0;

        int score = 100;

        if (_readiness != null && !_readiness.IsReady)
            score -= 30;

        if (_delays.Any())
            score -= 20;

        if (_workOrder.Status == WorkOrderStatus.Paused)
            score -= 10;

        return Math.Max(score, 0);
    }

}