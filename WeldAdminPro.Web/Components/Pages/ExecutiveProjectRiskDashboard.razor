@page "/projects/risk"

@using WeldAdminPro.Core.Analytics.Executive
@using WeldAdminPro.Data.Services

@inject ProjectRiskService RiskService
@inject NavigationManager Navigation

<PageTitle>Project Risk Dashboard</PageTitle>

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Project Risk Dashboard
    </MudText>

    <MudTable T="ProjectRiskModel"
              Items="_projects"
              Hover="true"
              Dense="true"
              Striped="true">

        <HeaderContent>

            <MudTh>Project</MudTh>

            <MudTh class="text-end">Budget</MudTh>

            <MudTh class="text-end">Material Cost</MudTh>

            <MudTh class="text-end">Budget Used %</MudTh>

            <MudTh>Risk</MudTh>

            <MudTh></MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>

                @context.ProjectName

            </MudTd>

            <MudTd class="text-end">

                @context.Budget.ToString("C")

            </MudTd>

            <MudTd class="text-end">

                @context.MaterialCost.ToString("C")

            </MudTd>

            <MudTd class="text-end">

                @context.BudgetUsedPercent.ToString("N2") %

            </MudTd>

            <MudTd>

                @switch (context.RiskLevel)
                {
                    case "Critical":
                        <MudChip T="string"
                                 Color="Color.Error"
                                 Variant="Variant.Filled">
                            Critical
                        </MudChip>
                        break;

                    case "High":
                        <MudChip T="string"
                                 Color="Color.Warning"
                                 Variant="Variant.Filled">
                            High
                        </MudChip>
                        break;

                    case "Medium":
                        <MudChip T="string"
                                 Color="Color.Info"
                                 Variant="Variant.Filled">
                            Medium
                        </MudChip>
                        break;

                    default:
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Filled">
                            Low
                        </MudChip>
                        break;
                }

            </MudTd>

            <MudTd>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="@(() => Open(context.ProjectId))">

                    Open

                </MudButton>

            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>

@code {

    private List<ProjectRiskModel> _projects = new();

    protected override void OnInitialized()
    {
        _projects = RiskService.GetProjectRiskSummary();
    }

    private void Open(string projectId)
    {
        Navigation.NavigateTo($"/projects/{projectId}");
    }

}