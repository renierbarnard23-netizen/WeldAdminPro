
@using WeldAdminPro.Web.Models.Navigation
@using WeldAdminPro.Web.Services.Security

@inject UserContextService UserContext
@inject WeldAdminPro.Data.Services.Security.PermissionAuthorizationService PermissionAuthorization


@if (HasChildren)
{
    <div class="nav-item px-3">

        <a class="nav-link"
           href="#"
           @onclick="Toggle">

            @Node.Icon @Node.Text @(Node.Expanded ? "▼" : "►")

        </a>

    </div>

    @if (Node.Expanded)
    {
        foreach (var child in Node.Children)
        {
            <NavigationNodeView Node="child" />
        }
    }
}
else
{
    <div class="nav-item ps-5">

        <NavLink class="nav-link"
                 href="@Node.Url"
                 Match="NavLinkMatch.Prefix">

            @Node.Icon @Node.Text

        </NavLink>

    </div>
}

@code
{
    [Parameter]
    public required NavigationNode Node { get; set; }

    private bool HasChildren => Node.Children.Count > 0;

    private void Toggle()
    {
        Node.Expanded = !Node.Expanded;
    }
       
}