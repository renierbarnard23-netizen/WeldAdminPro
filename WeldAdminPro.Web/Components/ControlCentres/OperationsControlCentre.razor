@using MudBlazor
@using WeldAdminPro.Data.Services.ProductionEngine
@using WeldAdminPro.Web.Components.Dashboard
@using WeldAdminPro.Web.Components.Shared.Production

@if (Snapshot == null)
{
    <MudPaper Class="pa-8 my-6">

        <MudStack AlignItems="AlignItems.Center"
                  Justify="Justify.Center"
                  Spacing="2">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText Typo="Typo.subtitle1">
                Loading Operations Control Centre...
            </MudText>

        </MudStack>

    </MudPaper>
}
else
{
    @* ==========================================================
       Executive Summary
    ========================================================== *@

    <DashboardSection Title="Executive Summary"
                      Icon="@Icons.Material.Filled.Dashboard">

        <MudGrid>

            <MudItem xs="12" md="4">

                <KpiCard Title="Factory Status"
                         Value="@Snapshot.FactoryStatus"
                         Subtitle="Current Status" />

            </MudItem>

            <MudItem xs="12" md="4">

                <KpiCard Title="Health Score"
                         Value="@Snapshot.HealthScore.ToString()"
                         Subtitle="Overall Factory Health" />

            </MudItem>

            <MudItem xs="12" md="4">

                <KpiCard Title="Capacity"
                         Value="@($"{Snapshot.CapacityLoad:F0}%")"
                         Subtitle="Current Load" />

            </MudItem>

        </MudGrid>

    </DashboardSection>

    @* ==========================================================
       Factory Health & Alerts
    ========================================================== *@

    <DashboardSection Title="Factory Health & Alerts"
                      Icon="@Icons.Material.Filled.HealthAndSafety">

        <MudGrid>

            <MudItem xs="12" lg="4">

                <FactoryHealthCard Snapshot="Snapshot" />

            </MudItem>

            <MudItem xs="12" lg="8">

                <FactoryAlerts Alerts="Snapshot.Alerts" />

            </MudItem>

        </MudGrid>

    </DashboardSection>

    @* ==========================================================
       Operations
    ========================================================== *@

    <DashboardSection Title="Operations"
                      Icon="@Icons.Material.Filled.Factory">

        <MudGrid>

            <MudItem xs="12" lg="6">

                <ControlTowerCard ControlTower="Snapshot.ControlTower" />

            </MudItem>

            <MudItem xs="12" lg="6">

                <WorkCenterStatus Snapshot="Snapshot" />

            </MudItem>

        </MudGrid>

    </DashboardSection>

    @* ==========================================================
       Production Planning
    ========================================================== *@

    <DashboardSection Title="Production Planning"
                      Icon="@Icons.Material.Filled.Timeline">

        <MudGrid>

            <MudItem xs="12" lg="6">

                <ProductionQueue Snapshot="Snapshot" />

            </MudItem>

            <MudItem xs="12" lg="6">

                <RecommendationPanel Snapshot="Snapshot" />

            </MudItem>

        </MudGrid>

    </DashboardSection>
}

@code
{
    [Parameter]
    public ProductionSnapshot? Snapshot { get; set; }
}