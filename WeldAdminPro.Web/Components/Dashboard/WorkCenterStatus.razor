@using MudBlazor
@using WeldAdminPro.Data.Services.ProductionEngine

@if (Snapshot == null)
{
    <MudPaper Class="pa-4">
        <div class="card-body">
            Loading work centres...
        </div>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4">

        <MudText Typo="Typo.h6">

            Work Centre Status

        </MudText>

        <MudDivider Class="mb-4" />

        <div class="card-body">

            @if (!Snapshot.WorkCenters.Any())
            {
                <p>No work centres available.</p>
            }
            else
            {
                @foreach (var centre in Snapshot.WorkCenters)
                {
                    <MudPaper Class="pa-3 mb-4" Elevation="1">

                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center">

                            <MudText Typo="Typo.subtitle1">

                                @centre.Name

                            </MudText>

                            <MudChip T="string"
                                     Color="@(centre.UtilizationPercent >= 90 ? Color.Error :
                                                          centre.UtilizationPercent >= 75 ? Color.Warning :
                                                          Color.Success)">

                                @centre.UtilizationPercent %

                            </MudChip>

                        </MudStack>

                        <MudProgressLinear Value="@centre.UtilizationPercent"
                                           Color="@(centre.UtilizationPercent >= 90 ? Color.Error :
                                                                      centre.UtilizationPercent >= 75 ? Color.Warning :
                                                                      Color.Success)"
                                           Rounded="true"
                                           Class="my-2" />

                        <MudGrid Class="mt-3">

                            <MudItem xs="12" sm="4">

                                <MudText Typo="Typo.caption">

                                    Work Order

                                </MudText>

                                <MudText Typo="Typo.subtitle2">

                                    @centre.CurrentWorkOrder

                                </MudText>

                            </MudItem>

                            <MudItem xs="12" sm="4">

                                <MudText Typo="Typo.caption">

                                    Queue

                                </MudText>

                                <MudText Typo="Typo.subtitle2">

                                    @centre.QueueLength

                                </MudText>

                            </MudItem>

                            <MudItem xs="12" sm="4">

                                <MudText Typo="Typo.caption">

                                    Hours Remaining

                                </MudText>

                                <MudText Typo="Typo.subtitle2">

                                    @centre.HoursRemaining

                                </MudText>

                            </MudItem>

                        </MudGrid>

                    </MudPaper>
                }
            }

        </div>

    </MudPaper>
}

@code
{
    [Parameter]
    public ProductionSnapshot? Snapshot { get; set; }
}