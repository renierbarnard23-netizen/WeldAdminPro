@inject NavigationManager Navigation
@inject WeldAdminPro.Web.Security.WeldAuthenticationStateProvider AuthenticationProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">

        <div>

            <div class="navbar-brand">
                WeldAdmin Pro Enterprise
            </div>

            <small style="color:white;">
                Engineering Manufacturing Intelligence
            </small>

        </div>

    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">

                🏠 Dashboard

            </NavLink>
        </div>

        <div class="nav-item px-3">

            <a class="nav-link"
               href="#"
               @onclick="() => projectsExpanded = !projectsExpanded">

                📁 Projects @(projectsExpanded ? "▼" : "►")

            </a>

        </div>

        @if (projectsExpanded)
        {
            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/projects">

                    Projects

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/projects/costs">

                    Project Costs

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/projects/profitability">

                    Project Profitability

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/projects/risk">

                    Project Risk

                </NavLink>

            </div>

            <div class="nav-item ps-5">
                <NavLink class="nav-link"
                         href="/projects/compliance">

                    Project Compliance

                </NavLink>
            </div>
        }

        <div class="nav-item px-3">

            <a class="nav-link"
               href="#"
               @onclick="() => productionExpanded = !productionExpanded">

                🏭 Production @(productionExpanded ? "▼" : "►")

            </a>

        </div>

        @if (productionExpanded)
        {
            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/production">

                    Dashboard

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/production/workorders">

                    Work Orders

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/production/controltower">

                    Control Tower

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/production/settings">

                    Production Settings

                </NavLink>

            </div>
        }

        <div class="nav-item px-3">

            <a class="nav-link"
               href="#"
               @onclick="() => inventoryExpanded = !inventoryExpanded">

                📦 Inventory @(inventoryExpanded ? "▼" : "►")

            </a>

        </div>

        @if (inventoryExpanded)
        {
            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory">

                    Inventory

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/stockin">

                    Receive Stock

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/stockout">

                    Issue Stock

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/transactions">

                    Transactions

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/ledger">

                    Ledger

                </NavLink>

            </div>

            <hr />

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/forecast">

                    📈 Stock Forecast

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/material-trends">

                    📊 Material Trends

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/project-risk">

                    ⚠ Project Risk

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/smart-reorder">

                    🔄 Smart Reorder Planner

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/inventory/material-cost-drivers">

                    💰 Material Cost Drivers

                </NavLink>

            </div>
                        
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="/procurement/purchase-orders">

                🛒 Procurement

            </NavLink>
        </div>

        <div class="nav-item px-3">

            <a class="nav-link"
               href="#"
               @onclick="() => qualityExpanded = !qualityExpanded">

                ✔ Quality @(qualityExpanded ? "▼" : "►")

            </a>

        </div>

        <div class="nav-item ps-5">

            <NavLink class="nav-link"
                     href="/quality">

                Quality Dashboard

            </NavLink>

        </div>

        @if (qualityExpanded)
        {
            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/quality/project-weld-register">

                    Weld Register

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/quality/wps">

                    WPS

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/quality/welders">

                    Welder Qualifications

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/quality/repairs">

                    Repairs

                </NavLink>

            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="reports">

                📊 Reports

            </NavLink>
        </div>

        <div class="nav-item px-3">

            <a class="nav-link"
               href="#"
               @onclick="() => administrationExpanded = !administrationExpanded">

                ⚙ Administration @(administrationExpanded ? "▼" : "►")

            </a>

        </div>

        @if (administrationExpanded)
        {
            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/administration/users">

                    User Management

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/administration/audit">

                    Audit Log

                </NavLink>

            </div>

            <div class="nav-item ps-5">

                <NavLink class="nav-link"
                         href="/administration/settings">

                    Production Settings

                </NavLink>

            </div>
        }

        <div class="nav-item px-3">

            <a class="nav-link"
               href="#"
               @onclick="Logout">

                🚪 Logout

            </a>

        </div>

    </nav>

</div>

@code {

    private bool projectsExpanded = true;
    private bool productionExpanded = true;
    private bool inventoryExpanded = false;
    private bool qualityExpanded = true;
    private bool administrationExpanded = true;

    private void Logout()
    {
        AuthenticationProvider.SignOut();

        Navigation.NavigateTo("/login", true);
    }
}