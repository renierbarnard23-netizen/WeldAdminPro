<Application x:Class="WeldAdminPro.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WeldAdminPro.UI.Converters">

    <Application.Resources>

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

        <converters:BoolToYesNoConverter
            x:Key="BoolToYesNoConverter"/>

        <converters:WelderStatusConverter
            x:Key="WelderStatusConverter"/>

        <converters:HoldPointStatusToBrushConverter
            x:Key="HoldPointStatusToBrushConverter"/>

    </Application.Resources>

</Application>