<UserControl x:Class="WeldAdminPro.UI.Views.StockLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<DockPanel Margin="10">
		<!-- 🔵 Global Summary Panel -->
		<Border DockPanel.Dock="Top"
        Background="#F5F5F5"
        Padding="12"
        CornerRadius="6"
        Margin="0,0,0,10">

			<UniformGrid Columns="4">

				<StackPanel>
					<TextBlock Text="Stock Items"
                       FontWeight="SemiBold"/>
					<TextBlock Text="{Binding TotalStockItems}"
                       FontSize="18"
                       FontWeight="Bold"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="Total Units In Stock"
                       FontWeight="SemiBold"/>
					<TextBlock Text="{Binding TotalUnitsInStock}"
                       FontSize="18"
                       FontWeight="Bold"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="Inventory Value"
                       FontWeight="SemiBold"/>
					<TextBlock Text="{Binding TotalInventoryValue, StringFormat={}{0:N2}}"
                       FontSize="18"
                       FontWeight="Bold"/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="Total Transactions"
                       FontWeight="SemiBold"/>
					<TextBlock Text="{Binding TotalTransactions}"
                       FontSize="18"
                       FontWeight="Bold"/>
				</StackPanel>

			</UniformGrid>

		</Border>


		<!-- 🔵 Top Action Bar -->
		<StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,10">
			<!-- 🔵 Date Filter Bar -->
			<StackPanel DockPanel.Dock="Top"
            Orientation="Horizontal"
            Margin="0,0,0,10"
            VerticalAlignment="Center">

				<TextBlock Text="Start:"
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

				<DatePicker SelectedDate="{Binding StartDate}"
                Width="140"
                Margin="0,0,15,0"/>

				<TextBlock Text="End:"
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

				<DatePicker SelectedDate="{Binding EndDate}"
                Width="140"
                Margin="0,0,15,0"/>

				<Button Content="Apply Filter"
            Width="120"
            Command="{Binding ApplyFilterCommand}"/>

			</StackPanel>


			<Button Content="Recalculate Stored Balances"
                    Width="220"
                    Command="{Binding RecalculateCommand}"/>
		</StackPanel>

		<!-- 🔵 Ledger Area -->
		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<ItemsControl ItemsSource="{Binding LedgerGroups}">

				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Expander IsExpanded="False" Margin="0,0,0,12">

							<Expander.Header>
								<StackPanel Orientation="Vertical">

									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding ItemCode}"
                       FontWeight="Bold"
                       Width="120"/>

										<TextBlock Text="{Binding Description}"
                       Margin="10,0,0,0"
                       Width="250"/>

										<TextBlock Text="Closing:"
                       Margin="30,0,5,0"
                       FontWeight="SemiBold"/>

										<TextBlock Text="{Binding CurrentBalance}"
                       FontWeight="Bold"/>
									</StackPanel>

									<StackPanel Orientation="Horizontal" Margin="0,5,0,0">

										<TextBlock Text="Opening:"
                       Width="80"/>

										<TextBlock Text="{Binding OpeningBalance}"
                       Width="80"/>

										<TextBlock Text="Total IN:"
                       Margin="20,0,0,0"
                       Width="70"/>

										<TextBlock Text="{Binding TotalIn}"
                       Width="80"/>

										<TextBlock Text="Total OUT:"
                       Width="80"/>

										<TextBlock Text="{Binding TotalOut}"
                       Width="80"/>

										<TextBlock Text="Value:"
                       Margin="20,0,0,0"
                       Width="50"/>

										<TextBlock Text="{Binding TotalMovementValue, StringFormat={}{0:N2}}"
                       FontWeight="SemiBold"/>
									</StackPanel>

								</StackPanel>
							</Expander.Header>


							<DataGrid ItemsSource="{Binding Transactions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="All"
                                      Margin="0,5,0,0">

								<!-- 🔴 Integrity Highlight -->
								<DataGrid.RowStyle>
									<Style TargetType="DataGridRow">
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsLedgerMismatch}" Value="True">
												<Setter Property="Background" Value="#FFCDD2"/>
												<Setter Property="Foreground" Value="Black"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</DataGrid.RowStyle>

								<DataGrid.Columns>

									<DataGridTextColumn Header="Date"
                                        Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                        Width="150"/>

									<DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="70"/>

									<DataGridTextColumn Header="Qty In"
                                        Binding="{Binding QtyIn}"
                                        Width="80"/>

									<DataGridTextColumn Header="Qty Out"
                                        Binding="{Binding QtyOut}"
                                        Width="80"/>

									<DataGridTextColumn Header="Unit Cost"
                                        Binding="{Binding UnitCost, StringFormat={}{0:N2}}"
                                        Width="100"/>

									<DataGridTextColumn Header="Tx Value"
                                        Binding="{Binding TransactionValue, StringFormat={}{0:N2}}"
                                        Width="110"/>

									<DataGridTextColumn Header="Project"
                                        Binding="{Binding ProjectName}"
                                        Width="150"/>

									<DataGridTextColumn Header="Reference"
                                        Binding="{Binding Reference}"
                                        Width="120"/>

									<DataGridTextColumn Header="Balance After"
                                        Binding="{Binding BalanceAfter}"
                                        Width="110"/>

								</DataGrid.Columns>

							</DataGrid>

						</Expander>

					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</ScrollViewer>

	</DockPanel>
</UserControl>
