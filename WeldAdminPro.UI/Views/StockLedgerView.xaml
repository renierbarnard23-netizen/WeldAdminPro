<UserControl x:Class="WeldAdminPro.UI.Views.StockLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<DockPanel Margin="10">

		<TabControl>

			<!-- ===================================================== -->
			<!-- TAB 1 – LEDGER -->
			<!-- ===================================================== -->

			<TabItem Header="Stock Ledger">

				<DockPanel Margin="10">

					<!-- Recalculate -->
					<StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">
						<Button Content="Recalculate Stored Balances"
                                Width="220"
                                Command="{Binding RecalculateCommand}"/>
					</StackPanel>

					<!-- Date Filter -->
					<StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

						<TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<DatePicker SelectedDate="{Binding StartDate}"
                                    Width="140"
                                    Margin="0,0,15,0"/>

						<TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<DatePicker SelectedDate="{Binding EndDate}"
                                    Width="140"
                                    Margin="0,0,15,0"/>

						<Button Content="Apply Filter"
                                Width="120"
                                Command="{Binding ApplyFilterCommand}"/>
					</StackPanel>

					<!-- Period Summary -->
					<Border DockPanel.Dock="Top"
                            Background="#F5F5F5"
                            Padding="10"
                            Margin="0,0,0,10"
                            CornerRadius="4">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="40"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- Units -->
							<StackPanel Grid.Column="0">
								<TextBlock Text="Period In" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding PeriodTotalIn}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
							</StackPanel>

							<StackPanel Grid.Column="1">
								<TextBlock Text="Period Out" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding PeriodTotalOut}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Net Movement" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding PeriodNetMovement}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
							</StackPanel>

							<Border Grid.Column="3"
                                    Width="1"
                                    Background="#CCCCCC"
                                    Margin="10,0"/>

							<!-- Value -->
							<StackPanel Grid.Column="4">
								<TextBlock Text="Value In" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding PeriodValueIn, StringFormat={}{0:N2}}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
							</StackPanel>

							<StackPanel Grid.Column="5">
								<TextBlock Text="Value Out" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding PeriodValueOut, StringFormat={}{0:N2}}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
							</StackPanel>

							<StackPanel Grid.Column="6">
								<TextBlock Text="Net Value" FontWeight="SemiBold"/>
								<TextBlock Text="{Binding PeriodNetValue, StringFormat={}{0:N2}}"
                                           FontSize="16"
                                           FontWeight="Bold"/>
							</StackPanel>
						</Grid>
					</Border>

					<!-- Ledger -->
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding LedgerGroups}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Expander Margin="0,0,0,12">

										<Expander.Header>
											<DockPanel>
												<TextBlock Text="{Binding ItemCode}"
                                                           FontWeight="Bold"
                                                           Width="120"/>
												<TextBlock Text="{Binding Description}"
                                                           Margin="10,0,0,0"
                                                           Width="250"/>
												<TextBlock Text="Current Balance:"
                                                           Margin="30,0,5,0"
                                                           FontWeight="SemiBold"/>
												<TextBlock Text="{Binding CurrentBalance}"
                                                           FontWeight="Bold"/>
											</DockPanel>
										</Expander.Header>

										<DataGrid ItemsSource="{Binding Transactions}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  GridLinesVisibility="All"
                                                  Margin="0,5,0,0">

											<DataGrid.Columns>
												<DataGridTextColumn Header="Date"
                                                    Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                    Width="150"/>
												<DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="70"/>
												<DataGridTextColumn Header="Qty In"
                                                    Binding="{Binding QtyIn}"
                                                    Width="80"/>
												<DataGridTextColumn Header="Qty Out"
                                                    Binding="{Binding QtyOut}"
                                                    Width="80"/>
												<DataGridTextColumn Header="Unit Cost"
                                                    Binding="{Binding UnitCost, StringFormat={}{0:N2}}"
                                                    Width="100"/>
												<DataGridTextColumn Header="Tx Value"
                                                    Binding="{Binding TransactionValue, StringFormat={}{0:N2}}"
                                                    Width="110"/>
												<DataGridTextColumn Header="Project"
                                                    Binding="{Binding ProjectName}"
                                                    Width="150"/>
												<DataGridTextColumn Header="Reference"
                                                    Binding="{Binding Reference}"
                                                    Width="120"/>
												<DataGridTextColumn Header="Balance After"
                                                    Binding="{Binding BalanceAfter}"
                                                    Width="110"/>
											</DataGrid.Columns>

										</DataGrid>
									</Expander>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

				</DockPanel>
			</TabItem>

			<!-- ===================================================== -->
			<!-- TAB 2 – EXECUTIVE ANALYTICS -->
			<!-- ===================================================== -->

			<TabItem Header="Executive Movement Analytics">

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="10">

						<WrapPanel Margin="0,0,0,20">

							<Border Background="#F0F4F8" Padding="12" Margin="5" Width="220">
								<StackPanel>
									<TextBlock Text="Top Moving Item (Value)" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding TopMovingItem}" FontSize="14" FontWeight="Bold"/>
									<TextBlock Text="{Binding TopMovingItemValue, StringFormat={}{0:N2}}"/>
								</StackPanel>
							</Border>

							<Border Background="#F0F4F8" Padding="12" Margin="5" Width="220">
								<StackPanel>
									<TextBlock Text="Most Consumed Item" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding MostConsumedItem}" FontSize="14" FontWeight="Bold"/>
									<TextBlock Text="{Binding MostConsumedUnits}"/>
								</StackPanel>
							</Border>

							<Border Background="#F0F4F8" Padding="12" Margin="5" Width="220">
								<StackPanel>
									<TextBlock Text="Highest Growth Item" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding HighestGrowthItem}" FontSize="14" FontWeight="Bold"/>
									<TextBlock Text="{Binding HighestGrowthUnits}"/>
								</StackPanel>
							</Border>

							<Border Background="#F0F4F8" Padding="12" Margin="5" Width="220">
								<StackPanel>
									<TextBlock Text="Dead Stock Items" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding DeadStockCount}" FontSize="18" FontWeight="Bold"/>
								</StackPanel>
							</Border>

						</WrapPanel>


						<TextBlock Text="Top Moving Inventory (By Value)"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

						<DataGrid ItemsSource="{Binding ItemMovementSummaries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="300">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="120"/>
								<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
								<DataGridTextColumn Header="Total In" Binding="{Binding TotalIn}" Width="90"/>
								<DataGridTextColumn Header="Total Out" Binding="{Binding TotalOut}" Width="90"/>
								<DataGridTextColumn Header="Net Movement" Binding="{Binding NetMovement}" Width="110"/>
								<DataGridTextColumn Header="Movement Value" Binding="{Binding MovementValue, StringFormat={}{0:N2}}" Width="130"/>
								<DataGridTextColumn Header="Current Balance" Binding="{Binding CurrentBalance}" Width="120"/>
								<DataGridTextColumn Header="Stock Value" Binding="{Binding CurrentStockValue, StringFormat={}{0:N2}}" Width="130"/>
								<DataGridTextColumn Header="Avg Inventory" 
                    Binding="{Binding AverageInventory}" Width="110"/>

								<DataGridTextColumn Header="Turnover"
                    Binding="{Binding TurnoverRate}" Width="90"/>

								<DataGridTextColumn Header="Days in Stock"
                    Binding="{Binding DaysInInventory}" Width="110"/>

								<DataGridTextColumn Header="Category"
                    Binding="{Binding MovementCategory}" Width="120"/>

							</DataGrid.Columns>

						</DataGrid>

						<TextBlock Text="Monthly Movement Trend (Visual)"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,25,0,10"/>
						<DataGrid ItemsSource="{Binding MonthlySummaries}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          GridLinesVisibility="All"
          Height="250">

							<DataGrid.Columns>

								<DataGridTextColumn Header="Month"
            Binding="{Binding Month, StringFormat={}{0:yyyy-MM}}"
            Width="120"/>

								<DataGridTextColumn Header="Total In"
            Binding="{Binding TotalIn}"
            Width="100"/>

								<DataGridTextColumn Header="Total Out"
            Binding="{Binding TotalOut}"
            Width="100"/>

								<DataGridTextColumn Header="Net Movement"
            Binding="{Binding NetMovement}"
            Width="120"/>

								<DataGridTextColumn Header="Value In"
            Binding="{Binding ValueIn, StringFormat={}{0:N2}}"
            Width="130"/>

								<DataGridTextColumn Header="Value Out"
            Binding="{Binding ValueOut, StringFormat={}{0:N2}}"
            Width="130"/>

								<DataGridTextColumn Header="Net Value"
            Binding="{Binding NetValue, StringFormat={}{0:N2}}"
            Width="130"/>



							</DataGrid.Columns>

						</DataGrid>


					</StackPanel>
				</ScrollViewer>

			</TabItem>

		</TabControl>

	</DockPanel>
</UserControl>
