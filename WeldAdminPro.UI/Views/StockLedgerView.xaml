<UserControl x:Class="WeldAdminPro.UI.Views.StockLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:WeldAdminPro.UI.Views"
			 mc:Ignorable="d">
			 

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

		<!-- Executive Section Header Style -->
		<Style x:Key="ExecutiveSectionHeaderStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Margin" Value="0,25,0,8"/>
		</Style>
	</UserControl.Resources>

	<DockPanel Margin="10">

		<TabControl Margin="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">

			<!-- ===================================================== -->
			<!-- TAB 1 – STOCK LEDGER -->
			<!-- ===================================================== -->

			<TabItem Header="Stock Ledger">
				<DockPanel Margin="10">

					<StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,10">
						<Button Content="Recalculate Stored Balances"
                                Width="220"
                                Command="{Binding RecalculateCommand}"/>
					</StackPanel>

					<StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

						<TextBlock Text="Start:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<DatePicker SelectedDate="{Binding StartDate}" Width="140" Margin="0,0,15,0"/>

						<TextBlock Text="End:" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<DatePicker SelectedDate="{Binding EndDate}" Width="140" Margin="0,0,15,0"/>

						<Button Content="Apply Filter"
                                Width="120"
                                Command="{Binding ApplyFilterCommand}"/>
					</StackPanel>

					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding LedgerGroups}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Expander Margin="0,0,0,12">
										<Expander.Header>
											<DockPanel>
												<TextBlock Text="{Binding ItemCode}" FontWeight="Bold" Width="120"/>
												<TextBlock Text="{Binding Description}" Margin="10,0,0,0" Width="250"/>
												<TextBlock Text="Current Balance:" Margin="30,0,5,0" FontWeight="SemiBold"/>
												<TextBlock Text="{Binding CurrentBalance}" FontWeight="Bold"/>
											</DockPanel>
										</Expander.Header>

										<DataGrid ItemsSource="{Binding Transactions}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  GridLinesVisibility="All"
                                                  Margin="0,5,0,0">

											<DataGrid.Columns>
												<DataGridTextColumn Header="Date"
                                                    Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                    Width="150"/>
												<DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="70"/>
												<DataGridTextColumn Header="Qty In"
                                                    Binding="{Binding QtyIn}"
                                                    Width="80"/>
												<DataGridTextColumn Header="Qty Out"
                                                    Binding="{Binding QtyOut}"
                                                    Width="80"/>
												<DataGridTextColumn Header="Unit Cost"
                                                    Binding="{Binding UnitCost, StringFormat={}{0:N2}}"
                                                    Width="100"/>
												<DataGridTextColumn Header="Tx Value"
                                                    Binding="{Binding TransactionValue, StringFormat={}{0:N2}}"
                                                    Width="110"/>
												<DataGridTextColumn Header="Project"
                                                    Binding="{Binding ProjectName}"
                                                    Width="150"/>
												<DataGridTextColumn Header="Reference"
                                                    Binding="{Binding Reference}"
                                                    Width="120"/>
												<DataGridTextColumn Header="Balance After"
                                                    Binding="{Binding BalanceAfter}"
                                                    Width="110"/>
											</DataGrid.Columns>
										</DataGrid>
									</Expander>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

				</DockPanel>
			</TabItem>

			<!-- ===================================================== -->
			<!-- TAB 2 – EXECUTIVE ANALYTICS -->
			<!-- ===================================================== -->

			<TabItem Header="Executive Movement Analytics">

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="10">
						<!-- ============================= -->
						<!-- LEDGER INTEGRITY BANNER -->
						<!-- ============================= -->

						<Border Background="#4A0000"
        Padding="15"
        CornerRadius="6"
        Margin="0,0,0,15"
        Visibility="{Binding HasIntegrityFailure, Converter={StaticResource BoolToVisibilityConverter}}">

							<TextBlock Text="{Binding IntegrityMessage}"
               Foreground="White"
               FontSize="14"
               FontWeight="Bold"
               TextWrapping="Wrap"/>
						</Border>

						<!-- Export Button -->
						<Button Content="Export Executive PDF"
								Width="220"
								Height="36"
								Background="#1976D2"
								Foreground="White"
								FontWeight="Bold"
								BorderThickness="0"
								HorizontalAlignment="Right"
								Margin="0,0,0,15"
								Command="{Binding ExportExecutiveReportCommand}"/>

						<Border Background="{Binding ExecutiveRiskColor}"
								Padding="15"
								CornerRadius="6"
								Margin="0,0,0,15">

							<TextBlock Text="{Binding ExecutiveRiskLevel}"
               Foreground="White"
               FontSize="18"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>
						</Border>

						<Border Background="{Binding InventoryHealthColor}"
        Padding="15"
        CornerRadius="6"
        Margin="0,0,0,15">

							<StackPanel HorizontalAlignment="Center">
								<TextBlock Text="Inventory Health Score"
                   Foreground="White"
                   FontSize="14"
                   HorizontalAlignment="Center"/>

								<TextBlock Text="{Binding InventoryHealthScore}"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

								<TextBlock Text="{Binding InventoryHealthLabel}"
                   Foreground="White"
                   FontSize="14"
                   HorizontalAlignment="Center"/>
							</StackPanel>

						</Border>

						<!-- KPI CARDS -->
						<WrapPanel Margin="0,0,0,25">

							<Border Background="#F0F4F8" Padding="15" Margin="5" Width="240" CornerRadius="6">
								<StackPanel>
									<TextBlock Text="Top Moving Item (Value)" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding TopMovingItem}" FontSize="14" FontWeight="Bold"/>
									<TextBlock Text="{Binding TopMovingItemValue, StringFormat={}{0:N2}}"/>
								</StackPanel>
							</Border>

							<Border Background="#F0F4F8" Padding="15" Margin="5" Width="240" CornerRadius="6">
								<StackPanel>
									<TextBlock Text="Most Consumed Item" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding MostConsumedItem}" FontSize="14" FontWeight="Bold"/>
									<TextBlock Text="{Binding MostConsumedUnits}"/>
								</StackPanel>
							</Border>

							<Border Background="#F0F4F8" Padding="15" Margin="5" Width="240" CornerRadius="6">
								<StackPanel>
									<TextBlock Text="Highest Growth Item" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding HighestGrowthItem}" FontSize="14" FontWeight="Bold"/>
									<TextBlock Text="{Binding HighestGrowthUnits}"/>
								</StackPanel>
							</Border>

							<Border Background="#F0F4F8" Padding="15" Margin="5" Width="240" CornerRadius="6">
								<StackPanel>
									<TextBlock Text="Dead Stock Items" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding DeadStockCount}" FontSize="22" FontWeight="Bold"/>
								</StackPanel>
							</Border>

						</WrapPanel>


						<!-- ABC SECTION HEADER -->
						<TextBlock Text="ABC Portfolio Distribution – Capital Efficiency Overview"
           Style="{StaticResource ExecutiveSectionHeaderStyle}" />

						<TextBlock Text="Inventory classified by capital contribution and strategic impact."
           Foreground="Gray"
           Margin="0,0,0,15"/>


						<!-- STRATEGIC INTERPRETATION BLOCK -->
						<Border Background="{Binding InterpretationBackground}"
							Padding="18"
							CornerRadius="8"
							Margin="0,0,0,25">

							<StackPanel>
								<TextBlock Text="Executive Strategic Interpretation"
									FontWeight="Bold"
									FontSize="14"
									Margin="0,0,0,10"/>

								<TextBlock Text="{Binding StrategicInterpretation}"
									TextWrapping="Wrap"
									FontSize="13"
									LineHeight="22"/>
							</StackPanel>

						</Border>


					</StackPanel>

				</ScrollViewer>

			</TabItem>

			<TabItem Header="Stock Analytics">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="15">

						<!-- Pareto Section -->
						<StackPanel Margin="0,0,0,15">

							
							<GroupBox Header="Pareto Analysis (Value Concentration)" Margin="0,15,0,0">
								<Grid Height="350">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="201*"/>
										<ColumnDefinition Width="707*"/>
									</Grid.ColumnDefinitions>

									<ItemsControl ItemsSource="{Binding ParetoItems}" Grid.ColumnSpan="2">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Grid Margin="0,2">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="120"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="80"/>
													</Grid.ColumnDefinitions>

													<TextBlock Text="{Binding ItemCode}" VerticalAlignment="Center"/>

													<!-- Value Bar -->
													<Border Grid.Column="1"
                 Height="18"
                 Background="#1976D2"
                 Width="{Binding ParetoBarWidth}"
                 HorizontalAlignment="Left"/>

													<!-- Cumulative % -->
													<TextBlock Grid.Column="2"
                    Text="{Binding CumulativePercentage, StringFormat={}{0}%}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
							</GroupBox>

							<Grid Height="30">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="{Binding APercentage, StringFormat={}{0}*}" />
									<ColumnDefinition Width="{Binding BPercentage, StringFormat={}{0}*}" />
									<ColumnDefinition Width="{Binding CPercentage, StringFormat={}{0}*}" />
								</Grid.ColumnDefinitions>

								<!-- A -->
								<Border Grid.Column="0" Background="#2E7D32">
									<TextBlock Text="{Binding APercentage, StringFormat=A {0}%}"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontWeight="Bold"/>
								</Border>

								<!-- B -->
								<Border Grid.Column="1" Background="#EF6C00">
									<TextBlock Text="{Binding BPercentage, StringFormat=B {0}%}"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontWeight="Bold"/>
								</Border>

								<!-- C -->
								<Border Grid.Column="2" Background="#616161">
									<TextBlock Text="{Binding CPercentage, StringFormat=C {0}%}"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontWeight="Bold"/>
								</Border>

							</Grid>

						</StackPanel>

						<!-- ABC Distribution -->
						<TextBlock Text="Portfolio Distribution (ABC)"
FontWeight="Bold"
Margin="0,0,0,5"/>

						<!-- ITEM MOVEMENT GRID -->
						<TextBlock Text="Top Moving Inventory (By Value)"
            FontSize="16"
            FontWeight="Bold"
            Margin="0,0,0,10"/>
						

						<DataGrid ItemsSource="{Binding ItemMovementSummaries}"
           AutoGenerateColumns="False"
           IsReadOnly="True"
           Height="300"
           CanUserAddRows="False">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="120"/>
								<DataGridTextColumn Header="ABC" Binding="{Binding ABCClass}" Width="60"/>
								<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
								<DataGridTextColumn Header="Total In" Binding="{Binding TotalIn}" Width="90"/>
								<DataGridTextColumn Header="Total Out" Binding="{Binding TotalOut}" Width="90"/>
								<DataGridTextColumn Header="Net Movement" Binding="{Binding NetMovement}" Width="110"/>
								<DataGridTextColumn Header="Movement Value" Binding="{Binding MovementValue, StringFormat={}{0:N2}}" Width="130"/>
								<DataGridTextColumn Header="Current Balance" Binding="{Binding CurrentBalance}" Width="120"/>
								<DataGridTextColumn Header="Stock Value" Binding="{Binding CurrentStockValue, StringFormat={}{0:N2}}" Width="130"/>
								<DataGridTextColumn Header="Avg Inventory" Binding="{Binding AverageInventory}" Width="110"/>
								<DataGridTextColumn Header="Turnover" Binding="{Binding TurnoverRate}" Width="90"/>
								<DataGridTextColumn Header="Days in Stock" Binding="{Binding DaysInInventory}" Width="110"/>
								<DataGridTextColumn Header="Category" Binding="{Binding InventoryCategoryDisplay}" Width="140"/>
								<DataGridTextColumn Header="Velocity" Binding="{Binding InventoryCategory}" Width="110"/>
								<DataGridTextColumn Header="Demand Pattern" Binding="{Binding DemandPattern}" Width="140"/>
								<DataGridTextColumn Header="Variance Score" Binding="{Binding UsageVarianceScore, StringFormat={}{0:F2}}"/>
								<DataGridTextColumn Header="Health" Binding="{Binding HealthStatusDisplay}" Width="140"/>
								<DataGridTextColumn Header="Heat Zone" Binding="{Binding RiskHeatZone}" Width="120"/>
							</DataGrid.Columns>
						</DataGrid>

						<!-- MONTHLY TREND -->
						<GroupBox Header="Risk Heat Map (ABC × Risk)" Margin="0,15,0,15">

							<ItemsControl ItemsSource="{Binding RiskMatrix}"
                  HorizontalAlignment="Left">

								<!-- THIS is the important fix -->
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Rows="3"
                             Columns="3"
                             Width="360"
                             Height="360"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="{Binding BackgroundColor}"
                        Margin="6"
                        CornerRadius="6">
											<Grid>
												<StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
													<TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
													<TextBlock Text="{Binding ItemCount}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>

							</ItemsControl>

						</GroupBox>
						<TextBlock Text="Monthly Movement Trend"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,25,0,10"/>

						<DataGrid ItemsSource="{Binding MonthlySummaries}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Height="250"
          CanUserAddRows="False">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Month"
            Binding="{Binding Month, StringFormat={}{0:yyyy-MM}}"
            Width="120"/>
								<DataGridTextColumn Header="Total In" Binding="{Binding TotalIn}" Width="100"/>
								<DataGridTextColumn Header="Total Out" Binding="{Binding TotalOut}" Width="100"/>
								<DataGridTextColumn Header="Net Movement" Binding="{Binding NetMovement}" Width="120"/>
								<DataGridTextColumn Header="Value In" Binding="{Binding ValueIn, StringFormat={}{0:N2}}" Width="130"/>
								<DataGridTextColumn Header="Value Out" Binding="{Binding ValueOut, StringFormat={}{0:N2}}" Width="130"/>
								<DataGridTextColumn Header="Net Value" Binding="{Binding NetValue, StringFormat={}{0:N2}}" Width="130"/>
							</DataGrid.Columns>
						</DataGrid>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- ===================================================== -->
			<!-- TAB 3 – SMART REORDER PLANNER -->
			<!-- ===================================================== -->

			<TabItem Header="Smart Reorder Planner">

				<views:SmartReorderPlannerView/>

			</TabItem>

			<!-- ===================================================== -->
			<!-- TAB 4 – Audit Log -->
			<!-- ===================================================== -->

			<TabItem Header="Audit Log">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<!-- Filters -->
					<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
						<DatePicker SelectedDate="{Binding AuditVM.FromDate}" Width="140"/>
						<DatePicker SelectedDate="{Binding AuditVM.ToDate}" Width="140" Margin="5,0"/>
							<ComboBox Width="120"
								SelectedValue="{Binding AuditVM.SelectedSeverity}"
								SelectedValuePath="Content">
							<ComboBoxItem Content=""/>
							<ComboBoxItem Content="Info"/>
							<ComboBoxItem Content="Warning"/>
							<ComboBoxItem Content="Critical"/>
						</ComboBox>

						<Button Content="Apply"
                    Command="{Binding AuditVM.LoadCommand}"
                    Margin="5,0"/>
					</StackPanel>

					<!-- Grid -->
					<DataGrid Grid.Row="1"
                  ItemsSource="{Binding AuditVM.AuditEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Time"
                                    Binding="{Binding Timestamp}"
                                    Width="150"/>
							<DataGridTextColumn Header="Severity"
                                    Binding="{Binding Severity}"
                                    Width="90"/>
							<DataGridTextColumn Header="Action"
                                    Binding="{Binding ActionType}"
                                    Width="150"/>
							<DataGridTextColumn Header="User"
                                    Binding="{Binding Username}"
                                    Width="120"/>
							<DataGridTextColumn Header="Machine"
                                    Binding="{Binding MachineName}"
                                    Width="120"/>
							<DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</TabItem>

		</TabControl>

	</DockPanel>
</UserControl>