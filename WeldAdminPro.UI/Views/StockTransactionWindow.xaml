<Window x:Class="WeldAdminPro.UI.Views.StockTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

	<StackPanel Margin="20" Width="300">

		<TextBlock Text="Item"/>
		<TextBox Text="{Binding Item.ItemCode}"
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>

		<TextBlock Text="Quantity"/>
		<TextBox Text="{Binding QuantityText}"
                 Margin="0,0,0,10"/>

		<!-- Unit Cost (only visible for Stock IN) -->
		<TextBlock Text="Unit Cost (R)"
                   Visibility="{Binding IsStockIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>

		<TextBox Text="{Binding UnitCostText}"
                 Margin="0,0,0,10"
                 Visibility="{Binding IsStockIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>

		<TextBlock Text="Reference"/>
		<TextBox Text="{Binding Reference}"
                 Margin="0,0,0,15"/>

		<StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

			<Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Width="80"
                    Margin="0,0,10,0"/>

			<Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"/>
		</StackPanel>

	</StackPanel>
</Window>
