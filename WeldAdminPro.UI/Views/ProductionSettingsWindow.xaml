<Window x:Class="WeldAdminPro.UI.Views.ProductionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production Settings"
        Height="300"
        Width="300"
        WindowStartupLocation="CenterScreen">

	<StackPanel Margin="20">

		<TextBlock Text="Workers"/>
		<TextBox x:Name="WorkersBox"/>

		<TextBlock Text="Hours Per Day" Margin="0,10,0,0"/>
		<TextBox x:Name="HoursBox"/>

		<TextBlock Text="Overtime Hours" Margin="0,10,0,0"/>
		<TextBox x:Name="OvertimeBox"/>

		<TextBlock Text="Shifts" Margin="0,10,0,0"/>
		<TextBox x:Name="ShiftsBox"/>

		<Button Content="Save"
                Click="Save_Click"
                Margin="0,20,0,0"
                Height="30"/>

	</StackPanel>

</Window>