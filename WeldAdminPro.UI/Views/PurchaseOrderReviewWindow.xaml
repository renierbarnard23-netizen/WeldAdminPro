<Window x:Class="WeldAdminPro.UI.Views.PurchaseOrderReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Order Review"
        Width="1000"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PO Number -->
            <TextBlock Text="PO Number"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

            <TextBox Grid.Column="0"
                     Margin="5,0"
                     Text="{Binding PurchaseOrder.PONumber}"
                     IsReadOnly="True"/>

            <!-- Supplier -->
            <TextBlock Grid.Column="2"
                       Text="Supplier"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

            <TextBox Grid.Column="3"
                     Margin="5,0"
                     Text="{Binding PurchaseOrder.SupplierName}"/>

            <!-- Total -->
            <TextBlock Grid.Column="4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="16"
                       Text="{Binding TotalAmount, StringFormat=Total: R {0:N2}}"/>
        </Grid>

        <!-- ================= LINE ITEMS ================= -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="0,0,0,15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Code"
                                    Binding="{Binding ItemCode}"
                                    Width="120"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Unit Cost (R)"
                                    Binding="{Binding UnitCost, StringFormat=N2}"
                                    Width="120"/>

                <DataGridTextColumn Header="Line Total (R)"
                                    Binding="{Binding LineTotal, StringFormat=N2}"
                                    Width="140"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= ACTION BUTTONS ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Save PO"
                    Width="120"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"/>

            <Button Content="Cancel"
                    Width="120"
                    Command="{Binding CancelCommand}"/>

        </StackPanel>

    </Grid>
</Window>
