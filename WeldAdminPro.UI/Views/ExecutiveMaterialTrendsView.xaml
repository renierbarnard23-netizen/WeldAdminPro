<UserControl x:Class="WeldAdminPro.UI.Views.ExecutiveMaterialTrendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<Grid Margin="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<TextBlock Text="Material Consumption Trends"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

		<!-- Trend Grid -->
		<DataGrid Grid.Row="1"
                  ItemsSource="{Binding Materials}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Item Code"
                                    Binding="{Binding ItemCode}"
                                    Width="120"/>

				<DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

				<DataGridTextColumn Header="Last Month"
                                    Binding="{Binding LastMonthCost, StringFormat=N2}"
                                    Width="150"/>

				<DataGridTextColumn Header="This Month"
                                    Binding="{Binding ThisMonthCost, StringFormat=N2}"
                                    Width="150"/>

				<DataGridTextColumn Header="Change %"
                                    Binding="{Binding PercentChange, StringFormat=N2}"
                                    Width="120"/>

			</DataGrid.Columns>

		</DataGrid>

	</Grid>

</UserControl>