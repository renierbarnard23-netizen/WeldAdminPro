<UserControl x:Class="WeldAdminPro.UI.Views.WorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<Grid Margin="10">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="5">

            <Button x:Name="NewWorkOrderButton"
            Content="New Work Order"
            Width="120"
            Margin="5"
            Click="NewWorkOrder_Click"/>

            <Button x:Name="AddMaterialButton"
            Content="Add Material"
            Width="120"
            Margin="5"
            Click="AddMaterial_Click"/>

            <Button x:Name="IssueMaterialButton"
            Content="Issue Material"
            Width="120"
            Margin="5"
            Click="IssueMaterial_Click"/>

            <Button x:Name="EditWorkOrderButton"
            Content="Edit Work Order"
            Width="120"
            Margin="5"
            Click="EditWorkOrder_Click"/>

        </StackPanel>

        <!-- Work Orders Grid -->
		<DataGrid x:Name="WorkOrdersGrid"
          Grid.Row="1"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          Margin="0"
          RowHeight="28"
          HeadersVisibility="Column">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Project"
                            Binding="{Binding ProjectName}"
                            Width="180"/>

				<DataGridTextColumn Header="Work Order"
                            Binding="{Binding WorkOrderNumber}"
                            Width="140"/>

				<DataGridTextColumn Header="Description"
                            Binding="{Binding Description}"
                            Width="*"/>

				<DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="120"/>

				<DataGridTextColumn Header="Created"
                            Binding="{Binding CreatedOn, StringFormat=d}"
                            Width="120"/>

				<DataGridTextColumn Header="Start"
                            Binding="{Binding PlannedStartDate, StringFormat=d}"
                            Width="120"/>

				<DataGridTextColumn Header="Due"
                            Binding="{Binding DueDate, StringFormat=d}"
                            Width="120"/>

				<DataGridTextColumn Header="Completed"
                            Binding="{Binding CompletedOn, StringFormat=d}"
                            Width="120"/>

			</DataGrid.Columns>

		</DataGrid>

	</Grid>
</UserControl>