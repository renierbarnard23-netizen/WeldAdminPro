<UserControl x:Class="WeldAdminPro.UI.Views.Production.ProductionControlTowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <StackPanel Margin="20">

            <!-- HEADER -->

            <TextBlock Text="PRODUCTION CONTROL TOWER"
                       FontSize="30"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- SYSTEM STATUS -->

            <Border Padding="15"
                    CornerRadius="8"
                    Background="#2D2D30"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="System Status"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="{Binding SystemStatus}"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- KPI CARDS -->

            <UniformGrid Columns="3">

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Ready Orders"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding ReadyOrders}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Running Orders"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding RunningOrders}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Blocked Orders"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding BlockedOrders}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

            <!-- SECOND ROW -->

            <UniformGrid Columns="3">

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Deadline Risks"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding DeadlineRisks}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Material Shortages"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding MaterialShortages}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Capacity Load"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding CapacityLoad,
                                          StringFormat={}{0:N0}%}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

            <!-- THIRD ROW -->

            <UniformGrid Columns="3">

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Delayed Work Orders"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding DelayedWorkOrders}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Active Repairs"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding ActiveRepairs}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

                <Border Margin="5"
                        Padding="15"
                        Background="#F5F5F5">

                    <StackPanel>
                        <TextBlock Text="Bottlenecks"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding BottleneckCount}"
                                   FontSize="32"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

        </StackPanel>

    </ScrollViewer>

</UserControl>