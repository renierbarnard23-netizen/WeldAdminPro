<Window x:Class="WeldAdminPro.UI.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Details"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

	<Grid Margin="20">

		<!-- ROOT -->
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ================= HEADER ================= -->
		<Grid Grid.Row="0" Margin="0,0,0,20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock Text="Job Number"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

			<TextBox Grid.Column="1"
                     Margin="5,0"
                     Text="{Binding Project.JobNumber}"
                     IsReadOnly="True"
                     Background="#EEE"/>

			<TextBlock Grid.Column="2"
                       Text="Status"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

			<ComboBox Grid.Column="3"
                      Margin="5,0"
                      ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding Project.Status}"
                      IsEnabled="{Binding IsEditable}"/>

			<StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

				<Button Content="Save"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"/>

				<Button Content="Cancel"
                        Width="100"
                        Command="{Binding CancelCommand}"/>

			</StackPanel>
		</Grid>

		<!-- ================= MAIN CONTENT ================= -->
		<Grid Grid.Row="1">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.1*"/>
				<ColumnDefinition Width="1.4*"/>
			</Grid.ColumnDefinitions>

			<!-- ================= LEFT SIDE ================= -->
			<StackPanel Grid.Column="0" Margin="0,0,20,0">

				<GroupBox Header="Project Information">
					<Grid Margin="15">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="140"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
						</Grid.RowDefinitions>

						<TextBlock Text="Project Name"/>
						<TextBox Grid.Column="1" Margin="5"
                                 Text="{Binding Project.ProjectName}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="1" Text="Client"/>
						<TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                                 Text="{Binding Project.Client}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="2" Text="Client Rep"/>
						<TextBox Grid.Row="2" Grid.Column="1" Margin="5"
                                 Text="{Binding Project.ClientRepresentative}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="3" Text="Quote #"/>
						<TextBox Grid.Row="3" Grid.Column="1" Margin="5"
                                 Text="{Binding Project.QuoteNumber}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="4" Text="Order #"/>
						<TextBox Grid.Row="4" Grid.Column="1" Margin="5"
                                 Text="{Binding Project.OrderNumber}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="5" Text="Budget (R)"/>
						<TextBox Grid.Row="5" Grid.Column="1" Margin="5"
                                 Text="{Binding Project.Budget}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="6" Text="Material"/>
						<TextBox Grid.Row="6" Grid.Column="1" Margin="5"
                                 Text="{Binding Project.Material}"
                                 IsEnabled="{Binding IsEditable}"/>

					</Grid>
				</GroupBox>

				<GroupBox Header="Financial Summary" Margin="0,20,0,0">
					<StackPanel Margin="15">
						<TextBlock Text="{Binding Project.Budget, StringFormat=Budget: R {0:N2}}"/>
						<TextBlock Text="{Binding Project.ActualCost, StringFormat=Actual Cost: R {0:N2}}"/>
						<TextBlock Text="{Binding Project.CommittedCost, StringFormat=Committed: R {0:N2}}"/>
						<TextBlock Text="{Binding Variance, StringFormat=Variance: R {0:N2}}" FontWeight="Bold"/>
						<TextBlock Text="{Binding MarginPercentage, StringFormat=Margin: {0:N2}%}" FontWeight="Bold"/>
					</StackPanel>
				</GroupBox>

			</StackPanel>

			<!-- ================= RIGHT SIDE ================= -->
			<Grid Grid.Column="1">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- ================= TOP: ISSUE + RETURN ================= -->
				<Grid Grid.Row="0" Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>

					<!-- ================= ISSUE STOCK ================= -->
					<GroupBox Header="Issue Stock" Margin="0,0,15,0">
						<Grid Margin="15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="110"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
							</Grid.RowDefinitions>

							<TextBlock Text="Stock Item" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1"
                          Margin="5"
                          ItemsSource="{Binding StockItems}"
                          SelectedItem="{Binding SelectedStockItem}"
                          DisplayMemberPath="Description"/>

							<TextBlock Grid.Row="1" Text="Quantity" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding IssueQuantity}"/>

							<TextBlock Grid.Row="2" Text="Issued By" VerticalAlignment="Center"/>
							<TextBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding IssuedBy}"/>

							<!-- Available only -->
							<TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Margin="5,2"
                           Foreground="DarkGreen"
                           FontWeight="SemiBold"
                           Text="{Binding AvailableQuantity,
                                          StringFormat=Available: {0}}"/>

							<Button Grid.Row="4"
                        Grid.Column="1"
                        Content="Issue Stock"
                        HorizontalAlignment="Right"
                        Margin="5,10,5,0"
                        Command="{Binding IssueStockCommand}"
                        IsEnabled="{Binding CanIssueStock}"/>
						</Grid>
					</GroupBox>

					<!-- ================= RETURN STOCK ================= -->
					<GroupBox Header="Return Stock" Grid.Column="1">
						<Grid Margin="15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="110"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
							</Grid.RowDefinitions>

							<TextBlock Text="Issued Item" VerticalAlignment="Center"/>
							<ComboBox Grid.Column="1"
                          Margin="5"
                          ItemsSource="{Binding ReturnableIssuedItems}"
                          SelectedItem="{Binding SelectedIssuedUsage}"
                          DisplayMemberPath="Notes"/>

							<TextBlock Grid.Row="1" Text="Return Qty" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"
                         Text="{Binding ReturnQuantity}"/>

							<!-- Issued display ONLY here -->
							<TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="5,2"
                           Foreground="Gray"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedIssuedUsage.Quantity,
                                          StringFormat=Issued on Project: {0}}"/>

							<Button Grid.Row="3"
                        Grid.Column="1"
                        Content="Return Stock"
                        HorizontalAlignment="Right"
                        Margin="5,10,5,0"
                        Command="{Binding ReturnStockCommand}"
                        IsEnabled="{Binding CanReturnStock}"/>
						</Grid>
					</GroupBox>
				</Grid>

				<!-- ================= BOTTOM: SUMMARY + COST BREAKDOWN ================= -->
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1.6*"/>
					</Grid.ColumnDefinitions>

					<!-- STOCK SUMMARY -->
					<GroupBox Header="Project Stock Summary" Margin="0,0,15,0">
						<DockPanel Margin="15">
							<StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

								<Button Content="Export Totals"
                            Width="120"
                            Margin="0,0,10,0"
                            Command="{Binding ExportStockSummaryCommand}"/>

								<Button Content="Generate Smart PO"
                            Width="160"
                            Command="{Binding GenerateSmartPOCommand}"
                            IsEnabled="{Binding IsEditable}"/>
							</StackPanel>

							<DataGrid ItemsSource="{Binding ProjectStockSummary}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

								<DataGrid.Columns>
									<DataGridTextColumn Header="Code"
                                            Binding="{Binding ItemCode}"
                                            Width="90"/>
									<DataGridTextColumn Header="Item"
                                            Binding="{Binding Description}"
                                            Width="*"/>
									<DataGridTextColumn Header="Net Used"
                                            Binding="{Binding NetQuantity}"
                                            Width="80"/>
								</DataGrid.Columns>
							</DataGrid>
						</DockPanel>
					</GroupBox>

					<!-- COST BREAKDOWN -->
					<GroupBox Header="Project Cost Breakdown"
                  Grid.Column="1">

						<DataGrid ItemsSource="{Binding ProjectCostTransactions}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="15">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Date"
                        Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                        Width="150"/>
								<DataGridTextColumn Header="Item Code"
                        Binding="{Binding ItemCode}"
                        Width="90"/>
								<DataGridTextColumn Header="Description"
                        Binding="{Binding ItemDescription}"
                        Width="*"/>
								<DataGridTextColumn Header="Type"
                        Binding="{Binding Type}"
                        Width="60"/>
								<DataGridTextColumn Header="Qty"
                        Binding="{Binding Quantity}"
                        Width="60"/>
								<DataGridTextColumn Header="Unit Cost"
                        Binding="{Binding UnitCost, StringFormat={}{0:N2}}"
                        Width="90"/>
								<DataGridTextColumn Header="Line Total"
                        Binding="{Binding TransactionValue, StringFormat={}{0:N2}}"
                        Width="110"/>
							</DataGrid.Columns>
						</DataGrid>
					</GroupBox>

				</Grid>
			</Grid>


		</Grid>

	</Grid>
</Window>
