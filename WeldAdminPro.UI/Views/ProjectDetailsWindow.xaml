<Window x:Class="WeldAdminPro.UI.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Details"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

	<Grid Margin="20">

		<!-- ================= ROOT ROWS ================= -->
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ===================================================== -->
		<!-- ================= HEADER ================= -->
		<!-- ===================================================== -->
		<Grid Grid.Row="0" Margin="0,0,0,20">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="220"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock Text="Job Number"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

			<TextBox Grid.Column="1"
                     Margin="5,0"
                     Text="{Binding Project.JobNumber}"
                     IsReadOnly="True"
                     Background="#EEE"/>

			<TextBlock Grid.Column="2"
                       Text="Status"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

			<ComboBox Grid.Column="3"
                      Margin="5,0"
                      ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding Project.Status}"
                      IsEnabled="{Binding IsEditable}"/>

			<StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

				<Button Content="Save"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"/>

				<Button Content="Cancel"
                        Width="100"
                        Command="{Binding CancelCommand}"/>

			</StackPanel>
		</Grid>

		<!-- ===================================================== -->
		<!-- ================= MAIN CONTENT ================= -->
		<!-- ===================================================== -->
		<Grid Grid.Row="1">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*"/>
				<ColumnDefinition Width="1*"/>
			</Grid.ColumnDefinitions>

			<!-- ===================================================== -->
			<!-- ================= LEFT SIDE ================= -->
			<!-- ===================================================== -->

			<StackPanel Grid.Column="0" Margin="0,0,15,0">

				<!-- PROJECT INFO -->
				<GroupBox Header="Project Information">
					<Grid Margin="15">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="140"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
						</Grid.RowDefinitions>

						<TextBlock Text="Project Name" VerticalAlignment="Center"/>
						<TextBox Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.ProjectName}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="1" Text="Client" VerticalAlignment="Center"/>
						<TextBox Grid.Row="1" Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.Client}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="2" Text="Client Rep" VerticalAlignment="Center"/>
						<TextBox Grid.Row="2" Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.ClientRepresentative}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="3" Text="Quote #" VerticalAlignment="Center"/>
						<TextBox Grid.Row="3" Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.QuoteNumber}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="4" Text="Order #" VerticalAlignment="Center"/>
						<TextBox Grid.Row="4" Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.OrderNumber}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="5" Text="Budget (R)" VerticalAlignment="Center"/>
						<TextBox Grid.Row="5" Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.Budget}"
                                 IsEnabled="{Binding IsEditable}"/>

						<TextBlock Grid.Row="6" Text="Material" VerticalAlignment="Center"/>
						<TextBox Grid.Row="6" Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding Project.Material}"
                                 IsEnabled="{Binding IsEditable}"/>

					</Grid>
				</GroupBox>

				<!-- FINANCIAL SUMMARY -->
				<GroupBox Header="Financial Summary" Margin="0,15,0,0">
					<StackPanel Margin="15">
						<TextBlock Text="{Binding Project.Budget, StringFormat=Budget: R {0:N2}}"/>
						<TextBlock Text="{Binding Project.ActualCost, StringFormat=Actual Cost: R {0:N2}}"/>
						<TextBlock Text="{Binding Project.CommittedCost, StringFormat=Committed: R {0:N2}}"/>
						<TextBlock Text="{Binding Variance, StringFormat=Variance: R {0:N2}}"
                                   FontWeight="Bold"/>
						<TextBlock Text="{Binding MarginPercentage, StringFormat=Margin: {0:N2}%}"
                                   FontWeight="Bold"/>
					</StackPanel>
				</GroupBox>

			</StackPanel>

			<!-- ===================================================== -->
			<!-- ================= RIGHT SIDE ================= -->
			<!-- ===================================================== -->

			<Grid Grid.Column="1">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- ================= ISSUE STOCK ================= -->
				<GroupBox Header="Issue Stock" Margin="0,0,0,15">
					<Grid Margin="15">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="120"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
						</Grid.RowDefinitions>

						<TextBlock Text="Stock Item" VerticalAlignment="Center"/>
						<ComboBox Grid.Column="1"
                                  Margin="5"
                                  ItemsSource="{Binding StockItems}"
                                  SelectedItem="{Binding SelectedStockItem}"
                                  DisplayMemberPath="Description"/>

						<TextBlock Grid.Row="1"
                                   Text="Quantity"
                                   VerticalAlignment="Center"/>
						<TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding IssueQuantity}"/>

						<TextBlock Grid.Row="2"
                                   Text="Issued By"
                                   VerticalAlignment="Center"/>
						<TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding IssuedBy}"/>

						<TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="5,0"
                                   Foreground="Gray"
                                   Text="{Binding AvailableQuantity, StringFormat=Available: {0}}"/>

						<Button Grid.Row="4"
                                Grid.Column="1"
                                Content="Issue Stock"
                                Margin="5,10,5,0"
                                HorizontalAlignment="Right"
                                Command="{Binding IssueStockCommand}"
                                IsEnabled="{Binding CanIssueStock}"/>

					</Grid>
				</GroupBox>

				<!-- ================= RETURN STOCK ================= -->
				<GroupBox Header="Return Stock"
                          Grid.Row="1"
                          Margin="0,0,0,15">

					<Grid Margin="15">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="120"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition/>
							<RowDefinition/>
							<RowDefinition/>
						</Grid.RowDefinitions>

						<TextBlock Text="Issued Item"
                                   VerticalAlignment="Center"/>

						<ComboBox Grid.Column="1"
                                  Margin="5"
                                  ItemsSource="{Binding ReturnableIssuedItems}"
                                  SelectedItem="{Binding SelectedIssuedUsage}"
                                  DisplayMemberPath="Notes"/>

						<TextBlock Grid.Row="1"
                                   Text="Return Qty"
                                   VerticalAlignment="Center"/>

						<TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="5"
                                 Text="{Binding ReturnQuantity}"/>

						<Button Grid.Row="2"
                                Grid.Column="1"
                                Content="Return Stock"
                                Margin="5,10,5,0"
                                HorizontalAlignment="Right"
                                Command="{Binding ReturnStockCommand}"
                                IsEnabled="{Binding CanReturnStock}"/>

					</Grid>
				</GroupBox>

				<!-- ================= STOCK SUMMARY ================= -->
				<GroupBox Header="Project Stock Summary"
                          Grid.Row="2">

					<DockPanel Margin="15">

						<StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">

							<Button Content="Export Totals"
                                    Width="120"
                                    Margin="0,0,10,0"
                                    Command="{Binding ExportStockSummaryCommand}"/>

							<Button Content="Generate Smart PO"
                                    Width="160"
                                    Command="{Binding GenerateSmartPOCommand}"
                                    IsEnabled="{Binding IsEditable}"/>

						</StackPanel>

						<DataGrid ItemsSource="{Binding ProjectStockSummary}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Code"
                                                    Binding="{Binding ItemCode}"
                                                    Width="120"/>
								<DataGridTextColumn Header="Item"
                                                    Binding="{Binding Description}"
                                                    Width="*"/>
								<DataGridTextColumn Header="Net Used"
                                                    Binding="{Binding NetQuantity}"
                                                    Width="100"/>
							</DataGrid.Columns>

						</DataGrid>

					</DockPanel>

				</GroupBox>

			</Grid>

		</Grid>

	</Grid>
</Window>
