<Window x:Class="WeldAdminPro.UI.Views.AddWorkOrderMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Work Order Material"
        Height="250"
        Width="350">

	<StackPanel Margin="20">

		<TextBlock Text="Material"/>
		<ComboBox x:Name="MaterialBox"
                  Margin="0,5,0,10"
                  DisplayMemberPath="Description"/>

		<TextBlock Text="Required Quantity"/>
		<TextBox x:Name="QuantityBox"
                 Margin="0,5,0,10"/>

		<Button Content="Add Material"
                Height="30"
                Click="Add_Click"/>

	</StackPanel>

</Window>