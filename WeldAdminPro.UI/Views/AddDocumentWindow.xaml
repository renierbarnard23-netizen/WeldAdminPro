<Window x:Class="WeldAdminPro.UI.Views.AddDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add QA Document"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Document File"/>
        
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,5,0,10">

            <TextBox Width="320"
                     Text="{Binding FilePath}"
                     IsReadOnly="True"/>

            <Button Content="Browse"
                    Width="100"
                    Margin="10,0,0,0"
                    Command="{Binding BrowseCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Category"/>

        <ComboBox Grid.Row="3"
                  Margin="0,5,0,10"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"/>

        <TextBlock Grid.Row="4"
                   Text="Description"/>

		<TextBlock Text="Document Number"
				   Margin="0,10,0,5"/>

		<TextBox Text="{Binding DocumentNumber}"
				 Height="28"/>

		<TextBlock Text="Title"
				   Margin="0,10,0,5"/>

		<TextBox Text="{Binding Title}"
				 Height="28"/>


		<TextBox Grid.Row="5"
                 Margin="0,5,0,10"
                 Text="{Binding Description}"/>

        <StackPanel Grid.Row="6">

            <TextBlock Text="Revision"/>

            <TextBox Width="100"
                     Margin="0,5,0,10"
                     Text="{Binding Revision}"/>

            <CheckBox Content="Approved"
                      IsChecked="{Binding IsApproved}"/>

            <Button Content="Save Document"
                    Height="40"
                    Margin="0,20,0,0"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
