<UserControl x:Class="WeldAdminPro.UI.Views.Analytics.WelderAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <DataGrid ItemsSource="{Binding Welders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Welder"
                                    Binding="{Binding WelderNumber}"
                                    Width="120"/>

                <DataGridTextColumn Header="Total Welds"
                                    Binding="{Binding TotalWelds}"
                                    Width="120"/>

                <DataGridTextColumn Header="Rejected"
                                    Binding="{Binding RejectedWelds}"
                                    Width="120"/>

                <DataGridTextColumn Header="Repairs"
                                    Binding="{Binding RepairCount}"
                                    Width="120"/>

                <DataGridTextColumn Header="NCRs"
                                    Binding="{Binding NcrCount}"
                                    Width="120"/>

                <DataGridTextColumn Header="Reject %"
                                    Binding="{Binding RejectRate,
                                              StringFormat={}{0:F2}%}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>