<Window x:Class="WeldAdminPro.UI.Views.ProjectMaterialBreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Material Breakdown"
        Height="450"
        Width="650">

	<Grid Margin="15">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Material Breakdown"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

		<DataGrid Grid.Row="1"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Item Code"
                                    Binding="{Binding ItemCode}"
                                    Width="*" />

				<DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="2*" />

				<DataGridTextColumn Header="Quantity Used"
                                    Binding="{Binding QuantityUsed}"
                                    Width="*" />

				<DataGridTextColumn Header="Material Cost"
                                    Binding="{Binding MaterialCost, StringFormat=R {0:N2}}"
                                    Width="*" />

			</DataGrid.Columns>

		</DataGrid>

	</Grid>
</Window>