<UserControl x:Class="WeldAdminPro.UI.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<Grid Margin="12">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- KPI 0-->
				<RowDefinition Height="Auto"/>
				<!-- Production Control Tower 1-->
				<RowDefinition Height="Auto"/>
				<!-- Traffic Lights 2-->
				<RowDefinition Height="Auto"/>
				<!-- Production Control Center -->
				<RowDefinition Height="Auto"/>
				<!-- Production Readiness -->
				<RowDefinition Height="Auto"/>
				<!-- Production Block -->
				<RowDefinition Height="Auto"/>
				<!-- Production Status -->
				<RowDefinition Height="Auto"/>
				<!-- Production Queue -->
				<RowDefinition Height="Auto"/>
				<!-- Production Timeline -->
				<RowDefinition Height="Auto"/>
				<!-- Inventory -->
				<RowDefinition Height="Auto"/>
				<!-- Procurement -->
				<RowDefinition Height="Auto"/>
				<!-- Financial -->
				<RowDefinition Height="Auto"/>
				<!-- Planning -->
				<RowDefinition Height="Auto"/>
				<!-- Shortages -->
				<RowDefinition Height="Auto"/>
				<!-- Reservations -->
				<RowDefinition Height="Auto"/>
				<!-- Procurement Suggestions -->
				<RowDefinition Height="Auto"/>
				<!-- Capacity Forecast -->
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- KPI CARDS -->

			<ItemsControl ItemsSource="{Binding ExecutiveKpis}"
						  Grid.Row="0"
						  Grid.ColumnSpan="2"
						  Margin="6">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="4"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Border Background="#2D3E50"
								CornerRadius="8"
								Margin="6"
								Padding="18">

							<StackPanel>

								<TextBlock Text="{Binding Title}"
										   Foreground="White"
										   FontSize="14"
										   FontWeight="Bold"/>

								<TextBlock Text="{Binding Value}"
										   Foreground="White"
										   FontSize="28"
										   FontWeight="Bold"
										   Margin="0,8,0,0"/>

								<TextBlock Text="{Binding Description}"
										   Foreground="#D0D0D0"
										   FontSize="11"/>

							</StackPanel>

						</Border>

					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

			<!-- PRODUCTION CONTROL TOWER -->

			<GroupBox Header="Production Control Tower"
					  Grid.Row="1"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<Grid Margin="10">

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Ready Orders -->

					<Border Grid.Row="0" Grid.Column="0"
                Background="#2E7D32"
                CornerRadius="6"
                Padding="14"
                Margin="5">

						<StackPanel>
							<TextBlock Text="Ready Orders"
                           Foreground="White"
                           FontSize="13"/>

							<TextBlock Text="{Binding ProductionControlTower.ReadyOrders}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
						</StackPanel>

					</Border>

					<!-- Running -->

					<Border Grid.Row="0" Grid.Column="1"
                Background="#1565C0"
                CornerRadius="6"
                Padding="14"
                Margin="5">

						<StackPanel>
							<TextBlock Text="Running"
                           Foreground="White"
                           FontSize="13"/>

							<TextBlock Text="{Binding ProductionControlTower.RunningOrders}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
						</StackPanel>

					</Border>

					<!-- Completed -->

					<Border Grid.Row="0" Grid.Column="2"
                Background="#6A1B9A"
                CornerRadius="6"
                Padding="14"
                Margin="5">

						<StackPanel>
							<TextBlock Text="Completed"
                           Foreground="White"
                           FontSize="13"/>

							<TextBlock Text="{Binding ProductionControlTower.CompletedToday}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
						</StackPanel>

					</Border>

					<!-- Capacity -->

					<Border Grid.Row="1" Grid.Column="0"
                Background="#EF6C00"
                CornerRadius="6"
                Padding="14"
                Margin="5">

						<StackPanel>
							<TextBlock Text="Capacity Load"
                           Foreground="White"
                           FontSize="13"/>

							<TextBlock Text="{Binding ProductionControlTower.CapacityLoad}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>

							<TextBlock Text="%"
                           Foreground="White"/>
						</StackPanel>

					</Border>

					<!-- Deadline Risks -->

					<Border Grid.Row="1" Grid.Column="1"
                Background="#C62828"
                CornerRadius="6"
                Padding="14"
                Margin="5">

						<StackPanel>
							<TextBlock Text="Deadline Risks"
                           Foreground="White"
                           FontSize="13"/>

							<TextBlock Text="{Binding ProductionControlTower.DeadlineRisks}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
						</StackPanel>

					</Border>

					<!-- Blocked -->

					<Border Grid.Row="1" Grid.Column="2"
                Background="#455A64"
                CornerRadius="6"
                Padding="14"
                Margin="5">

						<StackPanel>
							<TextBlock Text="Blocked"
                           Foreground="White"
                           FontSize="13"/>

							<TextBlock Text="{Binding ProductionControlTower.BlockedOrders}"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
						</StackPanel>

					</Border>

				</Grid>

			</GroupBox>
			<GroupBox Header="Production Bottlenecks"
          Grid.Row="2"
          Grid.ColumnSpan="2"
          Margin="6">

				<DataGrid ItemsSource="{Binding ProductionBottlenecks}"
              AutoGenerateColumns="False"
              Height="160"
              Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Work Order"
                                Binding="{Binding WorkOrderNumber}"
                                Width="140"/>

						<DataGridTextColumn Header="Type"
                                Binding="{Binding BottleneckType}"
                                Width="160"/>

						<DataGridTextColumn Header="Description"
                                Binding="{Binding Description}"
                                Width="*"/>

						<DataGridTextColumn Header="Severity"
                                Binding="{Binding Severity}"
                                Width="120"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<GroupBox Header="Smart Production Recommendations"
          Grid.Row="3"
          Grid.ColumnSpan="2"
          Margin="6">

				<DataGrid ItemsSource="{Binding ProductionRecommendations}"
              AutoGenerateColumns="False"
              Height="160"
              RowHeight="32"
              Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Work Order"
                                Binding="{Binding WorkOrderNumber}"
                                Width="140"/>

						<DataGridTextColumn Header="Recommendation"
                                Binding="{Binding Recommendation}"
                                Width="220"/>

						<DataGridTextColumn Header="Reason"
                                Binding="{Binding Reason}"
                                Width="*"/>

						<DataGridTextColumn Header="Score"
                                Binding="{Binding Score}"
                                Width="80"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<GroupBox Header="Production Throughput Analytics"
					  Grid.Row="4"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<Grid Margin="10">

					<Grid.ColumnDefinitions>
						<ColumnDefinition/>
						<ColumnDefinition/>
						<ColumnDefinition/>
						<ColumnDefinition/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="Completed Today" FontWeight="Bold"/>
						<TextBlock Text="{Binding ProductionThroughput.CompletedToday}" FontSize="26"/>
					</StackPanel>

					<StackPanel Grid.Column="1">
						<TextBlock Text="Avg Duration (hrs)" FontWeight="Bold"/>
						<TextBlock Text="{Binding ProductionThroughput.AverageDurationHours}" FontSize="26"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Active Work Orders" FontWeight="Bold"/>
						<TextBlock Text="{Binding ProductionThroughput.ActiveWorkOrders}" FontSize="26"/>
					</StackPanel>

					<StackPanel Grid.Column="3">
						<TextBlock Text="Completion Rate %" FontWeight="Bold"/>
						<TextBlock Text="{Binding ProductionThroughput.CompletionRate}" FontSize="26"/>
					</StackPanel>

				</Grid>

			</GroupBox>

			<GroupBox Header="Production Efficiency Trends (Last 7 Days)"
          Grid.Row="5"
          Grid.ColumnSpan="2"
          Margin="6">

				<DataGrid ItemsSource="{Binding ProductionEfficiencyTrend}"
              AutoGenerateColumns="False"
              Height="180"
              RowHeight="32"
              Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Date"
                                Binding="{Binding Date}"
                                Width="160"/>

						<DataGridTextColumn Header="Completed Work Orders"
                                Binding="{Binding CompletedWorkOrders}"
                                Width="200"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<GroupBox Header="Production Execution"
					  Grid.Row="6"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<Grid Margin="10">

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>



					<!-- READY WORK ORDERS -->

					<GroupBox Header="Ready To Start"
							  Grid.Row="0"
							  Grid.Column="0"
							  Margin="5">

						<DataGrid ItemsSource="{Binding Execution.ReadyWorkOrders}"
                      AutoGenerateColumns="False"
                      Height="180">

							<DataGrid.Columns>

								<DataGridTextColumn Header="Work Order"
                        Binding="{Binding WorkOrderNumber}" Width="120"/>

								<DataGridTextColumn Header="Description"
                        Binding="{Binding Description}" Width="*"/>

								<DataGridTemplateColumn Header="Action" Width="120">

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<Button Content="Start"
                                        Command="{Binding DataContext.Execution.StartCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}" />

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

							</DataGrid.Columns>

						</DataGrid>

					</GroupBox>

					<!-- RUNNING WORK ORDERS -->

					<GroupBox Header="Running"
							  Grid.Row="0"
							  Grid.Column="1"
							  Margin="5">

						<DataGrid ItemsSource="{Binding Execution.RunningWorkOrders}"
                      AutoGenerateColumns="False"
                      Height="180">

							<DataGrid.Columns>

								<DataGridTextColumn Header="Work Order"
                        Binding="{Binding WorkOrderNumber}" Width="120"/>

								<DataGridTemplateColumn Header="Complete" Width="120">

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<Button Content="Complete"
                                        Command="{Binding DataContext.Execution.CompleteCommand,
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}" />

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

							</DataGrid.Columns>

						</DataGrid>

					</GroupBox>

				</Grid>

			</GroupBox>

			<!-- TRAFFIC LIGHTS -->

			<ItemsControl ItemsSource="{Binding ProductionTrafficLights}"
						  Grid.Row="7"
						  Grid.ColumnSpan="2"
						  Margin="6">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="4"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Border Background="{Binding Color}"
								CornerRadius="8"
								Margin="6"
								Padding="16">

							<StackPanel>

								<TextBlock Text="{Binding Title}"
										   Foreground="White"
										   FontWeight="Bold"
										   FontSize="14"/>

								<TextBlock Text="{Binding Value}"
										   Foreground="White"
										   FontSize="26"
										   FontWeight="Bold"
										   Margin="0,6,0,0"/>

							</StackPanel>

						</Border>

					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

			<!-- PRODUCTION READINESS -->

			<GroupBox Header="Production Readiness"
					  Grid.Row="9"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<StackPanel Margin="12">

					<TextBlock FontSize="28"
							   FontWeight="Bold"
							   Text="{Binding ProductionReadinessPercentage, StringFormat=Readiness: {0:F0}%}" Margin="0,0,0,8"/>

					<TextBlock Text="{Binding ReadyWorkOrders, StringFormat=Ready Work Orders: {0}}"/>
					<TextBlock Text="{Binding BlockedWorkOrders, StringFormat=Blocked Work Orders: {0}}"/>

				</StackPanel>

			</GroupBox>

			<!-- PRODUCTION BLOCK -->

			<GroupBox Header="Production Block Monitor"
					  Grid.Row="10"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding ProductionBlocks}"
						  AutoGenerateColumns="False"
						  Height="180"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Work Order"
Binding="{Binding WorkOrderNumber}"
Width="160"/>

						<DataGridTextColumn Header="Blocking Items"
Binding="{Binding BlockingItems}"
Width="*"/>

						<DataGridTextColumn Header="Total Shortage"
Binding="{Binding TotalShortage}"
Width="140"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- PRODUCTION STATUS -->

			<GroupBox Header="Production Status Board"
					  Grid.Row="11"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding WorkOrderStatuses}"
AutoGenerateColumns="False"
Height="200"
Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Work Order"
Binding="{Binding WorkOrderNumber}"
Width="160"/>

						<DataGridTemplateColumn Header="Status" Width="140">

							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>

									<Border CornerRadius="4"
Padding="4"
HorizontalAlignment="Left">

										<Border.Style>

											<Style TargetType="Border">

												<Setter Property="Background" Value="Gray"/>

												<Style.Triggers>

													<DataTrigger Binding="{Binding Status}" Value="Ready">
														<Setter Property="Background" Value="Green"/>
													</DataTrigger>

													<DataTrigger Binding="{Binding Status}" Value="Blocked">
														<Setter Property="Background" Value="Red"/>
													</DataTrigger>

													<DataTrigger Binding="{Binding Status}" Value="InProduction">
														<Setter Property="Background" Value="Orange"/>
													</DataTrigger>

													<DataTrigger Binding="{Binding Status}" Value="Completed">
														<Setter Property="Background" Value="SteelBlue"/>
													</DataTrigger>

												</Style.Triggers>

											</Style>

										</Border.Style>

										<TextBlock Text="{Binding Status}"
Foreground="White"
FontWeight="Bold"
Padding="4,2"/>

									</Border>

								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>

						</DataGridTemplateColumn>

						<DataGridTextColumn Header="Reason"
Binding="{Binding Reason}"
Width="*"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- PRODUCTION QUEUE -->

			<GroupBox Header="Production Scheduling Queue"
					  Grid.Row="12"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding Production.ProductionQueue}"
						  AutoGenerateColumns="False"
						  AllowDrop="True"
						  PreviewMouseLeftButtonDown="Queue_MouseDown"
						  Drop="Queue_Drop"
						  Height="220"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/>

						<DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrderNumber}" Width="160"/>

						<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>

						<DataGridTextColumn Header="Start" Binding="{Binding StartDate}" Width="140"/>

						<DataGridTextColumn Header="Due" Binding="{Binding DueDate}" Width="140"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- PRODUCTION TIMELINE -->

			<GroupBox Header="Production Timeline"
					  Grid.Row="13"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<ScrollViewer HorizontalScrollBarVisibility="Auto">

					<ItemsControl ItemsSource="{Binding ProductionTimeline}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Grid Height="40" Margin="4">

									<TextBlock Text="{Binding WorkOrderNumber}"
											   VerticalAlignment="Center" 
											   Width="120"/>

									<Canvas Margin="130,0,0,0">

										<Rectangle Height="20"
												   Width="{Binding Duration}"
												   Canvas.Left="{Binding StartOffset}"
												   RadiusX="4"
												   RadiusY="4"
												   Fill="SteelBlue"/>

									</Canvas>

								</Grid>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</ScrollViewer>

			</GroupBox>

			<!-- INVENTORY -->

			<GroupBox Header="Inventory Health"
					  Grid.Row="14"
					  Grid.Column="0"
					  Margin="6">

				<StackPanel Margin="10">

					<TextBlock FontWeight="Bold" Text="{Binding InventoryRiskLevel, StringFormat=Risk Level: {0}}"/>

					<TextBlock Text="{Binding InventoryHealthScore, StringFormat=Health Score: {0}%}"/>
					<TextBlock Text="{Binding NegativeStockItems, StringFormat=Negative Stock: {0}}"/>
					<TextBlock Text="{Binding DeadStockItems, StringFormat=Dead Stock: {0}}"/>
					<TextBlock Text="{Binding ConsumptionSpikes, StringFormat=Consumption Spikes: {0}}"/>
					<TextBlock Text="{Binding CriticalInventoryItems, StringFormat=Critical Items: {0}}"/>

				</StackPanel>

			</GroupBox>

			<GroupBox Header="Operational Alerts"
					  Grid.Row="14"
					  Grid.Column="1"
					  Margin="6">

				<DataGrid ItemsSource="{Binding OperationalAlerts}"
						  AutoGenerateColumns="False"
						  Height="220"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="120"/>

						<DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- PROCUREMENT -->

			<GroupBox Header="Procurement Alerts"
					  Grid.Row="15"
					  Grid.Column="0"
					  Margin="6">

				<DataGrid ItemsSource="{Binding ProcurementAlerts}"
						  AutoGenerateColumns="False"
						  MinHeight="240"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>

						<DataGridTextColumn Header="Days Remaining" Binding="{Binding DaysRemaining}" Width="120"/>

						<DataGridTextColumn Header="Priority" Binding="{Binding PriorityScore}" Width="100"/>

						<DataGridTextColumn Header="Suggested Order" Binding="{Binding SuggestedOrderQuantity}" Width="140"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<GroupBox Header="Top Consumed Materials"
					  Grid.Row="15"
					  Grid.Column="1"
					  Margin="6">

				<DataGrid ItemsSource="{Binding TopConsumedMaterials}"
						  AutoGenerateColumns="False"
						  MinHeight="240"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>

						<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

						<DataGridTextColumn Header="Total Used" Binding="{Binding TotalConsumed}" Width="120"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- FINANCIAL -->

			<GroupBox Header="Project Material Cost Intelligence"
					  Grid.Row="16"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding ProjectProfitability}"
						  AutoGenerateColumns="False"
						  MinHeight="240"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*"/>

						<DataGridTextColumn Header="Revenue" Binding="{Binding Revenue}" Width="120"/>

						<DataGridTextColumn Header="Material Cost" Binding="{Binding MaterialCost}" Width="140"/>

						<DataGridTextColumn Header="Profit" Binding="{Binding Profit}" Width="120"/>

						<DataGridTextColumn Header="Margin %" Binding="{Binding Margin}" Width="100"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- WORK ORDER MATERIAL PLANNING -->

			<GroupBox Header="Work Order Material Planning"
					  Grid.Row="17"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding WorkOrderMaterialPlans}"
						  AutoGenerateColumns="False"
						  MinHeight="240"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrderNumber}" Width="120"/>

						<DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>

						<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

						<DataGridTextColumn Header="Required" Binding="{Binding RequiredQuantity}" Width="100"/>

						<DataGridTextColumn Header="In Stock" Binding="{Binding StockAvailable}" Width="100"/>

						<DataGridTextColumn Header="Shortage" Binding="{Binding Shortage}" Width="100"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>



			<!-- RESERVATIONS -->

			<GroupBox Header="Material Reservations"
					  Grid.Row="18"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding MaterialReservations}"
						  AutoGenerateColumns="False"
						  MinHeight="220"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrderNumber}" Width="120"/>

						<DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>

						<DataGridTextColumn Header="Required" Binding="{Binding RequiredQuantity}" Width="100"/>

						<DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity}" Width="100"/>

						<DataGridTextColumn Header="Available After" Binding="{Binding AvailableStock}" Width="120"/>

						<DataGridTextColumn Header="Status" Binding="{Binding Reason}" Width="*"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- PROCUREMENT SUGGESTIONS -->

			<GroupBox Header="Smart Procurement Suggestions"
					  Grid.Row="19"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding ProcurementSuggestions}"
						  AutoGenerateColumns="False"
						  Height="220"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>

						<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>

						<DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock}" Width="120"/>

						<DataGridTextColumn Header="Required" Binding="{Binding RequiredQuantity}" Width="120"/>

						<DataGridTextColumn Header="Suggested Order" Binding="{Binding SuggestedOrderQuantity}" Width="150"/>

						<DataGridTextColumn Header="Priority" Binding="{Binding PriorityScore}" Width="100"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<!-- PRODUCTION CAPACITY FORECAST -->

			<GroupBox Header="Production Capacity Forecast (Next 14 Days)"
					  Grid.Row="20"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<DataGrid ItemsSource="{Binding Production.CapacityForecast}"
						  AutoGenerateColumns="False"
						  Height="220"
						  Margin="6">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="160"/>

						<DataGridTextColumn Header="Capacity (hrs)" Binding="{Binding CapacityHours}" Width="140"/>

						<DataGridTextColumn Header="Scheduled (hrs)" Binding="{Binding ScheduledHours}" Width="140"/>

						<DataGridTemplateColumn Header="Load %" Width="120">

							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>

									<Border Padding="4"
										    CornerRadius="4">

										<Border.Style>

											<Style TargetType="Border">

												<Setter Property="Background" Value="LightGreen"/>

												<Style.Triggers>

													<!-- Near capacity -->

													<DataTrigger Binding="{Binding LoadPercentage}" Value="80">
														<Setter Property="Background" Value="Orange"/>
													</DataTrigger>

													<!-- Over capacity -->

													<DataTrigger Binding="{Binding IsOverloaded}" Value="True">
														<Setter Property="Background" Value="Red"/>
													</DataTrigger>

												</Style.Triggers>

											</Style>

										</Border.Style>

										<TextBlock Text="{Binding LoadPercentage, StringFormat={}{0:F0}%}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

									</Border>

								</DataTemplate>

							</DataGridTemplateColumn.CellTemplate>

						</DataGridTemplateColumn>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

			<GroupBox Header="Production Control Center"
					  Grid.Row="8"
					  Grid.ColumnSpan="2"
					  Margin="6">

				<Grid Margin="10">

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Capacity Forecast -->

					<GroupBox Header="Capacity Forecast" Grid.Row="0" Grid.Column="0">
						<DataGrid ItemsSource="{Binding CapacityForecast}"
                      AutoGenerateColumns="False"
                      Height="160">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Date"
                                        Binding="{Binding Date}" Width="100"/>
								<DataGridTextColumn Header="Capacity"
                                        Binding="{Binding CapacityHours}" Width="80"/>
								<DataGridTextColumn Header="Scheduled"
                                        Binding="{Binding ScheduledHours}" Width="90"/>
								<DataGridTextColumn Header="Load %"
                                        Binding="{Binding LoadPercentage}" Width="80"/>
							</DataGrid.Columns>

						</DataGrid>
					</GroupBox>

					<!-- Deadline Risks -->

					<GroupBox Header="Deadline Risks" Grid.Row="0" Grid.Column="1">
						<DataGrid ItemsSource="{Binding Production.DeadlineRisks}"
                      AutoGenerateColumns="False"
                      Height="160">

							<DataGrid.Columns>
								<DataGridTextColumn Header="Work Order"
                                        Binding="{Binding WorkOrderNumber}" Width="100"/>
								<DataGridTextColumn Header="Due"
                                        Binding="{Binding DueDate}" Width="100"/>
								<DataGridTextColumn Header="Shortage"
                                        Binding="{Binding HoursShortage}" Width="80"/>
								<DataGridTextColumn Header="Risk"
                                        Binding="{Binding RiskLevel}" Width="80"/>
							</DataGrid.Columns>

						</DataGrid>
					</GroupBox>

					<!-- SHORTAGES -->

					<GroupBox Header="Material Shortages" Grid.Row="1" Grid.Column="0">

						<DataGrid ItemsSource="{Binding MaterialShortages}"
  AutoGenerateColumns="False"
  MinHeight="160">

							<DataGrid.Columns>

								<DataGridTextColumn Header="Work Order"
                    Binding="{Binding WorkOrderNumber}"
                    Width="120"/>

								<DataGridTextColumn Header="Item"
                    Binding="{Binding ItemCode}"
                    Width="120"/>

								<DataGridTextColumn Header="Required"
                    Binding="{Binding RequiredQuantity}"
                    Width="100"/>

								<DataGridTextColumn Header="Available"
                    Binding="{Binding AvailableQuantity}"
                    Width="100"/>

								<DataGridTextColumn Header="Shortage"
                    Binding="{Binding ShortageQuantity}"
                    Width="100"/>

							</DataGrid.Columns>

						</DataGrid>

					</GroupBox>

					<!-- Production Queue -->

					<GroupBox Header="Production Queue" 
							  Grid.Row="7" 
							  Grid.Column="1">
						<DataGrid ItemsSource="{Binding ProductionQueue}"
AutoGenerateColumns="False"
MinHeight="160">

							<DataGrid.Columns>

								<DataGridTextColumn Header="Priority"
                            Binding="{Binding Priority}"
                            Width="80"/>

								<DataGridTextColumn Header="Work Order"
                            Binding="{Binding WorkOrderNumber}"
                            Width="120"/>

								<DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="100"/>

								<DataGridTemplateColumn Header="Actions" Width="220">

									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>

											<StackPanel Orientation="Horizontal">

												<Button Content="Start"
                        Margin="2"
                        Padding="6,2"
                        Command="{Binding DataContext.StartWorkOrderCommand,
                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"/>

												<Button Content="Pause"
                        Margin="2"
                        Padding="6,2"
                        Command="{Binding DataContext.PauseWorkOrderCommand,
                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"/>

												<Button Content="Complete"
                        Margin="2"
                        Padding="6,2"
                        Command="{Binding DataContext.CompleteWorkOrderCommand,
                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding Id}"/>

											</StackPanel>

										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

							</DataGrid.Columns>

						</DataGrid>
					</GroupBox>

				</Grid>

			</GroupBox>

		</Grid>

	</ScrollViewer>
</UserControl>