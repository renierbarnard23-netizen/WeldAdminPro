<Window x:Class="WeldAdminPro.UI.Views.IssueMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Issue Material"
        Height="340"
        Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Work Order -->
		<TextBlock Text="Work Order" FontWeight="SemiBold"/>

		<ComboBox x:Name="WorkOrderBox"
                  Grid.Row="1"
                  Margin="0,5,0,15"
                  DisplayMemberPath="WorkOrderNumber"/>

		<!-- Material -->
		<TextBlock Text="Material"
                   Grid.Row="2"
                   FontWeight="SemiBold"/>

		<ComboBox x:Name="MaterialBox"
                  Grid.Row="3"
                  Margin="0,5,0,15"
                  DisplayMemberPath="Description"
                  SelectionChanged="MaterialBox_SelectionChanged"/>

		<!-- Available Stock -->
		<TextBlock Text="Available Stock"
                   Grid.Row="4"
                   FontWeight="SemiBold"/>

		<TextBlock x:Name="StockAvailableText"
                   Grid.Row="5"
                   Margin="0,5,0,15"
                   FontSize="14"
                   FontWeight="Bold"/>

		<!-- Quantity -->
		<TextBlock Text="Quantity"
                   Grid.Row="6"
                   FontWeight="SemiBold"/>

		<TextBox x:Name="QuantityBox"
         Grid.Row="7"
         Margin="0,5,0,20"
         Height="28"
         PreviewTextInput="QuantityBox_PreviewTextInput"/>

		<!-- Buttons -->
		<StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

			<Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Cancel_Click" Height="24"/>

			<Button Content="Issue"
                    Width="90"
                    Click="Issue_Click" Height="23"/>

		</StackPanel>

	</Grid>

</Window>