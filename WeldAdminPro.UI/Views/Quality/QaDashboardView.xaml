<UserControl x:Class="WeldAdminPro.UI.Views.Quality.QaDashboardView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">

<ScrollViewer VerticalScrollBarVisibility="Auto">

    <StackPanel Margin="20">

        <TextBlock Text="QA CONTROL DASHBOARD"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Button Content="Export Turnover Package"
                    Width="250"
                    Height="40"
                    Margin="0,0,0,20"
                    Command="{Binding ExportTurnoverPackageCommand}"/>


        <UniformGrid Columns="3">

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Total Welds"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.TotalWelds}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Accepted Welds"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.AcceptedWelds}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Closed Welds"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.ClosedWelds}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="Orange"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Welds Under Repair"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.WeldsUnderRepair}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="DarkOrange"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Pending Reinspection"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.PendingReinspection}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="Red"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Open Repairs"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.OpenRepairs}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="Green"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Completed Repairs"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.CompletedRepairs}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="DarkRed"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Rejected Repairs"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.RejectedRepairs}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
                    Padding="15"
                    BorderBrush="SteelBlue"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Repair Rate (%)"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Metrics.RepairRate}"
                               FontSize="24"/>
                </StackPanel>
            </Border>

            <Border Margin="5"
     Padding="15"
     BorderBrush="DarkGreen"
     BorderThickness="2"
     CornerRadius="5"> <StackPanel> <TextBlock Text="Turnover Ready"
                FontWeight="Bold"/> <TextBlock Text="{Binding Metrics.TurnoverReady}"
                FontSize="24"/> </StackPanel> </Border>

<Border Margin="5"
     Padding="15"
     BorderBrush="DarkRed"
     BorderThickness="2"
     CornerRadius="5"> <StackPanel> <TextBlock Text="Blocking Issues"
                FontWeight="Bold"/> <TextBlock Text="{Binding Metrics.BlockingIssues}"
                FontSize="24"/> </StackPanel> </Border>


        </UniformGrid>

        <TextBlock Text="Workflow Distribution"
        FontSize="22"
        FontWeight="Bold"
        Margin="0,30,0,10"/>

<DataGrid ItemsSource="{Binding WorkflowDistribution}"
       AutoGenerateColumns="False"
       Height="300">

<DataGrid.Columns>

    <DataGridTextColumn Header="Workflow Status"
                        Binding="{Binding Status}"
                        Width="*"/>

    <DataGridTextColumn Header="Count"
                        Binding="{Binding Count}"
                        Width="150"/>

</DataGrid.Columns>

</DataGrid>

		<TextBlock Text="Repair Aging / Bottlenecks"
        FontSize="22"
        FontWeight="Bold"
        Margin="0,30,0,10"/>

		<DataGrid ItemsSource="{Binding RepairAging}"
			   AutoGenerateColumns="False"
			   Height="300">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Repair #"
									Binding="{Binding RepairNumber}"
									Width="120"/>

				<DataGridTextColumn Header="Status"
									Binding="{Binding Status}"
									Width="200"/>

				<DataGridTextColumn Header="Age (Days)"
									Binding="{Binding AgeDays}"
									Width="150"/>

				<DataGridCheckBoxColumn Header="Overdue"
										Binding="{Binding IsOverdue}"
										Width="120"/>

			</DataGrid.Columns>

		</DataGrid>



	</StackPanel>

</ScrollViewer>

</UserControl>