<UserControl x:Class="WeldAdminPro.UI.Views.Quality.RepairManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <!-- KPI -->
            <RowDefinition Height="Auto"/>

            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>

            <!-- Repairs -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- KPI CARDS -->
        <WrapPanel Grid.Row="0"
           Margin="0,0,0,10">

            <!-- TOTAL -->
            <Border Background="#1E293B"
            Width="220"
            Height="90"
            Margin="0,0,10,0"
            CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Total Repairs"
                       Foreground="White"
                       FontSize="14"/>

                    <TextBlock Text="{Binding TotalRepairs}"
                       Foreground="#4FC3F7"
                       FontSize="28"
                       FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- OPEN -->
            <Border Background="#7F1D1D"
            Width="220"
            Height="90"
            Margin="0,0,10,0"
            CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Open Repairs"
                       Foreground="White"
                       FontSize="14"/>

                    <TextBlock Text="{Binding OpenRepairs}"
                       Foreground="#FCA5A5"
                       FontSize="28"
                       FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- AVG CLOSURE -->
            <Border Background="#0F766E"
            Width="220"
            Height="90"
            Margin="0,0,10,0"
            CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Avg Closure Days"
                       Foreground="White"
                       FontSize="14"/>

                    <TextBlock Text="{Binding Analytics.AverageClosureDays}"
                       Foreground="#99F6E4"
                       FontSize="28"
                       FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- WORST WELDER -->
            <Border Background="#7C2D12"
            Width="220"
            Height="90"
            Margin="0,0,10,0"
            CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Worst Welder"
                       Foreground="White"
                       FontSize="14"/>

                    <TextBlock Text="{Binding Analytics.WorstWelder}"
                       Foreground="#FDBA74"
                       FontSize="20"
                       FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </WrapPanel>

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Refresh"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Command="{Binding RefreshCommand}"/>

            <Button Content="Close Repair"
                    Width="140"
                    Height="30"
                    Command="{Binding CloseRepairCommand}"/>

        </StackPanel>

        <!-- GRID -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Repairs}"
                  SelectedItem="{Binding SelectedRepair}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Weld"
                                    Binding="{Binding WeldNumber}"
                                    Width="120"/>

                <DataGridTextColumn Header="Repair #"
                                    Binding="{Binding RepairNumber}"
                                    Width="100"/>

                <DataGridTextColumn Header="Reason"
                                    Binding="{Binding Reason}"
                                    Width="300"/>

                <DataGridTextColumn Header="Requested"
                                    Binding="{Binding RequestedDate}"
                                    Width="180"/>

                <DataGridTextColumn Header="Completed"
                                    Binding="{Binding CompletedDate}"
                                    Width="180"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="140"/>

                <DataGridTextColumn Header="Repair WPS"
                                    Binding="{Binding RepairWpsNumber}"
                                    Width="180"/>

                <DataGridTextColumn Header="Repair Welder"
                                    Binding="{Binding RepairedByWelder}"
                                    Width="180"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>