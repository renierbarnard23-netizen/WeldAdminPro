<UserControl x:Class="WeldAdminPro.UI.Views.Quality.HoldPointPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="WELD HOLD POINTS"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

		<DataGrid Grid.Row="1"
          ItemsSource="{Binding HoldPoints}"
          SelectedItem="{Binding SelectedHoldPoint,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="False"
          Height="220"
          Margin="0,10,0,10">

			<DataGrid.RowStyle>

				<Style TargetType="DataGridRow">

					<Setter Property="Background"
							Value="White"/>

					<Style.Triggers>

						<DataTrigger Binding="{Binding Status}"
									 Value="Pending">

							<Setter Property="Background"
									Value="Khaki"/>

						</DataTrigger>

						<DataTrigger Binding="{Binding Status}"
									 Value="Approved">

							<Setter Property="Background"
									Value="LightGreen"/>

						</DataTrigger>

						<DataTrigger Binding="{Binding Status}"
									 Value="Rejected">

							<Setter Property="Background"
									Value="IndianRed"/>

						</DataTrigger>

					</Style.Triggers>

				</Style>

			</DataGrid.RowStyle>

			<DataGrid.Columns>

				<DataGridTextColumn Header="Hold Point"
									Binding="{Binding HoldPointType}"
									Width="*"
									MinWidth="200"/>

				<DataGridTextColumn Header="Status"
									Binding="{Binding Status}"
									Width="*"
									MinWidth="200"/>

				<DataGridCheckBoxColumn Header="Mandatory"
										Binding="{Binding IsMandatory}"
										Width="*"
										MinWidth="100"/>

				<DataGridTextColumn Header="Approved By"
									Binding="{Binding ApprovedBy}"
									Width="*"
									MinWidth="150"/>

				<DataGridTextColumn Header="Approved Date"
									Binding="{Binding ApprovedDate}"
									Width="*"
									MinWidth="180"/>

				<DataGridTextColumn Header="Comments"
									Binding="{Binding Comments}"
									Width="*"
									MinWidth="150"/>

			</DataGrid.Columns>

		</DataGrid>

		<StackPanel Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,10,0,0">

			<Button Content="Add Hold Point"
					Width="140"
					Margin="0,0,10,0"
					Command="{Binding AddHoldPointCommand}"/>

			<Button Content="Remove"
					Width="100"
					Margin="0,0,20,0"
					Command="{Binding RemoveHoldPointCommand}"/>

			<Button Content="Approve"
					Width="120"
					Margin="0,0,10,0"
					Command="{Binding ApproveCommand}"/>

			<Button Content="Reject"
					Width="120"
					Command="{Binding RejectCommand}"/>

		</StackPanel>

    </Grid>
</UserControl>