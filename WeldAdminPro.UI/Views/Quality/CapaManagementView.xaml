<UserControl x:Class="WeldAdminPro.UI.Views.Quality.CapaManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Capas}"
                  SelectedItem="{Binding SelectedCapa}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Root Cause"
                                    Binding="{Binding RootCauseAnalysis}"
                                    Width="220"/>

                <DataGridTextColumn Header="Corrective Action"
                                    Binding="{Binding CorrectiveAction}"
                                    Width="220"/>

                <DataGridTextColumn Header="Preventive Action"
                                    Binding="{Binding PreventiveAction}"
                                    Width="220"/>

                <DataGridTextColumn Header="Assigned To"
                                    Binding="{Binding AssignedTo}"
                                    Width="140"/>

                <DataGridCheckBoxColumn Header="Verified"
                                        Binding="{Binding IsVerified}"
                                        Width="90"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <Button Content="Verify CAPA"
                    Width="140"
                    Command="{Binding VerifyCapaCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>