<Window x:Class="WeldAdminPro.UI.Views.Quality.LinkPqrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select PQR"
        Height="400"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="PqrListBox"
                 DisplayMemberPath="PqrNumber"/>

        <Button Grid.Row="1"
                Content="Link Selected"
                Height="35"
                Margin="0,10,0,0"
                Click="OnLink"/>
    </Grid>
</Window>