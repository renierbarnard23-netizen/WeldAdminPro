<UserControl x:Class="WeldAdminPro.UI.Views.Quality.NcrDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <!-- KPI -->
            <RowDefinition Height="Auto"/>

            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>

            <!-- NCR Grid -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- KPI CARDS -->
        <WrapPanel Grid.Row="0"
                   Margin="0,0,0,10">

            <!-- OPEN NCR -->
            <Border Background="#7F1D1D"
                    Width="220"
                    Height="90"
                    Margin="0,0,10,0"
                    CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Open NCRs"
                               Foreground="White"
                               FontSize="14"/>

                    <TextBlock Text="{Binding OpenNcrs}"
                               Foreground="#FCA5A5"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- CLOSED -->
            <Border Background="#14532D"
                    Width="220"
                    Height="90"
                    Margin="0,0,10,0"
                    CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Closed NCRs"
                               Foreground="White"
                               FontSize="14"/>

                    <TextBlock Text="{Binding ClosedNcrs}"
                               Foreground="#86EFAC"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- OVERDUE -->
            <Border Background="#991B1B"
                    Width="220"
                    Height="90"
                    Margin="0,0,10,0"
                    CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Overdue NCRs"
                               Foreground="White"
                               FontSize="14"/>

                    <TextBlock Text="{Binding OverdueNcrs}"
                               Foreground="#FECACA"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </WrapPanel>

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Refresh"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Command="{Binding RefreshCommand}"/>

            <Button Content="Close NCR"
                    Width="140"
                    Height="30"
                    Command="{Binding CloseNcrCommand}"/>

        </StackPanel>

        <!-- GRID -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Ncrs}"
                  SelectedItem="{Binding SelectedNcr}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="NCR"
                                    Binding="{Binding NcrNumber}"
                                    Width="150"/>

                <DataGridTextColumn Header="Weld"
                                    Binding="{Binding WeldNumber}"
                                    Width="120"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="300"/>

                <DataGridTextColumn Header="Root Cause"
                                    Binding="{Binding RootCause}"
                                    Width="250"/>

                <DataGridTextColumn Header="Corrective Action"
                                    Binding="{Binding CorrectiveAction}"
                                    Width="250"/>

                <DataGridTextColumn Header="Assigned To"
                                    Binding="{Binding AssignedTo}"
                                    Width="180"/>

                <DataGridTextColumn Header="Raised"
                                    Binding="{Binding RaisedDate}"
                                    Width="180"/>

                <DataGridTextColumn Header="Due Date"
                                    Binding="{Binding DueDate}"
                                    Width="180"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="140"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>