<Window x:Class="WeldAdminPro.UI.Views.Quality.WpsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPS Editor" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">

	<ScrollViewer>
		<StackPanel Margin="15">

			<!-- GENERAL -->
			<TextBlock Text="General" FontWeight="Bold"/>
			<TextBox Text="{Binding WpsNumber}" Margin="0,5" />
			<TextBox Text="{Binding Process}" Margin="0,5"/>

			<!-- MATERIAL -->
			<TextBlock Text="Material" FontWeight="Bold" Margin="0,10,0,0"/>
			<TextBox Text="{Binding MaterialGroup}" Margin="0,5"/>
			<TextBox Text="{Binding PNumber}" Margin="0,5"/>

			<!-- THICKNESS -->
			<TextBlock Text="Thickness (mm)" FontWeight="Bold" Margin="0,10,0,0"/>
			<StackPanel Orientation="Horizontal">
				<TextBox Width="100" Text="{Binding ThicknessMin}" Margin="0,5"/>
				<TextBlock Text=" to " VerticalAlignment="Center"/>
				<TextBox Width="100" Text="{Binding ThicknessMax}" Margin="0,5"/>
			</StackPanel>

			<!-- DIAMETER -->
			<TextBlock Text="Diameter (mm)" FontWeight="Bold" Margin="0,10,0,0"/>
			<TextBox Text="{Binding Diameter}" Margin="0,5"/>

			<!-- POSITION -->
			<TextBlock Text="Position" FontWeight="Bold" Margin="0,10,0,0"/>
			<ComboBox SelectedItem="{Binding Position}" Margin="0,5">
				<ComboBoxItem Content="1G"/>
				<ComboBoxItem Content="2G"/>
				<ComboBoxItem Content="5G"/>
				<ComboBoxItem Content="6G"/>
			</ComboBox>

			<!-- JOINT -->
			<TextBlock Text="Joint Type" FontWeight="Bold" Margin="0,10,0,0"/>
			<ComboBox SelectedItem="{Binding JointType}" Margin="0,5">
				<ComboBoxItem Content="Groove"/>
				<ComboBoxItem Content="Fillet"/>
			</ComboBox>

			<!-- FILLER -->
			<TextBlock Text="Filler" FontWeight="Bold" Margin="0,10,0,0"/>
			<TextBox Text="{Binding FNumber}" Margin="0,5"/>

			<!-- SAVE -->
			<Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Margin="0,15,0,0"
                    Height="35"/>
		</StackPanel>
	</ScrollViewer>
</Window>