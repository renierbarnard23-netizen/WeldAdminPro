<Window x:Class="WeldAdminPro.UI.Views.Quality.WpsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WeldAdminPro.UI.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WPS Editor"
        Height="750"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- STATUS -->
            <Border Padding="10" Margin="0,0,0,15" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Red"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompliant}" Value="True">
                                <Setter Property="BorderBrush" Value="Green"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding ValidationStatus}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- VALIDATION -->
            <TextBlock Text="Validation Errors" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding ComplianceResult.ValidationErrors}" Height="80"/>

            <TextBlock Text="Essential Failures" FontWeight="Bold" Margin="0,10,0,0"/>
            <ListBox ItemsSource="{Binding ComplianceResult.EssentialFailures}" Height="80"/>

            <TextBlock Text="Range Failures" FontWeight="Bold" Margin="0,10,0,0"/>
            <ListBox ItemsSource="{Binding ComplianceResult.RangeFailures}" Height="80"/>

            <!-- GENERAL -->
            <TextBlock Text="General" FontWeight="Bold" Margin="0,20,0,5"/>
            <TextBox Text="{Binding WpsNumber}" Margin="0,5"/>
            <TextBox Text="{Binding Process}" Margin="0,5"/>

            <!-- PQR -->
            <TextBlock Text="Linked PQR" FontWeight="Bold" Margin="0,15,0,5"/>
            <ComboBox ItemsSource="{Binding AvailablePqrs}"
                      SelectedItem="{Binding SelectedPqr}"
                      DisplayMemberPath="PqrNumber"
                      Margin="0,5"/>

            <!-- MATERIAL -->
            <TextBlock Text="Material" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBox Text="{Binding PNumber}" Margin="0,5"/>

            <!-- THICKNESS -->
            <TextBlock Text="Thickness (mm)" FontWeight="Bold" Margin="0,15,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="120" Text="{Binding ThicknessMin}" Margin="0,5"/>
                <TextBlock Text=" to " VerticalAlignment="Center"/>
                <TextBox Width="120" Text="{Binding ThicknessMax}" Margin="0,5"/>
            </StackPanel>

            <!-- DIAMETER -->
            <TextBlock Text="Diameter (mm)" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBox Text="{Binding Diameter}" Margin="0,5"/>

            <!-- POSITION -->
            <TextBlock Text="Position" FontWeight="Bold" Margin="0,15,0,5"/>
            <ComboBox SelectedItem="{Binding Position}" Margin="0,5">
                <sys:String>1G</sys:String>
                <sys:String>2G</sys:String>
                <sys:String>4G</sys:String>
                <sys:String>5G</sys:String>
                <sys:String>6G</sys:String>
                <sys:String>All</sys:String>
            </ComboBox>

            <!-- JOINT -->
            <TextBlock Text="Joint Type" FontWeight="Bold" Margin="0,15,0,5"/>
            <ComboBox SelectedItem="{Binding JointType}" Margin="0,5">
                <sys:String>Groove</sys:String>
                <sys:String>Fillet</sys:String>
            </ComboBox>

            <TextBlock Text="Joint Design" Margin="0,10,0,5"/>
            <TextBox Text="{Binding JointDesign}" Margin="0,5"/>

            <!-- FILLER -->
            <TextBlock Text="Filler" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBox Text="{Binding FNumber}" Margin="0,5"/>

            <!-- ACTIONS -->
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Margin="0,20,0,0"
                    Height="35"/>
        </StackPanel>
    </ScrollViewer>
</Window>