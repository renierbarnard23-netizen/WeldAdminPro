<UserControl x:Class="WeldAdminPro.UI.Views.Quality.QualityAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<StackPanel Margin="20">

			<!-- HEADER -->
			<TextBlock Text="Executive Quality Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

			<!-- KPI CARDS -->
			<WrapPanel>

				<!-- TOTAL WELDS -->
				<Border Background="#1E293B"
                        Width="220"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Total Welds"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.TotalWelds}"
                                   Foreground="#38BDF8"
                                   FontSize="34"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

				<!-- REJECT RATE -->
				<Border Background="#7F1D1D"
                        Width="220"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Reject Rate"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.RejectRate, StringFormat={}{0:F2}%}"
                                   Foreground="#FCA5A5"
                                   FontSize="34"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

				<!-- OPEN NCR -->
				<Border Background="#78350F"
                        Width="220"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Open NCRs"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.OpenNcrs}"
                                   Foreground="#FCD34D"
                                   FontSize="34"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

				<!-- OPEN CAPAS -->
				<Border Background="#0F766E"
                        Width="220"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Open CAPAs"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.OpenCapas}"
                                   Foreground="#5EEAD4"
                                   FontSize="34"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

			</WrapPanel>

			<!-- SECOND ROW -->
			<WrapPanel>

				<!-- OVERDUE CAPAS -->
				<Border Background="#450A0A"
                        Width="300"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Overdue CAPAs"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.OverdueCapas}"
                                   Foreground="#F87171"
                                   FontSize="34"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

				<!-- WORST WELDER -->
				<Border Background="#172554"
                        Width="300"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Worst Welder"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.WorstWelder}"
                                   Foreground="#93C5FD"
                                   FontSize="24"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

				<!-- TOP DEFECT -->
				<Border Background="#3F6212"
                        Width="300"
                        Height="120"
                        Margin="0,0,15,15"
                        CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Top Defect"
                                   Foreground="White"
                                   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.TopDefectType}"
                                   Foreground="#BEF264"
                                   FontSize="24"
                                   FontWeight="Bold"/>

					</StackPanel>

				</Border>

			</WrapPanel>


			<!-- EXECUTIVE SCORE -->
			<WrapPanel Margin="0,10,0,0">

				<Border Background="#111827"
						Width="300"
						Height="120"
						Margin="0,0,15,15"
						CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Quality Score"
								   Foreground="White"
								   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.QualityScore, StringFormat={}{0:F1}}"
								   Foreground="#34D399"
								   FontSize="34"
								   FontWeight="Bold"/>

					</StackPanel>

				</Border>

				<Border Background="#3F3F46"
						Width="300"
						Height="120"
						Margin="0,0,15,15"
						CornerRadius="8">

					<StackPanel Margin="15">

						<TextBlock Text="Risk Level"
								   Foreground="White"
								   FontSize="16"/>

						<TextBlock Text="{Binding Kpis.RiskLevel}"
								   Foreground="#FACC15"
								   FontSize="28"
								   FontWeight="Bold"/>

					</StackPanel>

				</Border>

			</WrapPanel>

			<!-- EXECUTIVE ALERTS -->
			<GroupBox Header="Executive Alerts"
					  Margin="0,15,0,0"
					  FontWeight="Bold">

				<ListBox ItemsSource="{Binding Kpis.Alerts}"
						 Height="160"/>

			</GroupBox>

			<GroupBox Header="Welder Performance"
          Margin="0,20,0,0"
          FontWeight="Bold">

				<DataGrid ItemsSource="{Binding Kpis.WelderPerformance}"
						  AutoGenerateColumns="False"
						  Height="300"
						  IsReadOnly="True">

					<DataGrid.Columns>

						<DataGridTextColumn Header="Welder"
											Binding="{Binding WelderNumber}"
											Width="150"/>

						<DataGridTextColumn Header="Total Welds"
											Binding="{Binding TotalWelds}"
											Width="140"/>

						<DataGridTextColumn Header="Repairs"
											Binding="{Binding Repairs}"
											Width="120"/>

						<DataGridTextColumn Header="Repair Rate %"
											Binding="{Binding RepairRate, StringFormat={}{0:F2}}"
											Width="150"/>

						<DataGridTextColumn Header="Risk Level"
											Binding="{Binding RiskLevel}"
											Width="140"/>

					</DataGrid.Columns>

				</DataGrid>

			</GroupBox>

            <GroupBox Header="Defect Pareto Analysis"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.ParetoDefects}"
              AutoGenerateColumns="False"
              Height="300"
              IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Defect"
                                Binding="{Binding Defect}"
                                Width="220"/>

                        <DataGridTextColumn Header="Count"
                                Binding="{Binding Count}"
                                Width="120"/>

                        <DataGridTextColumn Header="%"
                                Binding="{Binding Percentage, StringFormat={}{0:F2}}"
                                Width="120"/>

                        <DataGridTextColumn Header="Cumulative %"
                                Binding="{Binding CumulativePercentage, StringFormat={}{0:F2}}"
                                Width="160"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

            <GroupBox Header="CAPA Aging &amp; Escalation"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.CapaAging}"
              AutoGenerateColumns="False"
              Height="320"
              IsReadOnly="True">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Title"
                                Binding="{Binding Title}"
                                Width="260"/>

            <DataGridTextColumn Header="Assigned To"
                                Binding="{Binding AssignedTo}"
                                Width="180"/>

            <DataGridTextColumn Header="Age (Days)"
                                Binding="{Binding AgeDays}"
                                Width="120"/>

            <DataGridTextColumn Header="Days Remaining"
                                Binding="{Binding DaysRemaining}"
                                Width="140"/>

            <DataGridTextColumn Header="Status"
                                Binding="{Binding Status}"
                                Width="140"/>

            <DataGridTextColumn Header="Risk"
                                Binding="{Binding RiskLevel}"
                                Width="120"/>

        </DataGrid.Columns>

    </DataGrid>

</GroupBox>

            <GroupBox Header="NCR Lifecycle Monitoring"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.NcrLifecycle}"
              AutoGenerateColumns="False"
              Height="320"
              IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="NCR"
                                Binding="{Binding NcrNumber}"
                                Width="180"/>

                        <DataGridTextColumn Header="Status"
                                Binding="{Binding Status}"
                                Width="180"/>

                        <DataGridTextColumn Header="Age (Days)"
                                Binding="{Binding AgeDays}"
                                Width="140"/>

                        <DataGridCheckBoxColumn Header="Overdue"
                                    Binding="{Binding IsOverdue}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Risk"
                                Binding="{Binding RiskLevel}"
                                Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

            <GroupBox Header="Repair Cost Intelligence"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.RepairCosts}"
              AutoGenerateColumns="False"
              Height="320"
              IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Welder"
                                Binding="{Binding WelderNumber}"
                                Width="180"/>

                        <DataGridTextColumn Header="Repairs"
                                Binding="{Binding TotalRepairs}"
                                Width="120"/>

                        <DataGridTextColumn Header="Repair Hours"
                                Binding="{Binding EstimatedRepairHours}"
                                Width="160"/>

                        <DataGridTextColumn Header="Estimated Cost"
                                Binding="{Binding EstimatedRepairCost, StringFormat=R {0:N2}}"
                                Width="180"/>

                        <DataGridTextColumn Header="Risk"
                                Binding="{Binding RiskLevel}"
                                Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

            <GroupBox Header="Welder Qualification Risk"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.QualificationRisks}"
              AutoGenerateColumns="False"
              Height="320"
              IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Welder"
                                Binding="{Binding WelderNumber}"
                                Width="180"/>

                        <DataGridTextColumn Header="Process"
                                Binding="{Binding Process}"
                                Width="180"/>

                        <DataGridTextColumn Header="Material Group"
                                Binding="{Binding MaterialGroup}"
                                Width="180"/>

                        <DataGridTextColumn Header="Days Remaining"
                                Binding="{Binding DaysRemaining}"
                                Width="160"/>

                        <DataGridCheckBoxColumn Header="Expired"
                                    Binding="{Binding IsExpired}"
                                    Width="120"/>

                        <DataGridTextColumn Header="Risk"
                                Binding="{Binding RiskLevel}"
                                Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

            <GroupBox Header="Production Bottleneck Intelligence"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.Bottlenecks}"
              AutoGenerateColumns="False"
              Height="320"
              IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Category"
                                Binding="{Binding Category}"
                                Width="220"/>

                        <DataGridTextColumn Header="Count"
                                Binding="{Binding Count}"
                                Width="120"/>

                        <DataGridTextColumn Header="Risk"
                                Binding="{Binding RiskLevel}"
                                Width="120"/>

                        <DataGridTextColumn Header="Recommendation"
                                Binding="{Binding Recommendation}"
                                Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

            <GroupBox Header="AI Repair Prediction Engine"
          Margin="0,20,0,0"
          FontWeight="Bold">

                <DataGrid ItemsSource="{Binding Kpis.RepairPredictions}"
              AutoGenerateColumns="False"
              Height="320"
              IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Welder"
                                Binding="{Binding WelderNumber}"
                                Width="160"/>

                        <DataGridTextColumn Header="Total Welds"
                                Binding="{Binding TotalWelds}"
                                Width="120"/>

                        <DataGridTextColumn Header="Repairs"
                                Binding="{Binding Repairs}"
                                Width="120"/>

                        <DataGridTextColumn Header="Repair Rate"
                                Binding="{Binding RepairRate, StringFormat={}{0:F2}%}"
                                Width="140"/>

                        <DataGridTextColumn Header="Prediction"
                                Binding="{Binding Prediction}"
                                Width="240"/>

                        <DataGridTextColumn Header="Risk"
                                Binding="{Binding RiskLevel}"
                                Width="120"/>

                        <DataGridTextColumn Header="Recommendation"
                                Binding="{Binding Recommendation}"
                                Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

        </StackPanel>

	</ScrollViewer>

</UserControl>