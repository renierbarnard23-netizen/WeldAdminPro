<UserControl x:Class="WeldAdminPro.UI.Views.Quality.TurnoverPackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Packages}"
                  SelectedItem="{Binding SelectedPackage}"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Package"
                                    Binding="{Binding PackageNumber}"
                                    Width="200"/>

                <DataGridTextColumn Header="Created By"
                                    Binding="{Binding CreatedBy}"
                                    Width="160"/>

                <DataGridTextColumn Header="Created"
                                    Binding="{Binding CreatedDate}"
                                    Width="180"/>

                <DataGridCheckBoxColumn Header="Approved"
                                        Binding="{Binding IsApproved}"
                                        Width="100"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">

            <Button Content="Create Package"
                    Width="150"
                    Margin="0,0,10,0"
                    Command="{Binding CreatePackageCommand}"/>

            <Button Content="Approve Package"
                    Width="150"
                    Command="{Binding ApprovePackageCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>