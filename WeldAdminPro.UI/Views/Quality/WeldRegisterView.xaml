<Window x:Class="WeldAdminPro.UI.Views.Quality.WeldRegisterView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:vm="clr-namespace:WeldAdminPro.UI.ViewModels"
     mc:Ignorable="d"
     Title="Weld Register"
     Height="700"
     Width="1300">

<DockPanel Margin="10">

    <!-- TOOLBAR -->
    <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Top"
                Margin="0,0,0,10">

        <Button Content="Add Weld"
                Width="120"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding AddWeldCommand}"/>

        <Button Content="Refresh"
                Width="120"
                Height="30"
                Command="{Binding RefreshCommand}"/>

    </StackPanel>

    <!-- GRID -->
    <DataGrid ItemsSource="{Binding Welds}"
              SelectedItem="{Binding SelectedWeld}"
              AutoGenerateColumns="False"
              IsReadOnly="True">

        <DataGrid.Columns>

            <DataGridTextColumn Header="Weld No"
                                Binding="{Binding WeldNumber}"
                                Width="120"/>

            <DataGridTextColumn Header="Drawing"
                                Binding="{Binding DrawingNumber}"
                                Width="120"/>

            <DataGridTextColumn Header="WPS"
                                Binding="{Binding WpsNumber}"
                                Width="140"/>

            <DataGridTextColumn Header="Welder"
                                Binding="{Binding WelderNumber}"
                                Width="120"/>

            <DataGridTextColumn Header="Material"
                                Binding="{Binding MaterialGroup}"
                                Width="120"/>

            <DataGridTextColumn Header="Process"
                                Binding="{Binding Process}"
                                Width="100"/>

            <DataGridTextColumn Header="Position"
                                Binding="{Binding Position}"
                                Width="100"/>

            <DataGridTextColumn Header="Status"
                                Binding="{Binding Status}"
                                Width="120"/>

            <DataGridTextColumn Header="NDT"
                                Binding="{Binding NdtStatus}"
                                Width="120"/>

            <DataGridTextColumn Header="Repairs"
                                Binding="{Binding RepairCount}"
                                Width="80"/>

        </DataGrid.Columns>

    </DataGrid>

</DockPanel>

</Window>
