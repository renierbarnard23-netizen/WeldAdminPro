<UserControl
    x:Class="WeldAdminPro.UI.Views.Quality.WeldControlTowerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer>

		<StackPanel Margin="20">

			<!-- ===================================== -->
			<!-- HEADER -->
			<!-- ===================================== -->

			<TextBlock
                Text="WELD CONTROL TOWER"
                FontSize="28"
                FontWeight="Bold"
                Margin="0,0,0,20" />

			<!-- ===================================== -->
			<!-- KPI CARDS -->
			<!-- ===================================== -->

			<UniformGrid Columns="4">

				<!-- Draft -->
				<Button
					Command="{Binding ShowDraftCommand}"
					Margin="5">

					<StackPanel>

						<TextBlock
							Text="Draft"
							FontWeight="Bold"
							HorizontalAlignment="Center"/>

						<TextBlock
							Text="{Binding Metrics.DraftCount}"
							FontSize="30"
							HorizontalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- NDT Pending -->
				<Button
                    Command="{Binding ShowNdtPendingCommand}"
                    Margin="5">

					<StackPanel>

						<TextBlock
                            Text="NDT Pending"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />

						<TextBlock
                            Text="{Binding Metrics.NdtPendingCount}"
                            FontSize="30"
                            HorizontalAlignment="Center" />

					</StackPanel>

				</Button>

				<!-- Repair -->
				<Button
                    Command="{Binding ShowRepairCommand}"
                    Margin="5">

					<StackPanel>

						<TextBlock
                            Text="Repair"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />

						<TextBlock
                            Text="{Binding Metrics.RepairRequiredCount}"
                            FontSize="30"
                            HorizontalAlignment="Center" />

					</StackPanel>

				</Button>

				<!-- Released -->
				<Button
                    Command="{Binding ShowReleasedCommand}"
                    Margin="5">

					<StackPanel>

						<TextBlock
                            Text="Released"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />

						<TextBlock
                            Text="{Binding Metrics.ReleasedCount}"
                            FontSize="30"
                            HorizontalAlignment="Center" />

					</StackPanel>

				</Button>

			</UniformGrid>

			<!-- ===================================== -->
			<!-- PERFORMANCE -->
			<!-- ===================================== -->

			<Separator Margin="0,20" />

			<TextBlock
                Text="Performance Metrics"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,10" />

			<TextBlock
                Text="{Binding Metrics.FirstPassYield,
                StringFormat=First Pass Yield: {0}%}" />

			<TextBlock
                Text="{Binding Metrics.RepairRate,
                StringFormat=Repair Rate: {0}%}" />

			<TextBlock
                Text="{Binding Metrics.ReleaseRate,
                StringFormat=Release Rate: {0}%}" />

			<TextBlock
                Text="{Binding Metrics.BlockedCount,
                StringFormat=Blocked Welds: {0}}" />

			<TextBlock
                Text="{Binding Metrics.OverdueNdtCount,
                StringFormat=Overdue NDT: {0}}" />

			<!-- ===================================== -->
			<!-- BLOCKED WELDS -->
			<!-- ===================================== -->

			<Separator Margin="0,20" />

			<TextBlock
                Text="Blocked Welds"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,10" />

			<DataGrid
                ItemsSource="{Binding Metrics.BlockedWelds}"
                AutoGenerateColumns="False"
                Height="250"
                IsReadOnly="True">

				<DataGrid.Columns>

					<DataGridTextColumn
                        Header="Weld"
                        Binding="{Binding WeldNumber}"
                        Width="150" />

					<DataGridTextColumn
                        Header="Status"
                        Binding="{Binding WorkflowStatus}"
                        Width="150" />

					<DataGridTextColumn
                        Header="Blocking Reason"
                        Binding="{Binding BlockingReason}"
                        Width="*" />

				</DataGrid.Columns>

			</DataGrid>

			<!-- ===================================== -->
			<!-- FILTERED WELDS -->
			<!-- ===================================== -->

			<Separator Margin="0,20" />

			<TextBlock
                Text="Selected Welds"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,10" />

			<DataGrid
                ItemsSource="{Binding VisibleWelds}"
				SelectedItem="{Binding SelectedWeld}"
                AutoGenerateColumns="False"
                Height="300"
                IsReadOnly="True">

				<DataGrid.InputBindings>

					<MouseBinding
						MouseAction="LeftDoubleClick"
						Command="{Binding OpenSelectedWeldCommand}" />

				</DataGrid.InputBindings>

				<DataGrid.Columns>

					<DataGridTextColumn
                        Header="Weld"
                        Binding="{Binding WeldNumber}"
                        Width="150" />

					<DataGridTextColumn
                        Header="Status"
                        Binding="{Binding WorkflowStatus}"
                        Width="150" />

					<DataGridTextColumn
                        Header="WPS"
                        Binding="{Binding WpsNumber}"
                        Width="150" />

					<DataGridTextColumn
                        Header="Welder"
                        Binding="{Binding WelderNumber}"
                        Width="150" />

					<DataGridTextColumn
                        Header="Summary"
                        Binding="{Binding Summary}"
                        Width="*" />

				</DataGrid.Columns>

			</DataGrid>

			<TextBlock
    Text="Live Alerts"
    FontSize="20"
    FontWeight="Bold"
    Margin="0,20,0,10"/>

			<ListBox
				ItemsSource="{Binding Metrics.Alerts}"
				Height="120">

				<ListBox.ItemTemplate>

					<DataTemplate>

						<StackPanel Orientation="Horizontal">

							<TextBlock
								Text="{Binding Severity}"
								FontWeight="Bold"
								Width="80"/>

							<TextBlock
								Text="{Binding Message}" />

						</StackPanel>

					</DataTemplate>

				</ListBox.ItemTemplate>

			</ListBox>

			<Separator Margin="0,20"/>

			<TextBlock
				Text="Deadline Risks"
				FontSize="20"
				FontWeight="Bold"
				Margin="0,0,0,10"/>

			<DataGrid
				ItemsSource="{Binding Metrics.DeadlineRisks}"
				AutoGenerateColumns="False"
				Height="250"
				IsReadOnly="True">

				<DataGrid.Columns>

					<DataGridTextColumn
						Header="Weld"
						Binding="{Binding WeldNumber}"
						Width="150"/>

					<DataGridTextColumn
						Header="Risk"
						Binding="{Binding RiskLevel}"
						Width="150"/>

					<DataGridTextColumn
						Header="Days Waiting"
						Binding="{Binding DaysWaiting}"
						Width="150"/>

					<DataGridTextColumn
						Header="Reason"
						Binding="{Binding Reason}"
						Width="*"/>

				</DataGrid.Columns>

			</DataGrid>

		</StackPanel>

	</ScrollViewer>

</UserControl>