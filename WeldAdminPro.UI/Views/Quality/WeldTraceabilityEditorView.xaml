<UserControl x:Class="WeldAdminPro.UI.Views.Quality.WeldTraceabilityEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="WPS"
                                    Binding="{Binding WpsNumber}"
                                    Width="140"/>

                <DataGridTextColumn Header="PQR"
                                    Binding="{Binding PqrNumber}"
                                    Width="140"/>

                <DataGridTextColumn Header="Welder Qualification"
                                    Binding="{Binding WelderQualification}"
                                    Width="180"/>

                <DataGridTextColumn Header="Heat Number"
                                    Binding="{Binding MaterialHeatNumber}"
                                    Width="160"/>

                <DataGridTextColumn Header="Consumable Batch"
                                    Binding="{Binding ConsumableBatch}"
                                    Width="180"/>

                <DataGridTextColumn Header="NDT Report"
                                    Binding="{Binding NdtReportNumber}"
                                    Width="160"/>

                <DataGridTextColumn Header="Release Certificate"
                                    Binding="{Binding ReleaseCertificate}"
                                    Width="180"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Traceability"
                    Width="119"
                    Click="OpenTraceability_Click"/>

            <Button Content="Save"
                    Width="120"
                    Height="35"
                    Command="{Binding SaveCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>