<Window x:Class="WeldAdminPro.UI.Views.Quality.WeldDossierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weld Dossier"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

		<Grid.RowDefinitions>

			<!-- Header -->
			<RowDefinition Height="Auto"/>

			<!-- Weld Info -->
			<RowDefinition Height="220"/>

			<!-- NDT -->
			<RowDefinition Height="220"/>

			<!-- NCR -->
			<RowDefinition Height="220"/>

			<!-- Hold Points -->
			<RowDefinition Height="220"/>

			<!-- Attachments -->
			<RowDefinition Height="350"/>

		</Grid.RowDefinitions>

		<!-- HEADER -->
		<Border Background="#1D2B44"
				Padding="15"
				CornerRadius="5">

			<DockPanel>

				<!-- TITLE -->
				<StackPanel Orientation="Horizontal"
							DockPanel.Dock="Left">

					<TextBlock Text="WELD DOSSIER"
							   FontSize="26"
							   FontWeight="Bold"
							   Foreground="White"/>

					<TextBlock Text="   |   "
							   Foreground="White"
							   FontSize="26"/>

					<TextBlock Text="{Binding WeldNumber}"
							   FontSize="26"
							   FontWeight="Bold"
							   Foreground="#4FC3F7"/>

				</StackPanel>

				<!-- EXPORT BUTTON -->
				<Button Content="Export PDF Dossier"
						Width="200"
						Height="35"
						HorizontalAlignment="Right"
						Click="ExportPdf_Click"/>

			</DockPanel>

		</Border>

        <!-- WELD INFO -->
        <GroupBox Header="Weld Information"
                  Grid.Row="1"
                  Margin="0,10,0,0">

            <DataGrid ItemsSource="{Binding WeldInfo}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Drawing"
                                        Binding="{Binding DrawingNumber}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Joint Type"
                                        Binding="{Binding JointType}"
                                        Width="200"/>

                    <DataGridTextColumn Header="WPS"
                                        Binding="{Binding WpsNumber}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Welder"
                                        Binding="{Binding WelderId}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Workflow"
                                        Binding="{Binding WorkflowStatus}"
                                        Width="200"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- NDT -->
        <GroupBox Header="NDT History"
                  Grid.Row="2"
                  Margin="0,10,0,0">

            <DataGrid ItemsSource="{Binding NdtHistory}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"/>

        </GroupBox>

        <!-- NCR -->
        <GroupBox Header="NCR History"
                  Grid.Row="3"
                  Margin="0,10,0,0">

            <DataGrid ItemsSource="{Binding Ncrs}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"/>

        </GroupBox>

        <!-- HOLD POINTS -->
        <GroupBox Header="Hold Points"
                  Grid.Row="4"
                  Margin="0,10,0,0">

            <DataGrid ItemsSource="{Binding HoldPoints}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"/>

        </GroupBox>

		<GroupBox Header="Attachments"
          Grid.Row="5"
          Margin="0,10,0,0">

			<ContentControl x:Name="AttachmentHost"/>

		</GroupBox>

    </Grid>

</Window>