<UserControl x:Class="WeldAdminPro.UI.Views.Quality.TurnoverGovernanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- KPI -->
        <WrapPanel Margin="0,0,0,10">

            <Border Background="#1E293B"
                    Width="220"
                    Height="90"
                    Margin="0,0,10,0"
                    CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Total Welds"
                               Foreground="White"/>

                    <TextBlock Text="{Binding TotalWelds}"
                               Foreground="#4FC3F7"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <Border Background="#14532D"
                    Width="220"
                    Height="90"
                    Margin="0,0,10,0"
                    CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Ready"
                               Foreground="White"/>

                    <TextBlock Text="{Binding ReadyForTurnover}"
                               Foreground="#86EFAC"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <Border Background="#991B1B"
                    Width="220"
                    Height="90"
                    Margin="0,0,10,0"
                    CornerRadius="6">

                <StackPanel Margin="15">

                    <TextBlock Text="Blocked"
                               Foreground="White"/>

                    <TextBlock Text="{Binding BlockedWelds}"
                               Foreground="#FECACA"
                               FontSize="28"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </WrapPanel>

        <!-- GRID -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Weld"
                                    Binding="{Binding WeldNumber}"
                                    Width="120"/>

                <DataGridCheckBoxColumn Header="Released"
                                        Binding="{Binding Released}"
                                        Width="100"/>

                <DataGridCheckBoxColumn Header="NDT"
                                        Binding="{Binding NdtAccepted}"
                                        Width="100"/>

                <DataGridCheckBoxColumn Header="Repairs"
                                        Binding="{Binding NoOpenRepairs}"
                                        Width="100"/>

                <DataGridCheckBoxColumn Header="NCR"
                                        Binding="{Binding NoOpenNcrs}"
                                        Width="100"/>

                <DataGridCheckBoxColumn Header="Hold Points"
                                        Binding="{Binding HoldPointsApproved}"
                                        Width="120"/>

                <DataGridCheckBoxColumn Header="Docs"
                                        Binding="{Binding DocumentsAttached}"
                                        Width="100"/>

                <DataGridCheckBoxColumn Header="Ready"
                                        Binding="{Binding TurnoverReady}"
                                        Width="100"/>

                <DataGridTextColumn Header="Blocking Reasons"
                                    Binding="{Binding BlockingReasons}"
                                    Width="500"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>