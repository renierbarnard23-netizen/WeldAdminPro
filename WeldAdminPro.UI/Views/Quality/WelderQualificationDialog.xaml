<Window x:Class="WeldAdminPro.UI.Views.Quality.WelderQualificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welder Qualification"
        Height="400" Width="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBox Text="{Binding WelderName}" />

            <TextBox Text="{Binding Process}" />

            <TextBox Text="{Binding Position}" />

            <DatePicker SelectedDate="{Binding QualificationDate}"/>

            <DatePicker SelectedDate="{Binding ExpiryDate}"/>

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>

        </StackPanel>

    </Grid>
</Window>