<Window x:Class="WeldAdminPro.UI.Views.Quality.WelderQualificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welder Qualification"
        Height="520"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- WELDER NUMBER -->
        <TextBlock Text="Welder Number:"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   Margin="0,5"/>

        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Margin="5"
                 Text="{Binding WelderNumber, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- PROCESS -->
        <TextBlock Text="Process:"
                   Grid.Row="1"
                   VerticalAlignment="Center"
                   Margin="0,5"/>

        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="5"
                 Text="{Binding Process, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- MATERIAL GROUP -->
        <TextBlock Text="Material Group:"
                   Grid.Row="2"
                   VerticalAlignment="Center"
                   Margin="0,5"/>

        <ComboBox Grid.Row="2"
          Grid.Column="1"
          Margin="5"
          SelectedValue="{Binding MaterialGroup}"
          SelectedValuePath="Content">

    <ComboBoxItem Content="1"/>
    <ComboBoxItem Content="2"/>
    <ComboBoxItem Content="3"/>
    <ComboBoxItem Content="4"/>
    <ComboBoxItem Content="5"/>
    <ComboBoxItem Content="6"/>
    <ComboBoxItem Content="7"/>
    <ComboBoxItem Content="8"/>
    <ComboBoxItem Content="9"/>
    <ComboBoxItem Content="10"/>

</ComboBox>

        <!-- POSITION -->
        <TextBlock Text="Position:"
                   Grid.Row="3"
                   VerticalAlignment="Center"
                   Margin="0,5"/>

        <ComboBox Grid.Row="3"
          Grid.Column="1"
          Margin="5"
          SelectedValue="{Binding Position}"
          SelectedValuePath="Content">

    <ComboBoxItem Content="1G"/>
    <ComboBoxItem Content="2G"/>
    <ComboBoxItem Content="3G"/>
    <ComboBoxItem Content="4G"/>
    <ComboBoxItem Content="5G"/>
    <ComboBoxItem Content="6G"/>

    <ComboBoxItem Content="1F"/>
    <ComboBoxItem Content="2F"/>
    <ComboBoxItem Content="3F"/>
    <ComboBoxItem Content="4F"/>

</ComboBox>

        <!-- THICKNESS MIN -->
<TextBlock Text="Thickness Min:"
           Grid.Row="4"
           VerticalAlignment="Center"
           Margin="0,5"/>

<TextBox Grid.Row="4"
         Grid.Column="1"
         Margin="5"
         Text="{Binding ThicknessMin,
                        UpdateSourceTrigger=PropertyChanged,
                        StringFormat=N2}"/>

<!-- THICKNESS MAX -->
<TextBlock Text="Thickness Max:"
           Grid.Row="5"
           VerticalAlignment="Center"
           Margin="0,5"/>

<TextBox Grid.Row="5"
         Grid.Column="1"
         Margin="5"
         Text="{Binding ThicknessMax,
                        UpdateSourceTrigger=PropertyChanged,
                        StringFormat=N2}"/>

        <!-- QUALIFICATION DATE -->
        <TextBlock Text="Qualification Date:"
                   Grid.Row="6"
                   VerticalAlignment="Center"
                   Margin="0,5"/>

        <DatePicker Grid.Row="6"
                    Grid.Column="1"
                    Margin="5"
                    SelectedDate="{Binding QualificationDate}"/>

        <!-- EXPIRY DATE -->
        <TextBlock Text="Expiry Date:"
                   Grid.Row="7"
                   VerticalAlignment="Center"
                   Margin="0,5"/>

        <DatePicker Grid.Row="7"
                    Grid.Column="1"
                    Margin="5"
                    SelectedDate="{Binding ExpiryDate}"/>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="9"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Save"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Command="{Binding SaveCommand}"/>

            <Button Content="Cancel"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Command="{Binding CancelCommand}"/>

        </StackPanel>

    </Grid>
</Window>