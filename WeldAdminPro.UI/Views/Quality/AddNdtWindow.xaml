<Window x:Class="WeldAdminPro.UI.Views.Quality.AddNdtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add NDT Result"
        Height="550"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- NDT Method -->

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="NDT Method:"
                   Margin="0,5"/>

        <ComboBox Grid.Row="0"
                  Grid.Column="1"
                  Margin="5"
                  ItemsSource="{Binding AvailableMethods}"
                  SelectedItem="{Binding SelectedMethod}"/>

        <!-- Result -->

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Result:"
                   Margin="0,5"/>

        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Margin="5"
                  ItemsSource="{Binding AvailableResults}"
                  SelectedItem="{Binding SelectedResult}"/>

        <!-- Inspection Date -->

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Inspection Date:"
                   Margin="0,5"/>

        <DatePicker Grid.Row="2"
                    Grid.Column="1"
                    Margin="5"
                    SelectedDate="{Binding InspectionDate}"/>

        <!-- Inspector -->

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Inspector:"
                   Margin="0,5"/>

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Margin="5"
                 Text="{Binding InspectorName}"/>

        <!-- Report Number -->

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="Report Number:"
                   Margin="0,5"/>

        <TextBox Grid.Row="4"
                 Grid.Column="1"
                 Margin="5"
                 Text="{Binding ReportNumber}"/>

        <!-- Acceptance Criteria -->

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Text="Acceptance Criteria:"
                   Margin="0,5"/>

        <TextBox Grid.Row="5"
                 Grid.Column="1"
                 Margin="5"
                 Text="{Binding AcceptanceCriteria}"/>

        <!-- Requires Repair -->

        <CheckBox Grid.Row="6"
                  Grid.Column="1"
                  Margin="5"
                  Content="Requires Repair"
                  IsChecked="{Binding RequiresRepair}"/>

        <!-- Remarks -->

        <TextBlock Grid.Row="7"
                   Grid.Column="0"
                   Text="Remarks:"
                   VerticalAlignment="Top"
                   Margin="0,5"/>

        <TextBox Grid.Row="7"
                 Grid.Column="1"
                 Margin="5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Remarks}"/>

        <!-- Buttons -->

        <StackPanel Grid.Row="8"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Save"
                    Width="100"
                    Margin="5"
                    Click="Save_Click"/>

            <Button Content="Cancel"
                    Width="100"
                    Margin="5"
                    Click="Cancel_Click"/>
        </StackPanel>

    </Grid>
</Window>