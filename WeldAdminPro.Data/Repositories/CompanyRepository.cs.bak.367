using Microsoft.Data.Sqlite;
using System;
using System.Collections.Generic;
using WeldAdminPro.Core.Models;
using WeldAdminPro.Data;

namespace WeldAdminPro.Data.Repositories
{
    public class CompanyRepository
    {
        private readonly string _connectionString;

        public CompanyRepository()
        {
            _connectionString =
                $"Data Source={DatabasePath.Get()}";
        }

        public List<Company> GetAll()
        {
            var list = new List<Company>();

            using var connection =
                new SqliteConnection(_connectionString);

            connection.Open();

            using var cmd =
                connection.CreateCommand();

            cmd.CommandText = @"
                SELECT
                    Id,
                    CompanyName,
                    CompanyCode,
                    IsActive,
                    CreatedDate
                FROM Companies
                ORDER BY CompanyName;
            ";

            using var reader =
                cmd.ExecuteReader();

            while (reader.Read())
            {
                list.Add(MapCompany(reader));
            }

            return list;
        }

        public Company? GetById(Guid id)
        {
            using var connection =
                new SqliteConnection(_connectionString);

            connection.Open();

            using var cmd =
                connection.CreateCommand();

            cmd.CommandText = @"
                SELECT
                    Id,
                    CompanyName,
                    CompanyCode,
                    IsActive,
                    CreatedDate
                FROM Companies
                WHERE Id = $id;
            ";

            cmd.Parameters.AddWithValue(
                "$id",
                id.ToString());

            using var reader =
                cmd.ExecuteReader();

            if (!reader.Read())
                return null;

            return MapCompany(reader);
        }

        public Company? GetByCode(string companyCode)
        {
            if (string.IsNullOrWhiteSpace(companyCode))
                return null;

            using var connection =
                new SqliteConnection(_connectionString);

            connection.Open();

            using var cmd =
                connection.CreateCommand();

            cmd.CommandText = @"
                SELECT
                    Id,
                    CompanyName,
                    CompanyCode,
                    IsActive,
                    CreatedDate
                FROM Companies
                WHERE CompanyCode = $companyCode;
            ";

            cmd.Parameters.AddWithValue(
                "$companyCode",
                companyCode.Trim());

            using var reader =
                cmd.ExecuteReader();

            if (!reader.Read())
                return null;

            return MapCompany(reader);
        }

        public void Add(Company company)
        {
            if (company == null)
                throw new ArgumentNullException(
                    nameof(company));

            using var connection =
                new SqliteConnection(_connectionString);

            connection.Open();

            using var cmd =
                connection.CreateCommand();

            cmd.CommandText = @"
                INSERT INTO Companies
                (
                    Id,
                    CompanyName,
                    CompanyCode,
                    IsActive,
                    CreatedDate
                )
                VALUES
                (
                    $id,
                    $companyName,
                    $companyCode,
                    $isActive,
                    $createdDate
                );
            ";

            cmd.Parameters.AddWithValue(
                "$id",
                company.Id.ToString());

            cmd.Parameters.AddWithValue(
                "$companyName",
                company.CompanyName.Trim());

            cmd.Parameters.AddWithValue(
                "$companyCode",
                company.CompanyCode.Trim());

            cmd.Parameters.AddWithValue(
                "$isActive",
                company.IsActive ? 1 : 0);

            cmd.Parameters.AddWithValue(
                "$createdDate",
                company.CreatedDate.ToString("O"));

            cmd.ExecuteNonQuery();
        }

        public void Update(Company company)
        {
            if (company == null)
                throw new ArgumentNullException(
                    nameof(company));

            using var connection =
                new SqliteConnection(_connectionString);

            connection.Open();

            using var cmd =
                connection.CreateCommand();

            cmd.CommandText = @"
                UPDATE Companies
                SET
                    CompanyName = $companyName,
                    CompanyCode = $companyCode,
                    IsActive = $isActive
                WHERE Id = $id;
            ";

            cmd.Parameters.AddWithValue(
                "$id",
                company.Id.ToString());

            cmd.Parameters.AddWithValue(
                "$companyName",
                company.CompanyName.Trim());

            cmd.Parameters.AddWithValue(
                "$companyCode",
                company.CompanyCode.Trim());

            cmd.Parameters.AddWithValue(
                "$isActive",
                company.IsActive ? 1 : 0);

            cmd.ExecuteNonQuery();
        }

        public void SetActive(
            Guid id,
            bool isActive)
        {
            using var connection =
                new SqliteConnection(_connectionString);

            connection.Open();

            using var cmd =
                connection.CreateCommand();

            cmd.CommandText = @"
                UPDATE Companies
                SET IsActive = $active
                WHERE Id = $id;
            ";

            cmd.Parameters.AddWithValue(
                "$active",
                isActive ? 1 : 0);

            cmd.Parameters.AddWithValue(
                "$id",
                id.ToString());

            cmd.ExecuteNonQuery();
        }

        private static Company MapCompany(
            SqliteDataReader reader)
        {
            return new Company
            {
                Id = Guid.Parse(
                    reader.GetString(0)),

                CompanyName =
                    reader.GetString(1),

                CompanyCode =
                    reader.GetString(2),

                IsActive =
                    reader.GetInt32(3) == 1,

                CreatedDate =
                    DateTime.Parse(
                        reader.GetString(4))
            };
        }
    }
}
