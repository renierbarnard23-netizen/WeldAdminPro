        public Company? GetCompany(Guid id)
        {
            return _companyRepository.GetById(id);
        }

        public void AddCompany(Company company)
        {
            if (company == null)
                throw new ArgumentNullException(nameof(company));

            if (string.IsNullOrWhiteSpace(company.CompanyName))
                throw new ArgumentException(
                    "Company name cannot be empty.");

            if (string.IsNullOrWhiteSpace(company.CompanyCode))
                throw new ArgumentException(
                    "Company code cannot be empty.");

            if (_companyRepository.GetByCode(company.CompanyCode) != null)
                throw new InvalidOperationException(
                    "A company with this code already exists.");

            _companyRepository.Add(company);

            _auditService.Log(
                "CREATE COMPANY",
                "Administration",
                $"Created company: {company.CompanyName} ({company.CompanyCode})");
        }

        public void UpdateCompany(Company company)
        {
            if (company == null)
                throw new ArgumentNullException(nameof(company));

            if (string.IsNullOrWhiteSpace(company.CompanyName))
                throw new ArgumentException(
                    "Company name cannot be empty.");

            if (string.IsNullOrWhiteSpace(company.CompanyCode))
                throw new ArgumentException(
                    "Company code cannot be empty.");

            var existing = _companyRepository.GetByCode(company.CompanyCode);

            if (existing != null && existing.Id != company.Id)
                throw new InvalidOperationException(
                    "Another company already uses this company code.");

            _companyRepository.Update(company);

            _auditService.Log(
                "EDIT COMPANY",
                "Administration",
                $"Edited company: {company.CompanyName} ({company.CompanyCode})");
        }

        public void EnableCompany(Guid companyId)
        {
            var company = _companyRepository.GetById(companyId);

            if (company == null)
                return;

            _companyRepository.SetActive(companyId, true);

            _auditService.Log(
                "ENABLE COMPANY",
                "Administration",
                $"Enabled company: {company.CompanyName}");
        }

        public void DisableCompany(Guid companyId)
