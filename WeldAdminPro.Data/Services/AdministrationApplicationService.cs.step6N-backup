        public AdministrationApplicationService(
            AuditService auditService,
            IUserCompanyAccessRepository userCompanyAccessRepository,
            IPermissionAuthorizationService permissionAuthorization,
            ICurrentUserContext currentUser)
        {
            _auditService = auditService;
            _userCompanyAccessRepository = userCompanyAccessRepository
