        public async Task<IReadOnlyList<UserCompanyAccess>>
            GetUserCompanyAccessAsync(Guid userId)
        {
            await EnsureSecurityPermissionAsync();

            if (userId == Guid.Empty)
                throw new ArgumentException(
                    "User ID is required.",
                    nameof(userId));

            var user = GetUser(userId);

            if (user == null)
                throw new InvalidOperationException(
                    "User was not found.");

            var access = await _userCompanyAccessRepository
                .GetByUserIdAsync(user.Id.ToString());

            return access.ToList();
        }

        public async Task GrantUserCompanyAccessAsync(
            Guid userId,
            Guid companyId,
            DateTime? validFrom = null,
            DateTime? validUntil = null,
            string? notes = null)
        {
            await EnsureSecurityPermissionAsync();

            if (userId == Guid.Empty)
                throw new ArgumentException(
                    "User ID is required.",
                    nameof(userId));

            if (companyId == Guid.Empty)
                throw new ArgumentException(
                    "Company ID is required.",
                    nameof(companyId));

            if (validFrom.HasValue &&
                validUntil.HasValue &&
                validUntil.Value < validFrom.Value)
            {
                throw new ArgumentException(
                    "Valid until date cannot be earlier than valid from date.");
            }

            var user = GetUser(userId);

            if (user == null)
                throw new InvalidOperationException(
                    "User was not found.");

            var company = _companyRepository.GetById(companyId);

            if (company == null)
                throw new InvalidOperationException(
                    "Company was not found.");

            // Home-company access is implicit.
            if (user.CompanyId.HasValue &&
                user.CompanyId.Value == companyId)
            {
                throw new InvalidOperationException(
                    "The user's home company already grants access. " +
                    "Additional company access is not required.");
            }

            if (await _userCompanyAccessRepository
                .HasActiveAccessAsync(
                    userId.ToString(),
                    companyId))
            {
                throw new InvalidOperationException(
                    "The user already has active access to this company.");
            }

            var access = new UserCompanyAccess
            {
                Id = Guid.NewGuid(),
                UserId = userId.ToString(),
                CompanyId = companyId,
                IsActive = true,
                ValidFrom = validFrom,
                ValidUntil = validUntil,
                CreatedOn = DateTime.UtcNow,
                CreatedBy = string.IsNullOrWhiteSpace(_currentUser.Username)
                    ? "System"
                    : _currentUser.Username.Trim(),
                Notes = notes
            };

            await _userCompanyAccessRepository.AddAsync(access);

            _auditService.Log(
                "GRANT COMPANY ACCESS",
                "User Management",
                $"Granted {user.Username} access to {company.CompanyName}.");
        }

        public async Task RevokeUserCompanyAccessAsync(
            Guid userId,
            Guid accessId)
        {
            await EnsureSecurityPermissionAsync();

            if (userId == Guid.Empty)
                throw new ArgumentException(
                    "User ID is required.",
                    nameof(userId));

            if (accessId == Guid.Empty)
                throw new ArgumentException(
                    "Access ID is required.",
                    nameof(accessId));

            var user = GetUser(userId);

            if (user == null)
                throw new InvalidOperationException(
                    "User was not found.");

            var access = (await _userCompanyAccessRepository
                    .GetByUserIdAsync(userId.ToString()))
                .FirstOrDefault(x => x.Id == accessId);

            if (access == null)
                throw new InvalidOperationException(
                    "Company access record was not found for this user.");

            if (!access.IsActive)
                return;

            await _userCompanyAccessRepository
                .DeactivateAsync(accessId);

            var company = _companyRepository.GetById(access.CompanyId);

            _auditService.Log(
                "REVOKE COMPANY ACCESS",
                "User Management",
                $"Revoked {user.Username} access to " +
                $"{company?.CompanyName ?? access.CompanyId.ToString()}.");
        }

        private async Task EnsureSecurityPermissionAsync()
        {
            if (!_currentUser.IsAuthenticated ||
                string.IsNullOrWhiteSpace(_currentUser.UserId))
            {
                throw new UnauthorizedAccessException(
                    "Authentication is required.");
            }

            var allowed =
                await _permissionAuthorization.HasPermissionAsync(
                    _currentUser.UserId,
                    _currentUser.Role,
                    PermissionKeys.Administration.Security);

            if (!allowed)
            {
                throw new UnauthorizedAccessException(
                    "Administration.Security permission is required.");
            }
        }


        public List<Company> GetCompanies()
        {
            return _companyRepository.GetAll();
