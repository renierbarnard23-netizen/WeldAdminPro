    private void RecordVerificationUi()
    {
        if (_selectedNcr == null)
        {
            Snackbar.Add(
                "Select an NCR before recording verification.",
                Severity.Warning);

            return;
        }

        if (_selectedNcr.Status !=
            NcrStatus.PendingVerification)
        {
            Snackbar.Add(
                "Only an NCR awaiting verification can be verified.",
                Severity.Error);

            return;
        }

        if (string.IsNullOrWhiteSpace(
                _verificationBy))
        {
            Snackbar.Add(
                "Verified By is required.",
                Severity.Warning);

            return;
        }

        var ncrId =
            _selectedNcr.Id;

        var verifiedBy =
            _verificationBy.Trim();

        var succeeded =
            NcrService.RecordVerification(
                ncrId,
                verifiedBy);

        if (!succeeded)
        {
            Snackbar.Add(
                "Unable to record verification. Check the NCR status and existing verification record.",
                Severity.Error);

            return;
        }

        _verificationBy =
            string.Empty;

        LoadNcrs();

        _selectedNcr =
            _ncrs.FirstOrDefault(
                x => x.Id == ncrId);

        Snackbar.Add(
            $"Final verification recorded by {verifiedBy}.",
            Severity.Success);
    }


    private void CloseNcrUi()
    {
        if (_selectedNcr == null)
        {
            Snackbar.Add(
                "Select an NCR before closure.",
                Severity.Warning);

            return;
        }

        if (_selectedNcr.Status !=
            NcrStatus.PendingVerification)
        {
            Snackbar.Add(
                "Only an NCR awaiting verification can be closed.",
                Severity.Error);

            return;
        }

        if (string.IsNullOrWhiteSpace(
                _selectedNcr.VerificationBy) ||
            !_selectedNcr.VerificationDate.HasValue)
        {
            Snackbar.Add(
                "Final verification must be recorded before closure.",
                Severity.Warning);

            return;
        }

        if (string.IsNullOrWhiteSpace(
                _closureBy))
        {
            Snackbar.Add(
                "Closed By is required.",
                Severity.Warning);

            return;
        }

        var ncrId =
            _selectedNcr.Id;

        var closedBy =
            _closureBy.Trim();

        var succeeded =
            NcrService.Close(
                ncrId,
                closedBy);

        if (!succeeded)
        {
            Snackbar.Add(
                "Unable to close NCR. Check verification and customer approval requirements.",
                Severity.Error);

            return;
        }

        _closureBy =
            string.Empty;

        LoadNcrs();

        _selectedNcr =
            _ncrs.FirstOrDefault(
                x => x.Id == ncrId);

        Snackbar.Add(
            $"NCR closed by {closedBy}.",
            Severity.Success);
    }

    private bool CanAdvanceBasicWorkflow(
        NcrRecord ncr)
    {
        var target =
            GetBasicNextStatus(ncr);

        return target.HasValue &&
               NcrService.CanMoveTo(
                   ncr,
                   target.Value);
    }


    private void AdvanceWorkflow()
    {
        if (_selectedNcr == null)
        {
            return;
        }

        var target =
            GetBasicNextStatus(
                _selectedNcr);

        if (!target.HasValue)
        {
            Snackbar.Add(
                "No basic workflow transition is available for this NCR.",
                Severity.Warning);

            return;
        }

        if (!NcrService.CanMoveTo(
                _selectedNcr,
                target.Value))
        {
            Snackbar.Add(
                $"Workflow transition from {_selectedNcr.Status} to {target.Value} is not permitted.",
                Severity.Warning);

            return;
        }

        var ncrId =
            _selectedNcr.Id;

        var moved =
            NcrService.MoveTo(
                ncrId,
                target.Value);

        if (!moved)
        {
            Snackbar.Add(
                "Unable to advance the NCR workflow.",
                Severity.Error);

            return;
        }

        Snackbar.Add(
            $"NCR advanced to {target.Value}.",
            Severity.Success);

        LoadNcrs();

        _selectedNcr =
            _ncrs.FirstOrDefault(
                x => x.Id == ncrId);
    }


    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not recorded"
            : value;
    }


    private static Color GetStatusColor(NcrStatus status)
    {
        return status switch
        {
            NcrStatus.Open =>
                Color.Error,

            NcrStatus.UnderInvestigation =>
                Color.Warning,

            NcrStatus.AwaitingDisposition =>
                Color.Warning,

            NcrStatus.ApprovedForRepair =>
                Color.Info,

            NcrStatus.RepairInProgress =>
                Color.Info,

            NcrStatus.PendingVerification =>
                Color.Secondary,

            NcrStatus.Closed =>
                Color.Success,

            NcrStatus.Rejected =>
                Color.Dark,

            _ =>
                Color.Default
        };
    }
