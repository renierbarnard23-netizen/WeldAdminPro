    // NCR REPAIR / REWORK EXECUTION
    // =====================================================

    private string _executionPerformedBy = string.Empty;

    // =====================================================
    // NCR VERIFICATION / CLOSURE
    // =====================================================

    private string _verificationBy = string.Empty;
    private string _closureBy = string.Empty;

    private string _search = string.Empty;

    private NcrStatus? _selectedStatus;
    // =====================================================
    // NCR DISPOSITION
    // =====================================================

    private NcrDispositionType? _dispositionType;

    private string _dispositionRootCause = string.Empty;
    private string _dispositionCorrectiveAction = string.Empty;
    private string _dispositionPreventiveAction = string.Empty;

    private string _dispositionApprovedBy = string.Empty;

    private bool _requiresCustomerApproval;
    private bool _customerApproved;

    private string _customerApprovalReference = string.Empty;

    private string _dispositionError = string.Empty;

    private bool _isSavingDisposition;


    protected override void OnInitialized()
    {
        LoadNcrs();
    }


    private void LoadNcrs()
    {
        try
        {
            _ncrs =
                NcrService
                    .GetAll()
                    .OrderByDescending(x => x.RaisedDate)
                    .ToList();

            if (_selectedNcr != null)
            {
                _selectedNcr =
                    _ncrs.FirstOrDefault(
                        x => x.Id == _selectedNcr.Id);

                if (_selectedNcr != null)
                {
                    LoadDispositionEditor(
                        _selectedNcr);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load NCR register: {ex.Message}",
                Severity.Error);
        }
    }


    private void SelectNcr(
        NcrRecord? ncr)
    {
        _selectedNcr =
            ncr;

        if (_selectedNcr != null)
        {
            LoadDispositionEditor(
                _selectedNcr);
        }
        else
        {
            _dispositionType = null;

            _dispositionRootCause =
                string.Empty;

            _dispositionCorrectiveAction =
                string.Empty;

            _dispositionPreventiveAction =
                string.Empty;

            _dispositionApprovedBy =
                string.Empty;

            _requiresCustomerApproval =
                false;

            _customerApproved =
                false;

            _customerApprovalReference =
                string.Empty;

            _dispositionError =
                string.Empty;
        }
    }

    private IEnumerable<NcrRecord> FilteredNcrs =>
        _ncrs.Where(ncr =>
            (
                string.IsNullOrWhiteSpace(_search)
                ||
                ncr.NcrNumber.Contains(
                    _search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (ncr.WeldNumber ?? string.Empty).Contains(
                    _search,
                    StringComparison.OrdinalIgnoreCase)
                ||
                ncr.Description.Contains(
                    _search,
                    StringComparison.OrdinalIgnoreCase)
            )
            &&
            (
                !_selectedStatus.HasValue
                ||
                ncr.Status == _selectedStatus.Value
            ));


    private int OpenCount =>
        _ncrs.Count(x =>
            x.Status != NcrStatus.Closed &&
            x.Status != NcrStatus.Rejected);


    private int PendingVerificationCount =>
        _ncrs.Count(x =>
            x.Status == NcrStatus.PendingVerification);


    private int ClosedCount =>
        _ncrs.Count(x =>
            x.Status == NcrStatus.Closed);


    private void ClearFilters()
    {
        _search = string.Empty;
        _selectedStatus = null;
    }


    private void LoadDispositionEditor(
        NcrRecord ncr)
    {
        _dispositionType =
            ncr.DispositionType;

        _dispositionRootCause =
            ncr.RootCause ?? string.Empty;

        _dispositionCorrectiveAction =
            ncr.CorrectiveAction ?? string.Empty;

        _dispositionPreventiveAction =
            ncr.PreventiveAction ?? string.Empty;

        _dispositionApprovedBy =
            ncr.DispositionApprovedBy ?? string.Empty;

        _requiresCustomerApproval =
            ncr.RequiresCustomerApproval;

        _customerApproved =
            ncr.CustomerApproved;

        _customerApprovalReference =
            ncr.CustomerApprovalReference ?? string.Empty;

        _dispositionError =
            string.Empty;
    }


    private async Task SaveNcrDisposition()
    {
        _dispositionError =
            string.Empty;

        if (_selectedNcr == null)
        {
            return;
        }

        if (_selectedNcr.Status !=
            NcrStatus.AwaitingDisposition)
        {
            _dispositionError =
                "Disposition can only be recorded while the NCR is awaiting disposition.";

            return;
        }

        if (!_dispositionType.HasValue)
        {
            _dispositionError =
                "Select an NCR disposition.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            _dispositionRootCause))
        {
            _dispositionError =
                "Enter the root cause.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            _dispositionCorrectiveAction))
        {
            _dispositionError =
                "Enter the corrective action.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            _dispositionApprovedBy))
        {
            _dispositionError =
                "Enter the person approving the disposition.";

            return;
        }

        if (_requiresCustomerApproval &&
            _customerApproved &&
            string.IsNullOrWhiteSpace(
                _customerApprovalReference))
        {
            _dispositionError =
                "Enter the customer approval reference.";

            return;
        }

        try
        {
            _isSavingDisposition =
                true;

            var ncrId =
                _selectedNcr.Id;

            _selectedNcr.RootCause =
                _dispositionRootCause.Trim();

            _selectedNcr.CorrectiveAction =
                _dispositionCorrectiveAction.Trim();

            _selectedNcr.PreventiveAction =
                _dispositionPreventiveAction.Trim();

            NcrService.Update(
                _selectedNcr);

            var saved =
                NcrService.SetDisposition(
                    ncrId,
                    _dispositionType.Value,
                    _dispositionApprovedBy.Trim(),
                    _requiresCustomerApproval,
                    _requiresCustomerApproval &&
                        _customerApproved,
                    string.IsNullOrWhiteSpace(
                        _customerApprovalReference)
                            ? null
                            : _customerApprovalReference.Trim());

            if (!saved)
            {
                _dispositionError =
                    "Unable to save the NCR disposition.";

                return;
            }


            LoadNcrs();

            _selectedNcr =
                _ncrs.FirstOrDefault(
                    x => x.Id == ncrId);

            if (_selectedNcr != null)
            {
                LoadDispositionEditor(
                    _selectedNcr);
            }

            Snackbar.Add(
                "NCR disposition saved successfully.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            _dispositionError =
                $"Unable to save disposition: {ex.Message}";
        }
        finally
        {
            _isSavingDisposition =
                false;
        }

        await InvokeAsync(
            StateHasChanged);
    }

    private async Task ExportNcrPdf()
    {
        if (_selectedNcr == null ||
            _isExportingPdf)
        {
            return;
        }

        _isExportingPdf = true;

        try
        {
            var current =
                NcrService.GetById(
                    _selectedNcr.Id);

            if (current == null)
            {
                Snackbar.Add(
                    "The selected NCR could not be loaded.",
                    Severity.Error);

                return;
            }

            var history =
                NcrService.GetHistory(
                    current.Id);

            var exportModel =
                new NcrDossierExportModel
                {
                    Ncr = current,
                    History = history,
                    GeneratedDate = DateTime.Now
                };

            var pdf =
                NcrPdfService.Generate(
                    exportModel);

            if (pdf.Length == 0)
            {
                Snackbar.Add(
                    "The NCR PDF could not be generated.",
                    Severity.Error);

                return;
            }

            var fileNumber =
                string.IsNullOrWhiteSpace(
                    current.NcrNumber)
                    ? "NCR"
                    : current.NcrNumber.Trim();

            foreach (var invalidCharacter in
                     Path.GetInvalidFileNameChars())
            {
                fileNumber =
                    fileNumber.Replace(
                        invalidCharacter,
                        '-');
            }

            var fileName =
                $"{fileNumber}-Dossier.pdf";

            var base64 =
                Convert.ToBase64String(pdf);

            await JS.InvokeVoidAsync(
                "weldAdminDownload.saveBase64File",
                fileName,
                "application/pdf",
                base64);

            Snackbar.Add(
                current.IsClosed
                    ? "Final NCR dossier exported."
                    : "Interim NCR dossier exported.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"PDF export failed: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _isExportingPdf = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private static NcrStatus? GetBasicNextStatus(
        NcrRecord ncr)
    {
        return ncr.Status switch
        {
            NcrStatus.Open =>
                NcrStatus.UnderInvestigation,

            NcrStatus.UnderInvestigation =>
                NcrStatus.AwaitingDisposition,

            _ =>
                null
        };
    }


    private void StartRepairExecutionUi()
    {
        if (_selectedNcr == null)
        {
            Snackbar.Add(
                "Select an NCR before starting repair or rework.",
                Severity.Warning);

            return;
        }

        if (string.IsNullOrWhiteSpace(
                _executionPerformedBy))
        {
            Snackbar.Add(
                "Performed By is required before repair or rework can start.",
                Severity.Warning);

            return;
        }

        var ncrId =
            _selectedNcr.Id;

        var performedBy =
            _executionPerformedBy.Trim();

        var succeeded =
            NcrService.StartRepairExecution(
                ncrId,
                performedBy);

        if (!succeeded)
        {
            Snackbar.Add(
                "Unable to start repair / rework. Check the current NCR status.",
                Severity.Error);

            return;
        }

        _executionPerformedBy =
            string.Empty;

        LoadNcrs();

        _selectedNcr =
            _ncrs.FirstOrDefault(
                x => x.Id == ncrId);

        Snackbar.Add(
            $"Repair / rework started by {performedBy}.",
            Severity.Success);
    }


